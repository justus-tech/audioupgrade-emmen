---
<ul class="socials">
  {SOCIALS.map((s) => (
    <li>
      <a href={s.url} rel="me noopener" target="_blank" aria-label={`${s.naam} van Audio Upgrade Emmen`}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d={ICOON[s.naam]} /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .socials {
    list-style: none;
    display: flex;
    gap: 6px;
    margin: 12px 0 0 -11px;
    padding: 0;
  }
  .socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
  }
</style>
