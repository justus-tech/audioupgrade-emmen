---
/**
 * De sociale profielen als drie icoontjes in de voettekst.
 *
 * Icoontjes in plaats van woorden: iedereen herkent ze, en ze nemen op een
 * telefoon geen drie regels in. De naam staat er voor schermlezers wel bij.
 *
 * Elk vlakje is 44 pixels, de maat die je met een duim raakt zonder de buurman
 * mee te pakken. Kleur komt uit currentColor, dus uit de huisstijl.
 */
import { SOCIALS } from '../data/site.js';

const ICOON = {
