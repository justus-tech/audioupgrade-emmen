---
/**
 * Lijntekening van een auto, per carrosserietype.
 *
 * De vorm komt uit src/lib/carrosserie.js, zodat deze schets en de doorkijk
 * per pakket dezelfde bron gebruiken.
 *
 * Zelf getekend, bewust: foto's van fabrikanten zijn auteursrechtelijk
 * beschermd en automerklogo's merkrechtelijk. Een eigen stilering van een
 * carrosserievorm is dat geen van beide.
 */
import {
  carrosseriePad,
  normaliseerType,
  stijlHoogte,
  WIELEN,
  GROND,
} from '../lib/carrosserie.js';

const { type = 'hatchback', klasse = '' } = Astro.props;
const soort = normaliseerType(type);
---
<svg
  class={`auto-schets ${klasse}`}
  viewBox="0 0 400 170"
  role="img"
  aria-label={`Illustratie van een ${soort}`}
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={carrosseriePad(soort)} />

  {WIELEN.map((w) => (
    <>
      <circle cx={w.x} cy={GROND} r={w.r} />
      <circle cx={w.x} cy={GROND} r={w.r - 11} stroke="var(--accent)" />
    </>
  ))}

  {soort !== 'cabriolet' && (
    <path d={`M 186,${stijlHoogte(soort)} L 186,88`} stroke-width="2" opacity="0.75" />
  )}

  <path d="M 8,156 L 392,156" stroke="var(--accent)" stroke-width="2" opacity="0.5" />
</svg>

<style>
  .auto-schets {
    width: 100%;
    height: auto;
    display: block;
    color: var(--text);
  }
</style>
