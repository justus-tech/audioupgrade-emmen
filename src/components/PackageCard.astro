---
import PakketBeeld from './PakketBeeld.astro';
import { whatsappLink, berichtOverPakket } from '../lib/whatsapp.js';

/**
 * Eén pakketkaart. Alle tekst en prijzen komen uit site.js en staan daar
 * letterlijk zoals op audioupgradeemmen.nl — hier wordt niets herschreven.
 *
 *   uitgebreid  het volledige verhaal (alleen op /upgrades)
 *   showScores  balkjes uitzetten (bijv. in een smalle kolom)
 *
 * TWEE VARIANTEN, EN WAAROM
 * De volledige kaart werd 1400 pixels hoog: dan past er op een laptop nog
 * geen één op het scherm en zie je alleen een plaatje met een prijs. Daarom
 * is de standaardkaart kort — beeld, naam, prijs, één regel, balkjes, tijd —
 * en staat het volledige verhaal op de upgradepagina. Ook daar staat de lange
 * omschrijving achter een klik, zodat de kaart op één scherm past. Er gaat
 * geen tekst verloren; hij staat alleen niet meer allemaal tegelijk open.
 */
/**
 * `auto` is de auto waar deze kaart bij staat, bijvoorbeeld "Volkswagen Golf"
 * op een modelpagina. Die zetten we in het WhatsApp-bericht, zodat Justus
 * meteen ziet waar het over gaat. Op de homepage weten we dat niet en blijft
 * het bericht algemeen.
 *
 * ==========================================================================
 * ÉÉN KAART VOOR DRIE TALEN
 * ==========================================================================
 * `vertaling` vervangt de teksten door de Duitse of Engelse versie. Alles
 * eromheen — de tekening, het oranje, de balkjes, het label, de opmaak —
 * blijft precies gelijk.
 *
 * Dat is met een reden zo gebouwd. Eerst stond er voor Duits en Engels een
 * eigen, vereenvoudigde kaart in Landingspagina.astro: zonder tekening,
 * zonder scorebalkjes, zonder het oranje. Dat viel meteen op naast het
 * Nederlands, en het was ook onvermijdelijk: twee kaarten voor hetzelfde
 * doel lopen altijd uit elkaar. Nu is er één.
 */
const {
  pkg,
  showScores = true,
  uitgebreid = false,
  auto = null,
  taal = 'nl',
  vertaling = null,
  labels = null,
} = Astro.props;

/* De teksten van deze kaart: vertaald als die er is, anders het Nederlands. */
const v = vertaling ?? {};
const naam = v.naam ?? pkg.name;
const tagline = v.tagline ?? pkg.tagline;
const prijs = v.prijs ?? pkg.price;
const prijsNoot = v.prijsNoot ?? pkg.priceNote;
const prijsExcl = v.prijsExcl ?? pkg.priceExcl;
const kort = v.short ?? pkg.short;
const verhaal = v.body ?? pkg.body;
const kenmerken = v.features ?? pkg.features;
const knop = v.cta ?? pkg.cta;
const duur = v.duur ?? pkg.duur;

/* De losse woordjes op de kaart. */
const L = labels ?? {
  badge: 'Onze aanrader',
  meer: 'Meer over dit pakket',
  vanDe5: (n) => `${n} van de 5`,
  scores: null,
};

/**
 * De scorebalkjes hebben eigen namen per taal. Staat er geen vertaling voor
 * een label, dan blijft het Nederlandse staan — beter een woord dat niet
 * vertaald is dan een leeg balkje zonder naam.
 */
const scoreNaam = (label) => L.scores?.[label] ?? label;

/**
 * Bij Akoestische Isolatie tonen we geen scorebalkjes — dat deed de oude site
 * ook niet. Dat pakket gaat niet over volume of bas maar over rust. De kaart
 * krijgt `los`, zodat hij niet meerekt tot de hoogte van de andere kaarten.
 */
const scoresTonen = showScores && pkg.scores.length > 0;

/**
 * Sommige pakketten hebben geen balkjes maar drie regels tekst op die plek.
 * The Competition Build is er zo een: daar zeggen Volume, Bass en Zuiverheid
 * niets, want die staan bij het pakket ernaast ook al op vijf. Zie de uitleg
 * bij `uitgelicht` in site.js.
 */
const uitgelicht = v.uitgelicht ?? pkg.uitgelicht ?? [];
const uitgelichtTonen = showScores && !scoresTonen && uitgelicht.length > 0;
/* Staat er in het midden van de kaart iets? Zo niet, dan hoeft hij niet mee
   te rekken tot de hoogte van de kaart ernaast. */
const middenTonen = scoresTonen || uitgelichtTonen;

/* Het open vlaggetje, voor een pakket dat een soort apart is. */
const vlag = v.vlag ?? pkg.vlag ?? null;

const kenmerkenTonen = uitgebreid && kenmerken.length > 0;
---
{/*
  TIEN VASTE PLEKKEN, ALTIJD IN DEZELFDE VOLGORDE.

  Elke kaart zet precies tien dingen onder elkaar: beeld, label, naam,
  kopregel, prijs, samenvatting, uitklapper, balkjes, doorlooptijd, knop.
  Heeft een pakket er eentje niet, dan komt er een lege <span class="plek">
  in plaats van niets.

  Dat lijkt omslachtig maar het is precies waar het om draait: naast elkaar
  liggen de kaarten zo op één lijn — de prijzen op dezelfde hoogte, de
  balkjes op dezelfde hoogte, de knoppen op dezelfde hoogte. Zie .grid.vier
  in global.css: die legt de tien rijen vast, elke kaart hangt eraan.

  Zonder de lege plekken schoof alles wat ónder een ontbrekend onderdeel
  staat een stukje omhoog. Dat zag je het duidelijkst bij de kaart met het
  label: die begon één regel lager dan de rest, waardoor je vier prijzen op
  vier verschillende hoogtes vergeleek.
*/}
<div class:list={['card', !middenTonen && 'card-los', pkg.populair && 'card-populair']}>
  <PakketBeeld slug={pkg.slug} />
  {/* "Onze aanrader" en niet "Meest gekozen": zie de uitleg bij `populair`
      in site.js. Het eerste is een mening, het tweede een bewering over wat
      andere klanten deden — en die klopte niet.

      Op dezelfde plek kan een open vlaggetje staan voor een pakket dat een
      soort apart is. Zonder oranje vulling, zodat het de aanrader niet
      beconcurreert: dat is een advies, dit is een categorie. */}
  {pkg.populair
    ? <span class="badge">{L.badge}</span>
    : vlag
      ? <span class="badge badge-open">{vlag}</span>
      : <span class="plek"></span>}
  <h3>{naam}</h3>
  {tagline ? <p class="tagline">{tagline}</p> : <span class="plek"></span>}

  <div class="price">
    {prijs}
    {prijsNoot && <small>{prijsNoot}</small>}
    {prijsExcl && <small class="excl">{prijsExcl}</small>}
  </div>

  <p class="kort">{kort}</p>

  {uitgebreid && (kenmerkenTonen || verhaal) ? (
    <details class="meer">
      <summary>{L.meer}</summary>
      {verhaal && <p>{verhaal}</p>}
      {kenmerkenTonen && (
        <ul class="kenmerken">
          {kenmerken.map((f) => <li>{f}</li>)}
        </ul>
      )}
    </details>
  ) : <span class="plek"></span>}

  {scoresTonen ? (
    <div class="scores">
      {pkg.scores.map((s) => (
        <div class="score">
          <label>{scoreNaam(s.label)}</label>
          {/* Vijf blokjes, net als de oude site — alleen dan zonder emoji. */}
          <div class="blokjes" role="img" aria-label={L.vanDe5(s.waarde)}>
            {[1, 2, 3, 4, 5].map((n) => <i class:list={[n <= s.waarde && 'aan']}></i>)}
          </div>
        </div>
      ))}
    </div>
  ) : uitgelichtTonen ? (
    /* Zelfde vorm als de balkjes — label links, inhoud rechts — zodat de
       kaarten naast elkaar op één lijn blijven staan. */
    <div class="scores uitgelicht">
      {uitgelicht.map((u) => (
        <div class="score">
          <label>{u.label}</label>
          <span class="waarde">{u.waarde}</span>
        </div>
      ))}
    </div>
  ) : <span class="plek"></span>}

  {duur ? <p class="duur">{duur}</p> : <span class="plek"></span>}

  {/* Eén volle knop per rij, en dat is de aanrader. De andere drie blijven
      een omlijning: dan is er één plek waar je oog naartoe wordt getrokken
      in plaats van vier die even hard roepen. */}
  <a class:list={['btn', 'wa-link', pkg.populair && 'solid']}
     href={whatsappLink(berichtOverPakket(naam, auto, taal), taal)}
     data-wa-pakket={naam}>{knop}</a>
</div>

<script>
  /**
   * DE UITKLAPPERS IN ÉÉN RIJ BEWEGEN SAMEN.
   *
   * De kaarten in een rij zijn even hoog en staan op gedeelde rijen — dat is
   * precies wat ze vergelijkbaar maakt. Maar het betekent ook dat één kaart
   * openklappen de andere drie meetrekt: die werden even hoog, met een gat
   * van zeshonderd pixels waar niets stond.
   *
   * Nu klappen ze samen open. Dat is niet alleen de nette oplossing voor dat
   * gat, het is ook wat je op zo'n rij wilt doen: vier pakketten naast elkaar
   * openslaan en lezen wat er in zit.
   *
   * Zonder JavaScript werkt elke uitklapper gewoon los. Dat is de bekende
   * <details>, die heeft ons nergens voor nodig.
   */
  let bezig = false;

  for (const rij of document.querySelectorAll('.grid')) {
    const uitklappers = rij.querySelectorAll(':scope > .card > details.meer');
    if (uitklappers.length < 2) continue;

    for (const deze of uitklappers) {
      deze.addEventListener('toggle', () => {
        // Zonder deze vlag zet de ene uitklapper de andere open, die daarop
        // weer een toggle afvuurt, en zo door.
        if (bezig) return;
        bezig = true;
        for (const andere of uitklappers) {
          if (andere !== deze) andere.open = deze.open;
        }
        bezig = false;
      });
    }
  }
</script>

<style>
  .tagline {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase; letter-spacing: .14em;
    font-size: .74rem; color: var(--accent-text);
    margin: -6px 0 0;
  }

  /* Het label "Meest Gekozen" van de oude site, nu als hoekvlag. */
  .card-populair { border-color: var(--accent); }
  .badge {
    /* Allebei nodig. In een flex-kolom regelt align-self de breedte, in een
       raster doet justify-self dat en betekent align-self ineens de hoogte.
       De kaart is het een op een telefoon en het ander op een breed scherm,
       en met alleen de eerste liep de oranje vlag over de volle kaartbreedte. */
    align-self: flex-start;
    justify-self: start;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase; letter-spacing: .18em; font-size: .64rem;
    background: var(--accent); color: var(--accent-ink);
    padding: 5px 12px; margin-bottom: 2px;
  }

  .excl { opacity: .72; margin-top: 2px !important; }

  .kenmerken { list-style: none; padding: 0; margin: 14px 0 0; }
  .kenmerken li {
    position: relative; padding-left: 20px; margin: 7px 0;
    font-size: .88rem; color: var(--text-dim); line-height: 1.45;
  }

  /* De volledige omschrijving. Dichtgeklapt kost hij één regel, opengeklapt
     staat er precies de tekst van de oude site. */
  .meer { border: 0; padding: 0; margin-top: 2px; }
  .meer summary {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase; letter-spacing: .14em;
    font-size: .72rem; color: var(--text-dim);
    cursor: pointer; list-style: none;
    display: inline-flex; align-items: center; gap: 8px;
    transition: color .2s;
  }
  .meer summary::-webkit-details-marker { display: none; }
  .meer summary::after {
    content: ''; flex: none;
    width: 7px; height: 7px;
    border-right: 1.5px solid var(--accent);
    border-bottom: 1.5px solid var(--accent);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform .2s;
  }
  .meer[open] summary::after { transform: rotate(-135deg) translate(-2px, -2px); }
  @media (hover: hover) {
    .meer summary:hover { color: var(--accent-text); }
  }
  .meer p { margin-top: 12px; font-size: .9rem; }
  /* Streepje in de merkkleur in plaats van een bolletje: rustiger en het
     leest als een specificatielijst. */
  .kenmerken li::before {
    content: ''; position: absolute; left: 0; top: .62em;
    width: 10px; height: 1px; background: var(--accent);
  }

  /* Hoe lang de auto bij ons staat. Dat is na de prijs de vraag die klanten
     als eerste stellen, dus die hoort naast de knop en niet in een FAQ. */
  .duur {
    display: flex; align-items: center; gap: 9px;
    margin: 4px 0 0; padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: .82rem; color: var(--text-dim);
  }
  .duur::before {
    content: ''; flex: none;
    width: 12px; height: 12px; border-radius: 50%;
    border: 1.5px solid var(--accent);
    /* Het streepje in het midden maakt er een klokje van. */
    background:
      linear-gradient(to bottom, var(--accent) 0 1.5px, transparent 1.5px) 50% 2px / 1.5px 4px no-repeat;
  }

  /* Label en balkje naast elkaar in plaats van onder elkaar. Scheelt per
     kaart veertig pixels, en drie labels onder elkaar lazen toch al als een
     lijstje in plaats van als een score. */
  .score { display: flex; align-items: center; gap: 12px; margin: 8px 0; }
  .score label {
    flex: none; width: 82px;
    font-family: 'Oswald', sans-serif;
    font-size: .68rem; letter-spacing: .16em; text-transform: uppercase;
    color: var(--text-dim);
  }
  /* Het open vlaggetje: dezelfde vorm als de aanrader, maar een omlijning in
     plaats van een vlak. Het vertelt om wat voor soort pakket het gaat en
     hoort niet net zo hard te roepen als een advies. */
  .badge-open {
    background: transparent;
    color: var(--accent-text);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  /* Drie regels in plaats van drie balkjes. Zie `uitgelicht` in site.js.
     Boven uitlijnen en niet in het midden: loopt de rechterkant over twee
     regels, dan hoort het label bij de eerste. */
  .uitgelicht .score { align-items: start; margin: 10px 0; }
  .uitgelicht label { padding-top: 1px; }
  .uitgelicht .waarde {
    flex: 1;
    font-size: .82rem;
    line-height: 1.35;
    color: var(--text-dim);
  }

  .blokjes { display: flex; gap: 4px; flex: 1; }
  .blokjes i {
    flex: 1; height: 5px; border-radius: 2px;
    background: var(--line);
  }
  .blokjes i.aan { background: var(--accent); }
</style>
