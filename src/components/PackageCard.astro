---
import { SITE } from '../data/site.js';
import PakketBeeld from './PakketBeeld.astro';

/**
 * Eén pakketkaart. Alle tekst en prijzen komen uit site.js en staan daar
 * letterlijk zoals op audioupgradeemmen.nl — hier wordt niets herschreven.
 *
 *   uitgebreid  toont de volledige omschrijving in plaats van de één-regel
 *   showScores  balkjes uitzetten (bijv. in een smalle kolom)
 */
const { pkg, showScores = true, uitgebreid = false } = Astro.props;

/**
 * Bij Akoestische Isolatie tonen we geen scorebalkjes — dat deed de oude site
 * ook niet. Dat pakket gaat niet over volume of bas maar over rust. De kaart
 * krijgt `los`, zodat hij niet meerekt tot de hoogte van de andere kaarten.
 */
const scoresTonen = showScores && pkg.scores.length > 0;
const tekst = uitgebreid ? pkg.body : pkg.short;
---
<div class:list={['card', !scoresTonen && 'card-los', pkg.populair && 'card-populair']}>
  <PakketBeeld slug={pkg.slug} />
  {pkg.populair && <span class="badge">Meest gekozen</span>}
  <h3>{pkg.name}</h3>
  {pkg.tagline && <p class="tagline">{pkg.tagline}</p>}

  <div class="price">
    {pkg.price}
    {pkg.priceNote && <small>{pkg.priceNote}</small>}
    {pkg.priceExcl && <small class="excl">{pkg.priceExcl}</small>}
  </div>

  <p>{tekst}</p>

  {pkg.features.length > 0 && (
    <ul class="kenmerken">
      {pkg.features.map((f) => <li>{f}</li>)}
    </ul>
  )}

  {scoresTonen && (
    <div class="scores">
      {pkg.scores.map((s) => (
        <div class="score">
          <label>{s.label}</label>
          {/* Vijf blokjes, net als de oude site — alleen dan zonder emoji. */}
          <div class="blokjes" role="img" aria-label={`${s.waarde} van de 5`}>
            {[1, 2, 3, 4, 5].map((n) => <i class:list={[n <= s.waarde && 'aan']}></i>)}
          </div>
        </div>
      ))}
    </div>
  )}

  {pkg.duur && <p class="duur">{pkg.duur}</p>}

  <a class="btn" href={SITE.whatsapp}>{pkg.cta}</a>
</div>

<style>
  .tagline {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase; letter-spacing: .14em;
    font-size: .74rem; color: var(--accent);
    margin: -6px 0 0;
  }

  /* Het label "Meest Gekozen" van de oude site, nu als hoekvlag. */
  .card-populair { border-color: var(--accent); }
  .badge {
    align-self: flex-start;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase; letter-spacing: .18em; font-size: .64rem;
    background: var(--accent); color: var(--accent-ink);
    padding: 5px 12px; margin-bottom: -4px;
  }

  .excl { opacity: .72; margin-top: 2px !important; }

  .kenmerken { list-style: none; padding: 0; margin: 0; }
  .kenmerken li {
    position: relative; padding-left: 20px; margin: 8px 0;
    font-size: .9rem; color: var(--text-dim); line-height: 1.5;
  }
  /* Streepje in de merkkleur in plaats van een bolletje: rustiger en het
     leest als een specificatielijst. */
  .kenmerken li::before {
    content: ''; position: absolute; left: 0; top: .62em;
    width: 10px; height: 1px; background: var(--accent);
  }

  /* Hoe lang de auto bij ons staat. Dat is na de prijs de vraag die klanten
     als eerste stellen, dus die hoort naast de knop en niet in een FAQ. */
  .duur {
    display: flex; align-items: center; gap: 9px;
    margin: 4px 0 0; padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: .82rem; color: var(--text-dim);
  }
  .duur::before {
    content: ''; flex: none;
    width: 12px; height: 12px; border-radius: 50%;
    border: 1.5px solid var(--accent);
    /* Het streepje in het midden maakt er een klokje van. */
    background:
      linear-gradient(to bottom, var(--accent) 0 1.5px, transparent 1.5px) 50% 2px / 1.5px 4px no-repeat;
  }

  .score { margin: 10px 0; }
  .score label {
    display: block; margin-bottom: 6px;
    font-family: 'Oswald', sans-serif;
    font-size: .68rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--text-dim);
  }
  .blokjes { display: flex; gap: 4px; }
  .blokjes i {
    flex: 1; height: 5px; border-radius: 2px;
    background: var(--line);
  }
  .blokjes i.aan { background: var(--accent); }
</style>
