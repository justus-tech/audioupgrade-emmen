---
/**
 * De geluidsgolf onderin de hero van de homepage.
 *
 * HOE HET IS OPGEBOUWD
 *
 *   De omtrek   Twee lijnen: eentje boven de middenlijn en zijn spiegelbeeld
 *               eronder. Samen vormen ze de vorm van de golf.
 *   De balken   Staan er ín, en worden door die vorm afgeknipt. Zo lopen ze
 *               precies tot aan de lijn en niet erdoorheen. Dat gebeurt met
 *               een uitknipvorm (clipPath): de balken zijn gewoon volle
 *               staven, en de golf bepaalt wat je ervan ziet.
 *
 * WAAROM HIJ ZO TRAAG IS
 * Dit moet duur ogen, en duur is traag. Alles wat schokt of tikt haalt de
 * rust eruit, dus er zit geen enkele klap of aanzet meer in: de golf schuift,
 * hij beweegt niet op de maat. Eerder liep hier een hartslag van 92 slagen
 * per minuut doorheen met een aanzwellende kick. Dat was herkenbaar als
 * muziek, maar het maakte het beeld onrustig — je oog bleef eraan haken.
 *
 * DRIE DINGEN DIE HET VLOEIEND HOUDEN
 *
 *   1. Lange golven. Drie sinussen met verhoudingen die niet op elkaar
 *      uitkomen (1 : 1,73 : 2,59). Daardoor herhaalt het patroon zich pas na
 *      minuten en zie je nooit dat het rondjes draait.
 *   2. Traag verloop. De tijdfactoren zijn ruim vier keer zo klein als eerst.
 *      Eén ervan loopt achteruit, zodat de golven dóór elkaar heen schuiven
 *      in plaats van als een blok op te schuiven.
 *   3. Ademen in plaats van slaan. De hoogte zwelt op een cyclus van rond de
 *      dertig seconden. Geen aanzet, geen terugval — alleen een lange haal.
 *
 * Er speelt geen echt geluid; dit is een model. De animatie stopt zodra hij
 * uit beeld is of het tabblad naar de achtergrond gaat, en bij "verminder
 * beweging" blijft alles stilstaan op de vorm die de server al meestuurt.
 */
const BREEDTE = 1160;
const HOOGTE = 120;
const MIDDEN = HOOGTE / 2;

/**
 * Meer punten dan je nodig zou denken. De bochten worden berekend tussen
 * opeenvolgende punten, dus hoe meer punten, hoe ronder de lijn. Bij 96 was
 * op een breed scherm nog te zien dat een golftop uit rechte stukjes bestond.
 */
const PUNTEN = 170;
const BALKEN = 132;

const vakBreedte = BREEDTE / BALKEN;
const balkDikte = Math.max(1, vakBreedte * 0.3);

/** Drie lange golven die langzaam door elkaar heen schuiven. */
function golf(u, t) {
  return (
    0.64 * Math.sin(u * 6.6 + t * 0.22) +
    0.24 * Math.sin(u * 11.4 - t * 0.15 + 1.3) +
    0.12 * Math.sin(u * 17.1 + t * 0.09 + 2.6)
  );
}

/** Dooft uit naar beide randen, zodat de golf niet afgekapt lijkt. */
function omhulsel(u) {
  return Math.pow(Math.sin(u * Math.PI), 0.55);
}

/**
 * Hoe hoog de golf op dit moment staat. Twee trage cycli over elkaar heen,
 * zodat opzwellen en wegzakken nooit precies hetzelfde aanvoelen.
 */
function ademhaling(t) {
  return 0.62 + 0.14 * Math.sin(t * 0.19) + 0.06 * Math.sin(t * 0.115 + 2.1);
}

/** De y-waarden van de bovenrand, van links naar rechts. */
function bovenrand(t, sterkte) {
  const y = [];
  for (let i = 0; i < PUNTEN; i++) {
    const u = i / (PUNTEN - 1);
    y.push(MIDDEN - Math.abs(golf(u, t)) * omhulsel(u) * sterkte * MIDDEN);
  }
  return y;
}

/** Vloeiend pad door een reeks y-waarden, met bochten in plaats van knikken. */
function pad(ys, x) {
  let d = `M${x(0)} ${ys[0].toFixed(1)}`;
  for (let i = 1; i < ys.length - 1; i++) {
    const mx = (Number(x(i)) + Number(x(i + 1))) / 2;
    const my = (ys[i] + ys[i + 1]) / 2;
    d += `Q${x(i)} ${ys[i].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`;
  }
  return d + `L${x(ys.length - 1)} ${ys[ys.length - 1].toFixed(1)}`;
}

/**
 * De uitknipvorm: langs de bovenrand naar rechts, en langs de onderrand
 * weer terug. Alles wat de balken buiten deze vorm doen, valt weg.
 */
function maskerPad(boven) {
  const x = (i) => ((i / (PUNTEN - 1)) * BREEDTE).toFixed(1);
  const onder = boven.map((y) => MIDDEN + (MIDDEN - y));
  const heen = pad(boven, x);
  const terug = pad([...onder].reverse(), (i) => x(PUNTEN - 1 - i));
  return `${heen} ${terug.replace(/^M/, 'L')} Z`;
}

/* Dezelfde stand als waar het script op t=0 mee begint, anders verspringt de
   golf op het moment dat de animatie het overneemt. */
const startBoven = bovenrand(0, ademhaling(0));
const startOnder = startBoven.map((y) => MIDDEN + (MIDDEN - y));
const xVan = (i) => ((i / (PUNTEN - 1)) * BREEDTE).toFixed(1);
---
<div class="golflijn" aria-hidden="true">
  <svg viewBox={`0 0 ${BREEDTE} ${HOOGTE}`} preserveAspectRatio="none">
    <defs>
      <clipPath id="golf-masker" clipPathUnits="userSpaceOnUse">
        <path id="golf-masker-pad" d={maskerPad(startBoven)} />
      </clipPath>
    </defs>

    {/* Volle staven; de uitknipvorm hierboven bepaalt wat je ervan ziet. */}
    <g class="golf-balken" clip-path="url(#golf-masker)">
      {Array.from({ length: BALKEN }, (_, i) => (
        <rect
          x={(i * vakBreedte + (vakBreedte - balkDikte) / 2).toFixed(2)}
          y="0"
          width={balkDikte.toFixed(2)}
          height={HOOGTE}
        />
      ))}
    </g>

    <path class="lijn-boven" d={pad(startBoven, xVan)} />
    <path class="lijn-onder" d={pad(startOnder, xVan)} />
  </svg>
</div>

<script>
  const vak = document.querySelector('.golflijn');
  const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (vak && !stil) {
    const BREEDTE = 1160;
    const MIDDEN = 60;
    const PUNTEN = 170;

    const maskerPadEl = vak.querySelector('#golf-masker-pad');
    const lijnBoven = vak.querySelector('.lijn-boven');
    const lijnOnder = vak.querySelector('.lijn-onder');

    /* Deze drie moeten gelijk blijven aan de versie in de frontmatter
       hierboven. Lopen ze uiteen, dan springt de golf zichtbaar op het moment
       dat het script de door de server getekende vorm overneemt. */
    const golf = (u, t) =>
      0.64 * Math.sin(u * 6.6 + t * 0.22) +
      0.24 * Math.sin(u * 11.4 - t * 0.15 + 1.3) +
      0.12 * Math.sin(u * 17.1 + t * 0.09 + 2.6);

    const omhulsel = (u) => Math.pow(Math.sin(u * Math.PI), 0.55);

    const ademhaling = (t) =>
      0.62 + 0.14 * Math.sin(t * 0.19) + 0.06 * Math.sin(t * 0.115 + 2.1);

    // Vooraf uitgerekend: dit verandert nooit.
    const xen = [];
    const omhulsels = [];
    for (let i = 0; i < PUNTEN; i++) {
      const u = i / (PUNTEN - 1);
      xen.push((u * BREEDTE).toFixed(1));
      omhulsels.push(omhulsel(u));
    }

    /** Vloeiend pad door y-waarden; xi geeft de x bij index i. */
    function pad(ys, xi) {
      let d = `M${xi(0)} ${ys[0].toFixed(1)}`;
      for (let i = 1; i < ys.length - 1; i++) {
        const mx = (Number(xi(i)) + Number(xi(i + 1))) / 2;
        const my = (ys[i] + ys[i + 1]) / 2;
        d += `Q${xi(i)} ${ys[i].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`;
      }
      return d + `L${xi(ys.length - 1)} ${ys[ys.length - 1].toFixed(1)}`;
    }

    let tijd = 0;
    let vorig = 0;
    let loopt = false;
    let frame = 0;

    const xi = (i) => xen[i];
    const xiOmgekeerd = (i) => xen[PUNTEN - 1 - i];

    function stap(nu) {
      if (!loopt) return;
      /* Bovengrens op de stap: komt het tabblad terug na een minuut, dan mag
         de golf niet in één klap die hele minuut inhalen. */
      const dt = Math.min(0.05, (nu - vorig) / 1000 || 0.016);
      vorig = nu;
      tijd += dt;

      const hoogte = ademhaling(tijd);

      /* Eén berekening voor alles: de omtrek én de uitknipvorm komen hieruit,
         dus de balken kunnen nooit uit de pas lopen met de lijn. */
      const boven = [];
      const onder = [];
      for (let i = 0; i < PUNTEN; i++) {
        const u = i / (PUNTEN - 1);
        const a = Math.abs(golf(u, tijd)) * omhulsels[i] * hoogte * MIDDEN;
        boven.push(MIDDEN - a);
        onder.push(MIDDEN + a);
      }

      const padBoven = pad(boven, xi);
      lijnBoven.setAttribute('d', padBoven);
      lijnOnder.setAttribute('d', pad(onder, xi));
      maskerPadEl.setAttribute(
        'd',
        `${padBoven} ${pad([...onder].reverse(), xiOmgekeerd).replace(/^M/, 'L')} Z`
      );

      frame = requestAnimationFrame(stap);
    }

    const start = () => {
      if (loopt) return;
      loopt = true;
      vorig = performance.now();
      frame = requestAnimationFrame(stap);
    };
    const stop = () => {
      loopt = false;
      cancelAnimationFrame(frame);
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([item]) => (item.isIntersecting && !document.hidden ? start() : stop()),
        { threshold: 0 }
      ).observe(vak);
    } else {
      start();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (vak.getBoundingClientRect().bottom > 0) start();
    });
  }
</script>

<style>
  .golflijn {
    position: absolute;
    inset: auto 0 0 0;
    /* Meelopen met de tekstbreedte in plaats van rand tot rand. Op een breed
       scherm werden de golven anders zo ver uitgerekt dat er van de vorm
       niets overbleef. */
    max-width: var(--max);
    margin-inline: auto;
    height: clamp(130px, 21vh, 210px);
    pointer-events: none;
  }
  .golflijn svg { width: 100%; height: 100%; display: block; }

  /* Volle staven. De uitknipvorm bepaalt hoeveel je ervan ziet, dus ze
     eindigen altijd precies op de lijn.

     De kleur wisselt met de stand: wit op de donkere achtergrond, oranje op
     de witte. Zie --golf-balk in brand.js. Geen opacity hier, want die zit
     in de kleur zelf — de twee standen hebben er een andere waarde voor
     nodig. */
  .golf-balken rect { fill: var(--golf-balk); }

  /* Op een telefoon wordt het tekenvlak van 1160 naar zo'n 390 geperst. De
     132 balken staan dan nog geen drie pixels uit elkaar en lopen visueel
     dicht tot één grijs vlak. Elke tweede weglaten geeft ze weer lucht,
     zonder dat er iets herberekend hoeft te worden: dezelfde tekening, half
     zo veel streepjes. */
  @media (max-width: 700px) {
    .golf-balken rect:nth-child(even) { display: none; }
  }

  .golflijn path {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Zonder dit wordt de lijn op een breed scherm een haardun draadje en op
       een telefoon een dikke worst. */
    vector-effect: non-scaling-stroke;
  }
  .lijn-boven { stroke-width: 2.2; opacity: .92; }
  /* De onderrand iets zachter: dan blijft de bovenkant de hoofdlijn. */
  .lijn-onder { stroke-width: 1.6; opacity: .5; }
</style>
