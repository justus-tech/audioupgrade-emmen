---
/**
 * De frequentiecurve onderin de hero van de homepage.
 *
 * WAAROM DIT, EN NIET EEN GOLF
 * Hier stond eerst een geluidsgolf. Die zag er goed uit, maar hij paste niet
 * bij de rest: deze site is hoekig en technisch — rechte lijnen, hoofdletters,
 * gesoldeerd, CNC-gefreesd, ingemeten. Een zachte slingerende golf is het
 * tegenovergestelde daarvan, en het is bovendien wat iedere audiosite doet.
 *
 * Dit is het beeld waar Justus dagelijks naar kijkt als hij een auto inmeet:
 * een frequentiecurve op een logaritmische schaal. Het vertelt meteen het hele
 * verhaal van de site, zonder één woord:
 *
 *   De grijze lijn   het fabriekssysteem. Geen bas, een bult in de midbas, een
 *                    gat in het midden en een schelle piek rond 3,5 kHz. Precies
 *                    waarom het "blikkerig" klinkt.
 *   De oranje lijn   na de DSP-tuning. Vlak waar het vlak hoort, met een lift
 *                    onderin en een zachte afbouw bovenin.
 *
 * De grijze lijn trilt licht, zoals een echte meting doet. De oranje ligt bijna
 * stil — dat verschil ís de boodschap. Alles beweegt traag; er zit geen tik of
 * aanzet in.
 *
 * DIT IS EEN SCHETS, GEEN METING
 * De curves komen uit een formule, niet uit een meetmicrofoon in een
 * bestaande auto. Het is een illustratie van het principe, zoals de tekeningen
 * bij de pakketten dat ook zijn.
 *
 * De animatie stopt zodra hij uit beeld is of het tabblad naar de achtergrond
 * gaat, en bij "verminder beweging" blijft alles stilstaan op de vorm die de
 * server al meestuurt.
 */
const BREEDTE = 1160;
const HOOGTE = 120;
const PUNTEN = 190;

/** Het venster in decibel dat we in beeld brengen. */
const DB_MAX = 7;
const DB_MIN = -11;

/** Van decibel naar een y op het tekenvlak. */
const naarY = (db) => ((DB_MAX - db) / (DB_MAX - DB_MIN)) * HOOGTE;

/**
 * De horizontale as loopt van 20 Hz tot 20 kHz, logaritmisch — zoals elke
 * frequentiegrafiek. Elke octaaf krijgt daardoor evenveel ruimte, en dat is
 * ook hoe je oor het hoort: van 100 naar 200 Hz is net zo'n grote stap als
 * van 1000 naar 2000.
 */
const u10 = Math.log10(20);
const naarU = (hz) => (Math.log10(hz) - u10) / 3;

/** De rasterlijnen: één per octaaf. */
const OCTAVEN = [31.5, 63, 125, 250, 500, 1000, 2000, 4000, 8000, 16000];

/** Een klokvorm rond `mid`. Zo werkt een filter ook: één bult, één dip. */
const bel = (u, mid, breedte) => Math.exp(-(((u - mid) / breedte) ** 2));

/** Het fabriekssysteem: overal iets, nergens goed. */
function fabriek(u, t) {
  return (
    -0.8 +
    -7.2 * bel(u, 0.155, 0.115) + // geen bas onderin
    2.6 * bel(u, 0.333, 0.062) + // bult in de midbas: boemerig
    -3.0 * bel(u, 0.47, 0.075) + // gat in het midden: stemmen ver weg
    5.0 * bel(u, 0.752, 0.085) * (1 + 0.06 * Math.sin(t * 0.23)) + // schel
    -2.2 * bel(u, 0.88, 0.065) +
    -6.0 * bel(u, 1.02, 0.105) + // de top valt weg
    // Meetruis. Traag driftend, want een echte meting staat nooit helemaal
    // stil — en juist dat maakt het verschil met de lijn eronder zichtbaar.
    0.4 * Math.sin(u * 29 + t * 0.6) +
    0.25 * Math.sin(u * 47 - t * 0.45 + 1.2)
  );
}

/** Na de tuning: vlak waar het vlak hoort. */
function ingemeten(u, t) {
  return (
    0.2 +
    4.2 * bel(u, 0.118, 0.15) + // lift onderin, waar een auto om vraagt
    0.9 * bel(u, 0.69, 0.15) + // klein beetje aanwezigheid
    -2.4 * bel(u, 1.02, 0.13) + // zachte afbouw bovenin
    0.1 * Math.sin(u * 19 + t * 0.28) // vrijwel stil: hij is afgestemd
  );
}

/** De y-waarden van een curve, van links naar rechts. */
function curve(fn, t) {
  const y = [];
  for (let i = 0; i < PUNTEN; i++) y.push(naarY(fn(i / (PUNTEN - 1), t)));
  return y;
}

/** Vloeiend pad door een reeks y-waarden, met bochten in plaats van knikken. */
function pad(ys) {
  const x = (i) => ((i / (PUNTEN - 1)) * BREEDTE).toFixed(1);
  let d = `M${x(0)} ${ys[0].toFixed(1)}`;
  for (let i = 1; i < ys.length - 1; i++) {
    const mx = (Number(x(i)) + Number(x(i + 1))) / 2;
    const my = (ys[i] + ys[i + 1]) / 2;
    d += `Q${x(i)} ${ys[i].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`;
  }
  return d + `L${x(ys.length - 1)} ${ys[ys.length - 1].toFixed(1)}`;
}

/** Hetzelfde pad, maar dichtgemaakt tot onder aan het vlak. */
const vlak = (ys) => `${pad(ys)} L${BREEDTE} ${HOOGTE} L0 ${HOOGTE} Z`;

const startFabriek = curve(fabriek, 0);
const startNa = curve(ingemeten, 0);

/**
 * De twee woordjes onder de curve. Dit is het enige stukje van de tekening
 * dat iets beweert, dus het moet meevertalen — anders staat er op de Duitse
 * pagina ineens "fabriekssysteem" onder een grafiek.
 */
const LEGENDA = {
  nl: { was: 'Fabriekssysteem', wordt: 'Na DSP-tuning' },
  de: { was: 'Werkssystem', wordt: 'Nach DSP-Abstimmung' },
  en: { was: 'Factory system', wordt: 'After DSP tuning' },
};

const { taal = 'nl' } = Astro.props;
const legenda = LEGENDA[taal] ?? LEGENDA.nl;
---
<div class="golflijn">
  <svg viewBox={`0 0 ${BREEDTE} ${HOOGTE}`} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      {/* Geeft de oranje lijn gewicht zonder hem zwaar te maken. */}
      <linearGradient id="curve-vulling" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" style="stop-color: var(--accent); stop-opacity: .20" />
        <stop offset="100%" style="stop-color: var(--accent); stop-opacity: 0" />
      </linearGradient>
    </defs>

    <g class="raster">
      {OCTAVEN.map((hz) => (
        <line
          x1={(naarU(hz) * BREEDTE).toFixed(1)}
          y1="0"
          x2={(naarU(hz) * BREEDTE).toFixed(1)}
          y2={HOOGTE}
        />
      ))}
      {/* De nullijn: precies vlak. Daar streven we naar. */}
      <line class="nullijn" x1="0" y1={naarY(0)} x2={BREEDTE} y2={naarY(0)} />
    </g>

    <path class="curve-vlak" d={vlak(startNa)} />
    <path class="curve-fabriek" d={pad(startFabriek)} />
    <path class="curve-na" d={pad(startNa)} />
  </svg>

  {/* Echte tekst, geen plaatje: dit is het enige stukje van de tekening dat
      iets beweert, dus het moet ook voorleesbaar zijn. */}
  <p class="curve-legenda">
    <span class="was">{legenda.was}</span>
    <span class="wordt">{legenda.wordt}</span>
  </p>
</div>

<script>
  const vak = document.querySelector('.golflijn');
  const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (vak && !stil) {
    const BREEDTE = 1160;
    const HOOGTE = 120;
    const PUNTEN = 190;
    const DB_MAX = 7;
    const DB_MIN = -11;

    /* Deze formules moeten gelijk blijven aan die in de frontmatter hierboven.
       Lopen ze uiteen, dan springt de tekening zichtbaar op het moment dat het
       script de door de server getekende curve overneemt. */
    const naarY = (db) => ((DB_MAX - db) / (DB_MAX - DB_MIN)) * HOOGTE;
    const bel = (u, mid, breedte) => Math.exp(-(((u - mid) / breedte) ** 2));

    const fabriek = (u, t) =>
      -0.8 +
      -7.2 * bel(u, 0.155, 0.115) +
      2.6 * bel(u, 0.333, 0.062) +
      -3.0 * bel(u, 0.47, 0.075) +
      5.0 * bel(u, 0.752, 0.085) * (1 + 0.06 * Math.sin(t * 0.23)) +
      -2.2 * bel(u, 0.88, 0.065) +
      -6.0 * bel(u, 1.02, 0.105) +
      0.4 * Math.sin(u * 29 + t * 0.6) +
      0.25 * Math.sin(u * 47 - t * 0.45 + 1.2);

    const ingemeten = (u, t) =>
      0.2 +
      4.2 * bel(u, 0.118, 0.15) +
      0.9 * bel(u, 0.69, 0.15) +
      -2.4 * bel(u, 1.02, 0.13) +
      0.1 * Math.sin(u * 19 + t * 0.28);

    const vlakFabriek = vak.querySelector('.curve-fabriek');
    const vlakNa = vak.querySelector('.curve-na');
    const vulling = vak.querySelector('.curve-vlak');

    // De x-waarden veranderen nooit, dus die rekenen we één keer uit.
    const xen = [];
    for (let i = 0; i < PUNTEN; i++) {
      xen.push(((i / (PUNTEN - 1)) * BREEDTE).toFixed(1));
    }

    function pad(ys) {
      let d = `M${xen[0]} ${ys[0].toFixed(1)}`;
      for (let i = 1; i < ys.length - 1; i++) {
        const mx = (Number(xen[i]) + Number(xen[i + 1])) / 2;
        const my = (ys[i] + ys[i + 1]) / 2;
        d += `Q${xen[i]} ${ys[i].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`;
      }
      return d + `L${xen[ys.length - 1]} ${ys[ys.length - 1].toFixed(1)}`;
    }

    function curve(fn, t) {
      const y = [];
      for (let i = 0; i < PUNTEN; i++) y.push(naarY(fn(i / (PUNTEN - 1), t)));
      return y;
    }

    let tijd = 0;
    let vorig = 0;
    let loopt = false;
    let frame = 0;

    function stap(nu) {
      if (!loopt) return;
      /* Bovengrens op de stap: komt het tabblad terug na een minuut, dan mag
         de meting niet in één klap die hele minuut inhalen. */
      const dt = Math.min(0.05, (nu - vorig) / 1000 || 0.016);
      vorig = nu;
      tijd += dt;

      const na = curve(ingemeten, tijd);
      const padNa = pad(na);

      vlakFabriek.setAttribute('d', pad(curve(fabriek, tijd)));
      vlakNa.setAttribute('d', padNa);
      vulling.setAttribute('d', `${padNa} L${BREEDTE} ${HOOGTE} L0 ${HOOGTE} Z`);

      frame = requestAnimationFrame(stap);
    }

    const start = () => {
      if (loopt) return;
      loopt = true;
      vorig = performance.now();
      frame = requestAnimationFrame(stap);
    };
    const stop = () => {
      loopt = false;
      cancelAnimationFrame(frame);
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([item]) => (item.isIntersecting && !document.hidden ? start() : stop()),
        { threshold: 0 }
      ).observe(vak);
    } else {
      start();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (vak.getBoundingClientRect().bottom > 0) start();
    });
  }
</script>

<style>
  .golflijn {
    position: absolute;
    inset: auto 0 0 0;
    /* Meelopen met de tekstbreedte in plaats van rand tot rand. Over de volle
       breedte van een groot scherm wordt de curve zo ver uitgerekt dat de
       vorm verdwijnt. */
    max-width: var(--max);
    margin-inline: auto;
    height: clamp(130px, 21vh, 210px);
    pointer-events: none;
  }
  .golflijn svg { width: 100%; height: 100%; display: block; }

  /* Het raster: één streep per octaaf, net zichtbaar. Het moet aanvoelen als
     millimeterpapier onder de meting, niet als een tabel. */
  .raster line {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .raster .nullijn { stroke: var(--line-strong); stroke-dasharray: 3 5; }

  .golflijn path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Zonder dit wordt een lijn op een breed scherm een haardun draadje en op
       een telefoon een dikke worst. */
    vector-effect: non-scaling-stroke;
  }

  /* Moet .golflijn erbij hebben. Zonder dat wint de regel hierboven — die is
     een klasse plus een element en dus specifieker — en blijft het vlak leeg. */
  .golflijn .curve-vlak { fill: url(#curve-vulling); stroke: none; }

  /* De fabriek: dun en grijs. Aanwezig, maar duidelijk niet de hoofdrol. */
  .curve-fabriek { stroke: var(--text-dim); stroke-width: 1.3; opacity: .6; }

  /* De curve waar het om gaat. */
  .curve-na { stroke: var(--accent); stroke-width: 2.4; }

  .curve-legenda {
    position: absolute;
    left: 24px;
    bottom: 10px;
    margin: 0;
    display: flex;
    gap: 1.5rem;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .16em;
    font-size: .6rem;
    color: var(--text-dim);
  }
  /* Een streepje in de kleur van de bijbehorende lijn, zoals in de rest van
     de site (zie de feiten onder het portret van Justus). */
  .curve-legenda span::before {
    content: '';
    display: inline-block;
    width: 16px;
    height: 2px;
    margin-right: .6em;
    vertical-align: middle;
  }
  .curve-legenda .was::before { background: var(--text-dim); opacity: .6; }
  .curve-legenda .wordt::before { background: var(--accent); }

  @media (max-width: 700px) {
    .curve-legenda {
      left: 20px;
      right: 20px;
      gap: .35rem 1.1rem;
      flex-wrap: wrap;
      font-size: .55rem;
      letter-spacing: .12em;
    }
  }
</style>
