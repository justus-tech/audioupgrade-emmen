---
/**
 * Een oscilloscooplijn als beeldmerk voor de hero — het alternatief voor de
 * balken in Golfvorm.astro.
 *
 * WAT HET NADOET
 * Een oscilloscoop laat de golfvorm van het geluid zelf zien: één doorlopende
 * lijn die op en neer gaat met de luchtdruk. Dat is wat er op meetapparatuur
 * staat, en het is precies waar wij mee werken bij het inmeten van een auto.
 *
 * DRIE DINGEN DIE HET VAN TECHNISCH NAAR DUUR TILLEN
 *
 *   Drie lijnen    Eén scherpe voorop en twee zachtere die er iets achteraan
 *                  lopen. Dat geeft diepte en het oogt als beweging in plaats
 *                  van een tekening. Dezelfde truc die Apple bij Siri gebruikt.
 *   Doorschuiven   Het beeld loopt continu naar links, zoals een echte scoop.
 *                  Daardoor herhaalt het nooit zichtbaar.
 *   Ritme          Bij elke tel zwelt de golf op en zakt weer terug, met een
 *                  kick op elke tel en een snare op de tweede en vierde.
 *                  Hetzelfde model als bij de balken.
 *
 * Net als bij de balken speelt er geen echt geluid; dit is een model van hoe
 * muziek eruitziet. En net als daar: alleen de lijn wordt hertekend, de
 * animatie stopt zodra hij uit beeld is, en bij "verminder beweging" blijft
 * hij stilstaan op de vorm die de server al meestuurt.
 */
const BREEDTE = 1160;
const HOOGTE = 120;
const MIDDEN = HOOGTE / 2;
const PUNTEN = 132;

/**
 * De golfvorm: vier sinussen over elkaar. Verschillende snelheden die niet op
 * elkaar delen, dus de vorm herhaalt zich pas na heel lange tijd.
 */
function golf(u, t) {
  return (
    (0.55 * Math.sin(u * 9.0 + t * 1.7) +
      0.3 * Math.sin(u * 17.0 - t * 2.3 + 1.1) +
      0.18 * Math.sin(u * 31.0 + t * 3.1 + 2.4) +
      0.1 * Math.sin(u * 53.0 - t * 4.7)) /
    1.13
  );
}

/** Sterk in het midden, uitdovend naar de randen. */
function omhulsel(u) {
  return 0.4 + 0.6 * Math.pow(Math.sin(u * Math.PI), 0.5);
}

/** Bouwt het pad. Staat hier én in het script, zodat beide hetzelfde tekenen. */
function pad(t, sterkte) {
  let d = '';
  for (let i = 0; i < PUNTEN; i++) {
    const u = i / (PUNTEN - 1);
    const x = u * BREEDTE;
    const y = MIDDEN - golf(u, t) * omhulsel(u) * sterkte * MIDDEN;
    d += (i === 0 ? 'M' : 'L') + x.toFixed(1) + ' ' + y.toFixed(1);
  }
  return d;
}

/* De vorm die er staat vóórdat het script begint, en die blijft staan als
   iemand beweging heeft uitgezet. */
const LAGEN = [
  { klasse: 'lijn-ver', d: pad(0.24, 0.5) },
  { klasse: 'lijn-half', d: pad(0.12, 0.62) },
  { klasse: 'lijn-voor', d: pad(0, 0.72) },
];
---
<div class="golflijn" aria-hidden="true">
  <svg viewBox={`0 0 ${BREEDTE} ${HOOGTE}`} preserveAspectRatio="none">
    {LAGEN.map((laag) => <path class={laag.klasse} d={laag.d} />)}
  </svg>
</div>

<script>
  const vak = document.querySelector('.golflijn');
  const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (vak && !stil) {
    const BREEDTE = 1160;
    const HOOGTE = 120;
    const MIDDEN = HOOGTE / 2;
    const PUNTEN = 132;

    // Vooraf uitgerekend: dit verandert nooit en scheelt werk per beeld.
    const xen = [];
    const omhulsels = [];
    for (let i = 0; i < PUNTEN; i++) {
      const u = i / (PUNTEN - 1);
      xen.push((u * BREEDTE).toFixed(1));
      omhulsels.push(0.4 + 0.6 * Math.pow(Math.sin(u * Math.PI), 0.5));
    }

    const golf = (u, t) =>
      (0.55 * Math.sin(u * 9.0 + t * 1.7) +
        0.3 * Math.sin(u * 17.0 - t * 2.3 + 1.1) +
        0.18 * Math.sin(u * 31.0 + t * 3.1 + 2.4) +
        0.1 * Math.sin(u * 53.0 - t * 4.7)) /
      1.13;

    const lagen = [
      { el: vak.querySelector('.lijn-ver'), vertraging: 0.24, sterkte: 0.5 },
      { el: vak.querySelector('.lijn-half'), vertraging: 0.12, sterkte: 0.62 },
      { el: vak.querySelector('.lijn-voor'), vertraging: 0, sterkte: 0.72 },
    ];

    const BPM = 98;
    const TEL = 60 / BPM;

    let tijd = 0;
    let vorig = 0;
    let loopt = false;
    let frame = 0;
    let zwelling = 0;

    function stap(nu) {
      if (!loopt) return;
      const dt = Math.min(0.05, (nu - vorig) / 1000 || 0.016);
      vorig = nu;
      tijd += dt;

      // Zelfde ritme als bij de balken: kick op elke tel, snare op 2 en 4.
      const tel = (tijd / TEL) % 4;
      const inTel = tel % 1;
      const kick = Math.exp(-inTel * 9) * 0.9;
      const opSnare = Math.floor(tel) === 1 || Math.floor(tel) === 3;
      const snare = opSnare ? Math.exp(-inTel * 14) * 0.5 : 0;

      // Snel opzwellen, langzaam terugzakken.
      const doel = 0.62 + kick * 0.34 + snare * 0.2;
      zwelling += (doel - zwelling) * (doel > zwelling ? 0.5 : 0.09);

      for (const laag of lagen) {
        const t = tijd - laag.vertraging;
        const sterkte = zwelling * (laag.sterkte / 0.72);
        let d = '';
        for (let i = 0; i < PUNTEN; i++) {
          const u = i / (PUNTEN - 1);
          const y = MIDDEN - golf(u, t) * omhulsels[i] * sterkte * MIDDEN;
          d += (i === 0 ? 'M' : 'L') + xen[i] + ' ' + y.toFixed(1);
        }
        laag.el.setAttribute('d', d);
      }

      frame = requestAnimationFrame(stap);
    }

    const start = () => {
      if (loopt) return;
      loopt = true;
      vorig = performance.now();
      frame = requestAnimationFrame(stap);
    };
    const stop = () => {
      loopt = false;
      cancelAnimationFrame(frame);
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([item]) => (item.isIntersecting && !document.hidden ? start() : stop()),
        { threshold: 0 }
      ).observe(vak);
    } else {
      start();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (vak.getBoundingClientRect().bottom > 0) start();
    });
  }
</script>

<style>
  .golflijn {
    position: absolute;
    inset: auto 0 0 0;
    height: clamp(130px, 21vh, 210px);
    pointer-events: none;
  }
  .golflijn svg { width: 100%; height: 100%; display: block; overflow: visible; }

  .golflijn path {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    /* De lijn wordt uitgerekt met de SVG mee. Zonder dit wordt hij op een
       breed scherm een haardun draadje en op een telefoon een dikke worst. */
    vector-effect: non-scaling-stroke;
  }
  /* Voorop scherp, daarachter twee zachtere echo's. Dat geeft diepte. */
  .lijn-voor { stroke-width: 2.2; opacity: .85; }
  .lijn-half { stroke-width: 1.6; opacity: .38; }
  .lijn-ver  { stroke-width: 1.2; opacity: .2; }
</style>
