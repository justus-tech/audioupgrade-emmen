---
/**
 * De geluidsgolf onderin de hero van de homepage.
 *
 * HOE HET IS OPGEBOUWD
 *
 *   De omtrek   Twee lijnen: eentje boven de middenlijn en zijn spiegelbeeld
 *               eronder. Samen vormen ze de vorm van de golf.
 *   De balken   Staan er ín, en worden door die vorm afgeknipt. Zo lopen ze
 *               precies tot aan de lijn en niet erdoorheen. Dat gebeurt met
 *               een uitknipvorm (clipPath): de balken zijn gewoon volle
 *               staven, en de golf bepaalt wat je ervan ziet.
 *
 * Eerder hadden de balken hun eigen hoogte en liep de lijn er dwars
 * doorheen. Dat zag eruit alsof er twee dingen over elkaar lagen in plaats
 * van één geluidsgolf.
 *
 * WAAROM HET ER TRAAG UITZIET: DIT IS EEN SUBWOOFER
 * Een sub doet ongeveer 20 tot 80 hertz. Lange, trage golven met nauwelijks
 * boventonen. Een echte 40 hertz gaat veertig keer per seconde op en neer en
 * dat kun je niet zien; dit is dezelfde vorm op een trage tijdbasis, zoals
 * een uitgezoomde oscilloscoop. Bij elke tel zwelt hij op en zakt weer terug,
 * maar zacht: een sub duwt lucht, hij tikt niet.
 *
 * Er speelt geen echt geluid; dit is een model. De animatie stopt zodra hij
 * uit beeld is of het tabblad naar de achtergrond gaat, en bij "verminder
 * beweging" blijft alles stilstaan op de vorm die de server al meestuurt.
 */
const BREEDTE = 1160;
const HOOGTE = 120;
const MIDDEN = HOOGTE / 2;
const PUNTEN = 96;
const BALKEN = 74;

const vakBreedte = BREEDTE / BALKEN;
const balkDikte = Math.max(2, vakBreedte * 0.34);

/** Lage toon: één grondtoon met twee zwakke boventonen. */
function golf(u, t) {
  return (
    0.62 * Math.sin(u * 8.6 + t * 0.9) +
    0.26 * Math.sin(u * 15.5 - t * 1.25 + 1.1) +
    0.12 * Math.sin(u * 23.0 + t * 1.7 + 2.4)
  );
}

/** Dooft uit naar beide randen, zodat de golf niet afgekapt lijkt. */
function omhulsel(u) {
  return Math.pow(Math.sin(u * Math.PI), 0.45);
}

/**
 * De uitslag op plek u: altijd positief, want boven en onder zijn elkaars
 * spiegelbeeld. Dit is de halve hoogte van de golf op dat punt.
 */
function uitslag(u, t, sterkte) {
  return Math.abs(golf(u, t)) * omhulsel(u) * sterkte * MIDDEN;
}

/** De y-waarden van de bovenrand, van links naar rechts. */
function bovenrand(t, sterkte) {
  const y = [];
  for (let i = 0; i < PUNTEN; i++) {
    y.push(MIDDEN - uitslag(i / (PUNTEN - 1), t, sterkte));
  }
  return y;
}

/** Vloeiend pad door een reeks y-waarden, met bochten in plaats van knikken. */
function pad(ys, x) {
  let d = `M${x(0)} ${ys[0].toFixed(1)}`;
  for (let i = 1; i < ys.length - 1; i++) {
    const mx = (Number(x(i)) + Number(x(i + 1))) / 2;
    const my = (ys[i] + ys[i + 1]) / 2;
    d += `Q${x(i)} ${ys[i].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`;
  }
  return d + `L${x(ys.length - 1)} ${ys[ys.length - 1].toFixed(1)}`;
}

/**
 * De uitknipvorm: langs de bovenrand naar rechts, en langs de onderrand
 * weer terug. Alles wat de balken buiten deze vorm doen, valt weg.
 */
function maskerPad(boven) {
  const x = (i) => ((i / (PUNTEN - 1)) * BREEDTE).toFixed(1);
  const onder = boven.map((y) => MIDDEN + (MIDDEN - y));
  const heen = pad(boven, x);
  const terug = pad([...onder].reverse(), (i) => x(PUNTEN - 1 - i));
  return `${heen} ${terug.replace(/^M/, 'L')} Z`;
}

const startBoven = bovenrand(0, 0.74);
const startOnder = startBoven.map((y) => MIDDEN + (MIDDEN - y));
const xVan = (i) => ((i / (PUNTEN - 1)) * BREEDTE).toFixed(1);
---
<div class="golflijn" aria-hidden="true">
  <svg viewBox={`0 0 ${BREEDTE} ${HOOGTE}`} preserveAspectRatio="none">
    <defs>
      <clipPath id="golf-masker" clipPathUnits="userSpaceOnUse">
        <path id="golf-masker-pad" d={maskerPad(startBoven)} />
      </clipPath>
    </defs>

    {/* Volle staven; de uitknipvorm hierboven bepaalt wat je ervan ziet. */}
    <g class="golf-balken" clip-path="url(#golf-masker)">
      {Array.from({ length: BALKEN }, (_, i) => (
        <rect
          x={(i * vakBreedte + (vakBreedte - balkDikte) / 2).toFixed(2)}
          y="0"
          width={balkDikte.toFixed(2)}
          height={HOOGTE}
        />
      ))}
    </g>

    <path class="lijn-boven" d={pad(startBoven, xVan)} />
    <path class="lijn-onder" d={pad(startOnder, xVan)} />
  </svg>
</div>

<script>
  const vak = document.querySelector('.golflijn');
  const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (vak && !stil) {
    const BREEDTE = 1160;
    const MIDDEN = 60;
    const PUNTEN = 96;

    const maskerPadEl = vak.querySelector('#golf-masker-pad');
    const lijnBoven = vak.querySelector('.lijn-boven');
    const lijnOnder = vak.querySelector('.lijn-onder');

    const golf = (u, t) =>
      0.62 * Math.sin(u * 8.6 + t * 0.9) +
      0.26 * Math.sin(u * 15.5 - t * 1.25 + 1.1) +
      0.12 * Math.sin(u * 23.0 + t * 1.7 + 2.4);

    const omhulsel = (u) => Math.pow(Math.sin(u * Math.PI), 0.45);

    // Vooraf uitgerekend: dit verandert nooit.
    const xen = [];
    const omhulsels = [];
    for (let i = 0; i < PUNTEN; i++) {
      const u = i / (PUNTEN - 1);
      xen.push(((u * BREEDTE)).toFixed(1));
      omhulsels.push(omhulsel(u));
    }

    /** Vloeiend pad door y-waarden; xi geeft de x bij index i. */
    function pad(ys, xi) {
      let d = `M${xi(0)} ${ys[0].toFixed(1)}`;
      for (let i = 1; i < ys.length - 1; i++) {
        const mx = (Number(xi(i)) + Number(xi(i + 1))) / 2;
        const my = (ys[i] + ys[i + 1]) / 2;
        d += `Q${xi(i)} ${ys[i].toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)}`;
      }
      return d + `L${xi(ys.length - 1)} ${ys[ys.length - 1].toFixed(1)}`;
    }

    const BPM = 92;
    const TEL = 60 / BPM;

    let tijd = 0;
    let vorig = 0;
    let loopt = false;
    let frame = 0;
    let zwelling = 0.66;

    function stap(nu) {
      if (!loopt) return;
      const dt = Math.min(0.05, (nu - vorig) / 1000 || 0.016);
      vorig = nu;
      tijd += dt;

      // De tel is er, maar zacht: een sub duwt lucht, hij tikt niet.
      const tel = (tijd / TEL) % 4;
      const inTel = tel % 1;
      const kick = Math.exp(-inTel * 3.2) * 0.42;
      const opTwee = Math.floor(tel) === 1 || Math.floor(tel) === 3;
      const tweede = opTwee ? Math.exp(-inTel * 4.5) * 0.16 : 0;

      const doel = 0.6 + kick + tweede;
      zwelling += (doel - zwelling) * (doel > zwelling ? 0.16 : 0.055);

      // Eén berekening voor alles: de omtrek én de uitknipvorm komen hieruit,
      // dus de balken kunnen nooit uit de pas lopen met de lijn.
      const boven = [];
      const onder = [];
      for (let i = 0; i < PUNTEN; i++) {
        const u = i / (PUNTEN - 1);
        const a = Math.abs(golf(u, tijd)) * omhulsels[i] * zwelling * MIDDEN;
        boven.push(MIDDEN - a);
        onder.push(MIDDEN + a);
      }

      const xi = (i) => xen[i];
      const xiOmgekeerd = (i) => xen[PUNTEN - 1 - i];

      lijnBoven.setAttribute('d', pad(boven, xi));
      lijnOnder.setAttribute('d', pad(onder, xi));
      maskerPadEl.setAttribute(
        'd',
        `${pad(boven, xi)} ${pad([...onder].reverse(), xiOmgekeerd).replace(/^M/, 'L')} Z`
      );

      frame = requestAnimationFrame(stap);
    }

    const start = () => {
      if (loopt) return;
      loopt = true;
      vorig = performance.now();
      frame = requestAnimationFrame(stap);
    };
    const stop = () => {
      loopt = false;
      cancelAnimationFrame(frame);
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([item]) => (item.isIntersecting && !document.hidden ? start() : stop()),
        { threshold: 0 }
      ).observe(vak);
    } else {
      start();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (vak.getBoundingClientRect().bottom > 0) start();
    });
  }
</script>

<style>
  .golflijn {
    position: absolute;
    inset: auto 0 0 0;
    /* Meelopen met de tekstbreedte in plaats van rand tot rand. Op een breed
       scherm werden de golven anders zo ver uitgerekt dat er van de vorm
       niets overbleef. */
    max-width: var(--max);
    margin-inline: auto;
    height: clamp(130px, 21vh, 210px);
    pointer-events: none;
  }
  .golflijn svg { width: 100%; height: 100%; display: block; }

  /* Volle staven. De uitknipvorm bepaalt hoeveel je ervan ziet, dus ze
     eindigen altijd precies op de lijn.

     Grijs, niet oranje. Toen de balken ook oranje waren, streden ze met de
     lijn om je aandacht en werd het één oranje vlek. Nu is de lijn de vorm
     die je ziet en zijn de balken de vulling erachter. --text-dim werkt in
     beide standen: licht grijs op de donkere achtergrond, donker grijs op
     de witte. */
  .golf-balken rect { fill: var(--text-dim); opacity: .34; }

  .golflijn path {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Zonder dit wordt de lijn op een breed scherm een haardun draadje en op
       een telefoon een dikke worst. */
    vector-effect: non-scaling-stroke;
  }
  .lijn-boven { stroke-width: 2.2; opacity: .92; }
  /* De onderrand iets zachter: dan blijft de bovenkant de hoofdlijn. */
  .lijn-onder { stroke-width: 1.6; opacity: .5; }
</style>
