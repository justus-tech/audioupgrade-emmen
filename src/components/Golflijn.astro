---
/**
 * De geluidsgolf onderin de hero van de homepage.
 *
 * TWEE LAGEN OVER ELKAAR
 *
 *   De balken   Gespiegeld om de middenlijn, zoals een muziekgolfvorm in
 *               Spotify of SoundCloud. Elke balk is de hoogste uitslag van
 *               het geluid binnen zijn stukje — dat is precies hoe zo'n
 *               weergave gemaakt wordt.
 *   De lijn     De oscilloscooplijn eroverheen: de golfvorm zelf, zoals op
 *               meetapparatuur. Eén scherpe lijn. Er liepen eerst twee
 *               zachtere echo's achteraan voor de diepte, maar samen met de
 *               balken werd dat te druk — de balken doen dat werk nu.
 *
 * Ze komen uit dezelfde berekening, dus ze bewegen samen. Dát is wat het
 * echt laat lijken: bij losse berekeningen zie je meteen dat de balken en de
 * lijn niets met elkaar te maken hebben.
 *
 * WAAROM HET ER TRAAG UITZIET: DIT IS EEN SUBWOOFER
 * Een sub doet ongeveer 20 tot 80 hertz. Lange, trage golven met nauwelijks
 * boventonen. Een echte 40 hertz gaat veertig keer per seconde op en neer en
 * dat kun je niet zien; dit is dezelfde vorm op een trage tijdbasis, zoals
 * een uitgezoomde oscilloscoop. Bij elke tel zwelt hij op en zakt weer terug,
 * maar zacht: een sub duwt lucht, hij tikt niet.
 *
 * NIET OVER DE VOLLE BREEDTE OP DESKTOP
 * De golf loopt mee met de tekstbreedte en niet van rand tot rand. Op een
 * breed scherm werden de golven anders zo ver uitgerekt dat er van de vorm
 * niets overbleef, en dan is het geen geluid meer maar een deining.
 *
 * Er speelt geen echt geluid; dit is een model. Alleen `transform` en de
 * lijnen worden aangepast, de animatie stopt zodra hij uit beeld is of het
 * tabblad naar de achtergrond gaat, en bij "verminder beweging" blijft alles
 * stilstaan op de vorm die de server al meestuurt.
 */
const BREEDTE = 1160;
const HOOGTE = 120;
const MIDDEN = HOOGTE / 2;
const PUNTEN = 96;
const BALKEN = 74;

const vakBreedte = BREEDTE / BALKEN;
const balkDikte = Math.max(2, vakBreedte * 0.3);

/** Lage toon: één grondtoon met twee zwakke boventonen. */
function golf(u, t) {
  return (
    0.62 * Math.sin(u * 8.6 + t * 0.9) +
    0.26 * Math.sin(u * 15.5 - t * 1.25 + 1.1) +
    0.12 * Math.sin(u * 23.0 + t * 1.7 + 2.4)
  );
}

/** Dooft uit naar beide randen, zodat de golf niet afgekapt lijkt. */
function omhulsel(u) {
  return Math.pow(Math.sin(u * Math.PI), 0.45);
}

/**
 * De hoogste uitslag binnen één balkje. Zo maak je een muziekgolfvorm: je
 * hakt het geluid in stukjes en tekent per stukje de grootste piek.
 */
function piek(i, t) {
  let max = 0;
  for (let k = 0; k < 4; k++) {
    const u = (i + k / 4) / BALKEN;
    max = Math.max(max, Math.abs(golf(u, t)) * omhulsel(u));
  }
  return max;
}

function padVan(t, sterkte) {
  let d = '';
  let hx = 0;
  let hy = MIDDEN - golf(0, t) * omhulsel(0) * sterkte * MIDDEN;
  d = `M0.0 ${hy.toFixed(1)}`;
  for (let i = 1; i < PUNTEN; i++) {
    const u = i / (PUNTEN - 1);
    const nx = u * BREEDTE;
    const ny = MIDDEN - golf(u, t) * omhulsel(u) * sterkte * MIDDEN;
    if (i < PUNTEN - 1) {
      d += `Q${nx.toFixed(1)} ${ny.toFixed(1)} ${((nx + hx) / 2 + vakBreedte / 2).toFixed(1)} ${((ny + hy) / 2).toFixed(1)}`;
    } else {
      d += `L${nx.toFixed(1)} ${ny.toFixed(1)}`;
    }
    hx = nx;
    hy = ny;
  }
  return d;
}

/* De vorm vóórdat het script begint, en de vorm die blijft staan als iemand
   beweging heeft uitgezet. */
const startBalken = Array.from({ length: BALKEN }, (_, i) => Math.max(0.04, piek(i, 0) * 0.72));
const LIJNEN = [{ klasse: 'lijn-voor', d: padVan(0, 0.74) }];
---
<div class="golflijn" aria-hidden="true">
  <svg viewBox={`0 0 ${BREEDTE} ${HOOGTE}`} preserveAspectRatio="none">
    <g class="golf-balken">
      {startBalken.map((h, i) => (
        <rect
          x={(i * vakBreedte + (vakBreedte - balkDikte) / 2).toFixed(2)}
          y="0"
          width={balkDikte.toFixed(2)}
          height={HOOGTE}
          rx={(balkDikte / 2).toFixed(2)}
          style={`transform: scaleY(${h.toFixed(3)})`}
        />
      ))}
    </g>
    {LIJNEN.map((laag) => <path class={laag.klasse} d={laag.d} />)}
  </svg>
</div>

<script>
  const vak = document.querySelector('.golflijn');
  const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (vak && !stil) {
    const BREEDTE = 1160;
    const MIDDEN = 60;
    const PUNTEN = 96;

    const balken = [...vak.querySelectorAll('.golf-balken rect')];
    const BALKEN = balken.length;

    const golf = (u, t) =>
      0.62 * Math.sin(u * 8.6 + t * 0.9) +
      0.26 * Math.sin(u * 15.5 - t * 1.25 + 1.1) +
      0.12 * Math.sin(u * 23.0 + t * 1.7 + 2.4);

    const omhulsel = (u) => Math.pow(Math.sin(u * Math.PI), 0.45);

    // Vooraf uitgerekend: dit verandert nooit.
    const xen = [];
    const omhulsels = [];
    for (let i = 0; i < PUNTEN; i++) {
      const u = i / (PUNTEN - 1);
      xen.push(u * BREEDTE);
      omhulsels.push(omhulsel(u));
    }

    const lijnen = [{ el: vak.querySelector('.lijn-voor'), vertraging: 0, sterkte: 0.74 }];

    const BPM = 92;
    const TEL = 60 / BPM;

    let tijd = 0;
    let vorig = 0;
    let loopt = false;
    let frame = 0;
    let zwelling = 0.66;
    const balkWaarde = balken.map(() => 0.3);

    function stap(nu) {
      if (!loopt) return;
      const dt = Math.min(0.05, (nu - vorig) / 1000 || 0.016);
      vorig = nu;
      tijd += dt;

      const tel = (tijd / TEL) % 4;
      const inTel = tel % 1;
      const kick = Math.exp(-inTel * 3.2) * 0.42;
      const opTwee = Math.floor(tel) === 1 || Math.floor(tel) === 3;
      const tweede = opTwee ? Math.exp(-inTel * 4.5) * 0.16 : 0;

      const doel = 0.6 + kick + tweede;
      zwelling += (doel - zwelling) * (doel > zwelling ? 0.16 : 0.055);

      // ---- de lijnen ----
      for (const laag of lijnen) {
        const t = tijd - laag.vertraging;
        const sterkte = zwelling * (laag.sterkte / 0.74);
        let hx = 0;
        let hy = MIDDEN - golf(0, t) * omhulsels[0] * sterkte * MIDDEN;
        let d = `M0.0 ${hy.toFixed(1)}`;
        for (let i = 1; i < PUNTEN; i++) {
          const nx = xen[i];
          const ny = MIDDEN - golf(i / (PUNTEN - 1), t) * omhulsels[i] * sterkte * MIDDEN;
          if (i < PUNTEN - 1) {
            d += `Q${nx.toFixed(1)} ${ny.toFixed(1)} ${((nx + hx) / 2 + 7.8).toFixed(1)} ${((ny + hy) / 2).toFixed(1)}`;
          } else {
            d += `L${nx.toFixed(1)} ${ny.toFixed(1)}`;
          }
          hx = nx;
          hy = ny;
        }
        laag.el.setAttribute('d', d);
      }

      // ---- de balken ----
      // Per balkje de hoogste uitslag: precies hoe een muziekgolfvorm
      // gemaakt wordt. Ze komen uit dezelfde golf als de lijn, dus ze
      // bewegen samen.
      for (let i = 0; i < BALKEN; i++) {
        let max = 0;
        for (let k = 0; k < 4; k++) {
          const u = (i + k / 4) / BALKEN;
          max = Math.max(max, Math.abs(golf(u, tijd)) * omhulsel(u));
        }
        const doelBalk = max * zwelling;
        // Iets natrillen, zodat de balken niet exact de lijn volgen.
        balkWaarde[i] += (doelBalk - balkWaarde[i]) * (doelBalk > balkWaarde[i] ? 0.45 : 0.14);
        balken[i].style.transform = `scaleY(${Math.max(0.03, balkWaarde[i]).toFixed(3)})`;
      }

      frame = requestAnimationFrame(stap);
    }

    const start = () => {
      if (loopt) return;
      loopt = true;
      vorig = performance.now();
      frame = requestAnimationFrame(stap);
    };
    const stop = () => {
      loopt = false;
      cancelAnimationFrame(frame);
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([item]) => (item.isIntersecting && !document.hidden ? start() : stop()),
        { threshold: 0 }
      ).observe(vak);
    } else {
      start();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (vak.getBoundingClientRect().bottom > 0) start();
    });
  }
</script>

<style>
  .golflijn {
    position: absolute;
    inset: auto 0 0 0;
    /* Meelopen met de tekstbreedte in plaats van rand tot rand. Op een breed
       scherm werden de golven anders zo ver uitgerekt dat er van de vorm
       niets overbleef. */
    max-width: var(--max);
    margin-inline: auto;
    height: clamp(130px, 21vh, 210px);
    pointer-events: none;
  }
  .golflijn svg { width: 100%; height: 100%; display: block; overflow: visible; }

  /* De balken groeien vanuit het midden naar boven én beneden: dat is de
     gespiegelde vorm die je van muziek kent. */
  .golf-balken rect {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: 50% 50%;
    opacity: .3;
    will-change: transform;
  }

  .golflijn path {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Zonder dit wordt de lijn op een breed scherm een haardun draadje en op
       een telefoon een dikke worst. */
    vector-effect: non-scaling-stroke;
  }
  .lijn-voor { stroke-width: 2.2; opacity: .92; }

  @media (prefers-reduced-motion: reduce) {
    .golf-balken rect { will-change: auto; }
  }
</style>
