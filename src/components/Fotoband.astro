---
/**
 * Een brede fotostrook met een donkere sluier eroverheen.
 *
 * HERKOMST VAN DE FOTO'S
 * Deze staan al op audioupgradeemmen.nl en komen van Unsplash. De Unsplash
 * License staat commercieel gebruik toe zonder toestemming en zonder
 * naamsvermelding. De fotografen worden hieronder toch genoemd — dat hoeft
 * niet, maar het hoort.
 *
 * WAT ER NIET IN MAG
 * Foto's van installaties met zichtbare LED-strips en merkstickers. Justus
 * verkoopt "100% onzichtbaar gemonteerd"; zo'n foto zegt het tegenovergestelde
 * en laat bovendien merken zien die hij niet inbouwt.
 *
 * Zodra er eigen werkfoto's zijn, vervangen die deze bestanden gewoon.
 */
import { Image } from 'astro:assets';

const { foto, alt, hoogte = 'normaal', kop, tekst } = Astro.props;
---
<figure class:list={['fotoband', hoogte === 'laag' && 'fotoband-laag']}>
  <Image src={foto} alt={alt} widths={[640, 1024, 1600, 2000]}
         sizes="100vw" loading="lazy" decoding="async" />
  {(kop || tekst) && (
    <figcaption>
      {kop && <strong>{kop}</strong>}
      {tekst && <span>{tekst}</span>}
    </figcaption>
  )}
</figure>

<style>
  .fotoband {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .fotoband-laag { aspect-ratio: 3 / 1; }

  .fotoband :global(img) {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    /* De foto's zijn stockbeeld met eigen kleurzwemen (paars, blauw). Een
       tikje ontkleuren en donkerder maken haalt die weg, zodat ze niet met
       het oranje vloeken. */
    filter: saturate(.55) contrast(1.05) brightness(.72);
  }

  /* Verloop van onder naar boven, zodat het bijschrift leesbaar blijft.
     Bewust zwart en niet var(--bg): de foto is in beide standen donker, dus
     in de lichte stand zou een lichte sluier de tekst juist wegpoetsen. */
  .fotoband::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, .28) 0%,
      rgba(0, 0, 0, .10) 42%,
      rgba(0, 0, 0, .82) 100%
    );
  }

  figcaption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    z-index: 1;
    padding: 0 24px 28px;
    max-width: var(--max);
    margin: 0 auto;
    text-align: center;
  }
  /* Altijd lichte letters: de foto is in beide standen donker. */
  figcaption strong {
    display: block;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase; letter-spacing: .18em;
    font-size: clamp(.9rem, 2.6vw, 1.25rem);
    color: var(--tekst-op-foto);
    text-shadow: 0 1px 12px rgba(0, 0, 0, .6);
  }
  figcaption span {
    display: block;
    margin: 10px auto 0;
    max-width: 52ch;
    font-size: .92rem;
    color: color-mix(in srgb, var(--tekst-op-foto) 78%, transparent);
    text-shadow: 0 1px 10px rgba(0, 0, 0, .6);
  }

  /* Op een telefoon is 21:9 een streepje van niks. */
  @media (max-width: 700px) {
    .fotoband, .fotoband-laag { aspect-ratio: 4 / 3; }
    figcaption { padding-bottom: 22px; }
  }
</style>
