---
/**
 * De prijzenpagina in het Duits en het Engels.
 *
 * De bedragen komen uit site.js, de teksten eromheen uit i18n/paginas.js.
 * Eén component voor beide talen: zo kunnen de Duitse en de Engelse pagina
 * nooit uit elkaar lopen in opmaak, alleen in woorden.
 *
 * De kenteken-check staat er niet op — zie de uitleg in i18n/talen.js.
 */
import PackageCard from '../PackageCard.astro';
import { AUDIOPAKKETTEN, LOSSE_OPTIES, pakkettenVan } from '../../data/site.js';
import { paginasVan } from '../../i18n/paginas.js';
import { tekstenVan } from '../../i18n/teksten.js';
import { padVan } from '../../i18n/talen.js';
import { pad } from '../../lib/pad.js';
import { whatsappLink, berichtOverAuto } from '../../lib/whatsapp.js';

const { taal } = Astro.props;
const p = paginasVan(taal);
const t = tekstenVan(taal);

/* Dezelfde volgorde en dezelfde tweedeling als op de Nederlandse
   upgradepagina: vier audiopakketten, daarna de twee losse opties. */
const audio = pakkettenVan(AUDIOPAKKETTEN);
const los = pakkettenVan(LOSSE_OPTIES);
---
<section>
  <div class="wrap center">
    <span class="eyebrow">{p.prijzen.eyebrow}</span>
    <h1>{p.prijzen.kop}</h1>
    <p class="lead" style="max-width:62ch;margin:1.3em auto 0;">{p.prijzen.lead}</p>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    {/* De kop hoort hier te staan en niet alleen bovenaan de pagina: zonder
        deze h2 springt de pagina van de h1 naar de h3 van de eerste kaart, en
        dan mist een schermlezer een niveau. */}
    <h2 class="center">{t.pakketten.kop}</h2>

    {/* Naam, prijs en btw-regel komen uit de vertaling en niet uit site.js:
        daar staan ze in het Nederlands ("Vanaf € 695,00", "excl. btw"). Het
        bedrág is hetzelfde, alleen de woorden eromheen verschillen.

        De kaart zelf is dezelfde als op de Nederlandse pagina — tekening,
        oranje kopregel, scorebalkjes en al. Zie PackageCard.astro. */}
    <div class="grid vier gelijk pakketten mt">
      {audio.map((pkg) => (
        <PackageCard pkg={pkg} taal={taal} uitgebreid={true}
                     vertaling={p.pakketten[pkg.slug]} labels={t.kaart} />
      ))}
    </div>

    <div class="losse-opties">
      <h2 class="center">{t.pakketten.losKop}</h2>
      <p class="center" style="margin:0 auto 2.2em;">{t.pakketten.losLead}</p>
      <div class="grid cols-3 gelijk">
        {los.map((pkg) => (
          <PackageCard pkg={pkg} taal={taal} uitgebreid={true} showScores={false}
                       vertaling={p.pakketten[pkg.slug]} labels={t.kaart} />
        ))}
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="grid cols-2">
      <div class="troef">
        <h2>{t.garantie.kop}</h2>
        <p>{t.garantie.tekst}</p>
      </div>
      <div class="troef">
        {/* De korte kop, niet de hele zin: die eindigt op een punt en leest
            als kop niet. De zin zelf staat eronder. */}
        <h2>{t.pakketten.garantieKop}</h2>
        <p>{t.pakketten.garantieStrip} {t.pakketten.garantieKlein}</p>
      </div>
    </div>
  </div>
</section>

<section class="alt center">
  <div class="wrap">
    <h2>{t.slot.kop}</h2>
    <p style="margin:0 auto 2em;">{t.slot.tekst}</p>
    <a class="btn wa" href={whatsappLink(berichtOverAuto(null, taal), taal)}>{t.slot.knop}</a>
    <p style="margin-top:2em">
      <a href={pad(padVan('vragen', taal))}>{t.ui.alg.vragenLink} →</a>
    </p>
  </div>
</section>

<style>
  /* De opmaak van de kaarten zelf staat in PackageCard.astro — daar hoort
     hij, want die kaart staat nu op alle drie de talen. */
  .losse-opties {
    margin-top: 4rem;
    padding-top: 2.6rem;
    border-top: 1px solid var(--line-strong);
  }
  .losse-opties h2 { margin-bottom: .8em; }
</style>
