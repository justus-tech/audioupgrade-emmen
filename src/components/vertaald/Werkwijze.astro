---
/**
 * De werkwijzepagina in het Duits en het Engels.
 *
 * De drie stappen en de vakmanschapspunten komen uit i18n/paginas.js en
 * i18n/teksten.js. De vakmanschapspunten staan óók op de landingspagina —
 * dat is met opzet: het is het sterkste argument dat Justus heeft en het is
 * precies wat iemand op deze pagina komt halen.
 */
import { paginasVan } from '../../i18n/paginas.js';
import { tekstenVan } from '../../i18n/teksten.js';
import { padVan } from '../../i18n/talen.js';
import { pad } from '../../lib/pad.js';
import { whatsappLink, berichtOverAuto } from '../../lib/whatsapp.js';

const { taal } = Astro.props;
const p = paginasVan(taal);
const t = tekstenVan(taal);
---
<section>
  <div class="wrap center">
    <span class="eyebrow">{p.werkwijze.eyebrow}</span>
    <h1>{p.werkwijze.kop}</h1>
    <p class="lead" style="max-width:54ch;margin:1.3em auto 0;">{p.werkwijze.lead}</p>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="grid cols-3">
      {p.werkwijze.stappen.map((s) => (
        <div class="step">
          <span class="num">{s.nummer}</span>
          <h2>{s.kop}</h2>
          <p>{s.tekst}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <span class="eyebrow">{t.vakwerk.eyebrow}</span>
    <h2>{p.werkwijze.vakwerkKop}</h2>
    <div class="grid cols-3 mt">
      {t.vakwerk.punten.map((punt) => (
        <div class="card">
          <h3>{punt.kop}</h3>
          <p>{punt.tekst}</p>
        </div>
      ))}
      <div class="card">
        <h3>{t.garantie.kop}</h3>
        <p>{t.garantie.tekst}</p>
      </div>
    </div>
  </div>
</section>

<section class="alt center">
  <div class="wrap">
    <h2>{p.werkwijze.slotKop}</h2>
    <p style="margin:0 auto 2em;">{t.slot.tekst}</p>
    <a class="btn wa" href={whatsappLink(berichtOverAuto(null, taal), taal)}>{t.slot.knop}</a>
    <p style="margin-top:2em">
      <a href={pad(padVan('vragen', taal))}>{t.ui.alg.vragenLink} →</a>
    </p>
  </div>
</section>

<style>
  .step h2 { font-size: 1.05rem; letter-spacing: .18em; margin-top: .6em; }
</style>
