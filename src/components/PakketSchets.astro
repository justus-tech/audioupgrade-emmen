---
/**
 * Doorkijk: waar komt wat, per pakket.
 *
 * Eén groot bovenaanzicht met genummerde punten. Tik of hover op een punt en
 * de uitleg verschijnt ernaast. Bewust geen lange lijst meer onder de
 * tekening: de uitleg komt naar het punt toe in plaats van andersom.
 *
 * Het zijaanzicht is eruit. Dat was klein, onduidelijk en voegde weinig toe
 * naast het bovenaanzicht.
 *
 * LET OP: hoveren bestaat niet op een telefoon, en daar komt vrijwel al het
 * bezoek vandaan. De bediening werkt daarom op tikken; hoveren is alleen een
 * extraatje op desktop. De punten zijn ook met het toetsenbord te bereiken.
 */
import { PACKAGES } from '../data/site.js';
/* De tekening zelf staat in een gegevensbestand, want de posters voor aan de
   muur gebruiken precies dezelfde auto. Zie src/data/schets.js. */
import { AUTO, ONDERDELEN, ZONES, VOLGORDE, HULPLIJNEN, MATEN, METER } from '../data/schets.js';

const { start = 'akoestische-basis' } = Astro.props;

/* De patronen hebben een eigen naam nodig: staan er twee tekeningen op
   dezelfde pagina, dan mogen ze elkaars arcering niet oppakken. */
const uid = Math.random().toString(36).slice(2, 8);

/**
 * Een onderdeel kan per pakket een andere plek of een andere uitleg hebben.
 * De subwoofer bijvoorbeeld: compact onder de stoel bij de Executive, in een
 * eigen behuizing bij de Reference. `plekPer` en `uitlegPer` gaan mee, en de
 * tekst hieronder kiest de juiste zodra je van pakket wisselt.
 */
const info = Object.fromEntries(
  [...ONDERDELEN, ...ZONES].map((o) => [o.id, {
    naam: o.naam,
    plek: o.plek,
    uitleg: o.uitleg,
    plekPer: o.plekPer || {},
    uitlegPer: o.uitlegPer || {},
  }])
);
---
<div class="ds" data-actief={start}>
  <div class="ds-knoppen" role="tablist" aria-label="Kies een pakket">
    {PACKAGES.map((p) => (
      <button type="button" class="ds-knop" data-pakket={p.slug} role="tab"
              aria-selected={p.slug === start ? 'true' : 'false'}>{p.name}</button>
    ))}
  </div>

  <div class="ds-inhoud">
    <figure class="ds-figuur">
      <svg class="ds-svg" viewBox={AUTO.viewBox} role="img"
           aria-label="Bovenaanzicht van een auto met de plek van de onderdelen">
        <defs>
          {/* Het raster is een meetraster: grof is een meter, fijn een kwart
              meter, en de lijnen vallen op de hartlijn en op de vooras. */}
          <pattern id={`fijn-${uid}`} width={METER / 4} height={METER / 4} patternUnits="userSpaceOnUse"
                   patternTransform={`translate(220 ${MATEN.wielbasis.van})`}>
            <path d={`M ${METER / 4} 0 L 0 0 0 ${METER / 4}`} class="ds-raster" />
          </pattern>
          <pattern id={`grof-${uid}`} width={METER} height={METER} patternUnits="userSpaceOnUse"
                   patternTransform={`translate(220 ${MATEN.wielbasis.van})`}>
            <path d={`M ${METER} 0 L 0 0 0 ${METER}`} class="ds-raster grof" />
          </pattern>
          {/* Arcering: zo geef je op een tekening een behandeld oppervlak aan. */}
          <pattern id={`arcering-${uid}`} width="10" height="10" patternUnits="userSpaceOnUse"
                   patternTransform="rotate(45)">
            <rect width="10" height="10" class="ds-arc-vlak" />
            <path d="M 0 0 L 0 10" class="ds-arc-lijn" />
          </pattern>
          <pattern id={`arcering-zacht-${uid}`} width="20" height="20" patternUnits="userSpaceOnUse"
                   patternTransform="rotate(-45)">
            <rect width="20" height="20" class="ds-arc-vlak zacht" />
            <path d="M 0 0 L 0 20" class="ds-arc-lijn zacht" />
          </pattern>
        </defs>

        <rect x="0" y="0" width={AUTO.breedte} height={AUTO.hoogte} fill={`url(#fijn-${uid})`} />
        <rect x="0" y="0" width={AUTO.breedte} height={AUTO.hoogte} fill={`url(#grof-${uid})`} />

        {/* --- dempingsvlakken, onder de auto door --- */}
        {ZONES.map((z) => z.vlakken.map((vlak) => (
          <path class="ds-vlak" d={vlak} data-id={z.id}
                fill={`url(#arcering${z.zacht ? '-zacht' : ''}-${uid})`}
                data-pakketten={z.pakketten.join(' ')} />
        )))}

        {/* --- carrosserie --- */}
        <g class="ds-lijn">
          {AUTO.paden.map((v) => <path d={v.d} class={`ds-${v.klasse}`} />)}
        </g>

        {/* --- hartlijn, assen en de schaalbalk --- */}
        <g class="ds-hulp">
          <path d={HULPLIJNEN.hart} class="hart" />
          {HULPLIJNEN.assen.map((a) => <path d={a} class="as" />)}
          {HULPLIJNEN.kruizen.map((k) => <path d={k} class="as" />)}
        </g>
        <g class="ds-schaal">
          <path d={`M 107 642 L 107 652 M ${107 + METER} 642 L ${107 + METER} 652 M 107 647 L ${107 + METER} 647`} />
          <text x={107 + METER / 2} y="666" text-anchor="middle">1 meter</text>
        </g>

        {/* --- gespiegelde punten zonder eigen nummer --- */}
        {ONDERDELEN.filter((o) => o.spiegel).map((o) => (
          <circle class="ds-spiegel" cx={o.spiegel} cy={o.y} r="7"
                  data-id={o.id} data-pakketten={o.pakketten.join(' ')} />
        ))}

        {/* --- de aanklikbare punten --- */}
        {[...ONDERDELEN, ...ZONES].map((o) => (
          <g class="ds-punt" data-id={o.id} data-pakketten={o.pakketten.join(' ')}
             role="button" tabindex="0" aria-label={o.naam}>
            <circle class="ds-halo" cx={o.x} cy={o.y} r="26" />
            <circle class="ds-bol" cx={o.x} cy={o.y} r="16" />
            <text class="ds-nr" x={o.x} y={o.y} text-anchor="middle"
                  dominant-baseline="central"></text>
          </g>
        ))}
      </svg>
      <figcaption class="ds-hint">Tik op een nummer voor uitleg</figcaption>
    </figure>

    <aside class="ds-uitleg" aria-live="polite">
      <span class="ds-uitleg-nr" id="ds-nr"></span>
      <h3 class="ds-uitleg-kop" id="ds-kop"></h3>
      <p class="ds-uitleg-plek" id="ds-plek"></p>
      <p class="ds-uitleg-tekst" id="ds-tekst"></p>
      <p class="ds-voet">Plaatsing verschilt per auto. Wij bepalen de exacte plek op basis van jouw model.</p>
    </aside>
  </div>

  <script type="application/json" class="ds-info" set:html={JSON.stringify({ info, volgorde: VOLGORDE })}></script>
</div>

<script>
  document.querySelectorAll('.ds').forEach((blok) => {
    const { info, volgorde } = JSON.parse(blok.querySelector('.ds-info').textContent);
    const knoppen = blok.querySelectorAll('.ds-knop');
    const nrEl = blok.querySelector('#ds-nr');
    const kopEl = blok.querySelector('#ds-kop');
    const plekEl = blok.querySelector('#ds-plek');
    const tekstEl = blok.querySelector('#ds-tekst');

    let nummers = {};

    /** Toont de uitleg van één onderdeel en licht het bijbehorende punt op. */
    function kies(id) {
      if (!info[id]) return;
      blok.querySelectorAll('[data-id]').forEach((el) => {
        el.classList.toggle('gekozen', el.dataset.id === id);
      });
      const pakket = blok.dataset.actief;
      gekozenId = id;
      nrEl.textContent = nummers[id] ?? '';
      kopEl.textContent = info[id].naam;
      plekEl.textContent = info[id].plekPer[pakket] || info[id].plek;
      tekstEl.textContent = info[id].uitlegPer[pakket] || info[id].uitleg;
    }

    /* Welk onderdeel staat er open? Wisselt de bezoeker van pakket, dan moet
       dezelfde uitleg opnieuw getekend worden — de plek kan nu verschillen. */
    let gekozenId = '';

    function toonPakket(slug) {
      blok.dataset.actief = slug;

      knoppen.forEach((k) => {
        const aan = k.dataset.pakket === slug;
        k.classList.toggle('aan', aan);
        k.setAttribute('aria-selected', aan ? 'true' : 'false');
      });

      blok.querySelectorAll('[data-pakketten]').forEach((el) => {
        el.classList.toggle('aan', el.dataset.pakketten.split(' ').includes(slug));
      });

      // Nummeren in vaste volgorde, alleen wat bij dit pakket hoort.
      nummers = {};
      let n = 0;
      volgorde.forEach((id) => {
        const punt = blok.querySelector(`.ds-punt[data-id="${id}"]`);
        if (!punt || !punt.classList.contains('aan')) return;
        n += 1;
        nummers[id] = n;
        punt.querySelector('.ds-nr').textContent = String(n);
      });

      /* Staat het onderdeel dat openstond ook in dit pakket, dan blijft het
         openstaan — maar wel met de tekst van dit pakket erbij. Zo niet, dan
         het eerste, zodat het paneel nooit leeg is. */
      const blijft = nummers[gekozenId] ? gekozenId : '';
      const eerste = blijft || volgorde.find((id) => nummers[id]);
      if (eerste) kies(eerste);
    }

    blok.querySelectorAll('.ds-punt').forEach((punt) => {
      const id = punt.dataset.id;
      punt.addEventListener('click', () => kies(id));
      punt.addEventListener('mouseenter', () => kies(id));
      punt.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          kies(id);
        }
      });
    });

    knoppen.forEach((k) => k.addEventListener('click', () => toonPakket(k.dataset.pakket)));
    toonPakket(blok.dataset.actief);
  });
</script>

<style>
  .ds { --uit: color-mix(in srgb, var(--text-dim) 30%, transparent); }

  /* ---- pakketknoppen ---- */
  .ds-knoppen { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 34px; }
  .ds-knop {
    font-family: 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: .12em;
    font-size: .76rem; padding: 11px 20px; cursor: pointer;
    background: transparent; color: var(--text-dim);
    border: 1px solid var(--line-strong); border-radius: 3px;
    transition: all .2s;
  }
  @media (hover: hover) {
    .ds-knop:hover { color: var(--text); border-color: var(--text-dim); }
  }
  .ds-knop.aan {
    background: var(--accent); border-color: var(--accent); color: var(--accent-ink);
  }

  /* ---- indeling ---- */
  .ds-inhoud {
    display: grid; grid-template-columns: minmax(240px, 380px) 1fr;
    gap: 56px; align-items: center;
  }
  @media (max-width: 820px) {
    .ds-inhoud { grid-template-columns: 1fr; gap: 30px; }
  }

  .ds-figuur { margin: 0; }
  .ds-svg { width: 100%; height: auto; display: block; max-width: 380px; margin: 0 auto; }
  .ds-hint {
    text-align: center; margin-top: 14px;
    font-family: 'Oswald', sans-serif; text-transform: uppercase;
    letter-spacing: .24em; font-size: .64rem; color: var(--text-dim);
  }

  /* ---- de auto ---- */
  /* De auto. De carrosserie krijgt de stevigste lijn; alles daarbinnen is
     lichter, zodat je door het dak heen kijkt zonder dat het rommelig wordt.
     Zie src/data/schets.js voor de vormen zelf. */
  .ds-lijn { fill: none; stroke: var(--text-dim); stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .ds-omtrek { stroke-width: 2.6; opacity: .95; }
  .ds-paneel { opacity: .5; stroke-width: 1.5; }
  .ds-detail { opacity: .3; stroke-width: 1.1; }
  .ds-ruit { opacity: .4; fill: color-mix(in srgb, var(--text) 4%, transparent); }
  .ds-dak { opacity: .18; }
  .ds-lamp { opacity: .5; stroke-width: 1.2; fill: color-mix(in srgb, var(--text-dim) 14%, transparent); }
  .ds-spiegelkap { opacity: .7; fill: color-mix(in srgb, var(--text-dim) 22%, transparent); stroke-width: 1.4; }
  .ds-wiel { fill: color-mix(in srgb, var(--text-dim) 24%, transparent); stroke: none; }
  .ds-stuur { opacity: .5; stroke-width: 1.5; }
  .ds-console { opacity: .26; stroke-width: 1.4; }
  .ds-stoel { opacity: .36; stroke-width: 1.5; }
  .ds-vulling { fill: color-mix(in srgb, var(--text-dim) 18%, transparent); stroke: none; }
  .ds-kussen { fill: color-mix(in srgb, var(--text-dim) 12%, transparent); opacity: .5; stroke-width: 1.3; }

  /* ---- dempingsvlakken ---- */
  /* ---- ruitjespapier ---- */
  .ds-raster { fill: none; stroke: var(--accent); stroke-opacity: .09; stroke-width: .7; }
  .ds-raster.grof { stroke-opacity: .16; stroke-width: 1; }

  /* ---- dempingsvlakken ---- */
  /* De vulling komt uit de arcering in de defs; aan of uit regelen we met
     doorzichtigheid. Ze liggen onder de auto, dus de lijnen van de deur en
     de stoelen lopen er dwars overheen. */
  .ds-arc-vlak { fill: color-mix(in srgb, var(--accent) 9%, transparent); }
  .ds-arc-lijn { stroke: var(--accent); stroke-opacity: .55; stroke-width: 1.1; }
  .ds-arc-vlak.zacht { fill: color-mix(in srgb, var(--accent) 4%, transparent); }
  .ds-arc-lijn.zacht { stroke-opacity: .3; stroke-width: .9; }
  .ds-vlak {
    opacity: 0;
    stroke: var(--accent); stroke-opacity: .5; stroke-width: 1.1;
    transition: opacity .3s ease;
  }
  .ds-vlak.aan { opacity: .8; }
  .ds-vlak.gekozen { opacity: 1; }

  /* ---- hulplijnen en schaal ---- */
  .ds-hulp path { fill: none; stroke: var(--accent); stroke-opacity: .34; stroke-width: .9; }
  .ds-hulp .hart { stroke-dasharray: 22 5 3 5; }
  .ds-hulp .as { stroke-dasharray: 16 4 2.5 4; }
  .ds-schaal path { fill: none; stroke: var(--text-dim); stroke-width: 1; opacity: .5; }
  .ds-schaal text {
    font-family: 'Oswald', sans-serif; text-transform: uppercase;
    letter-spacing: .2em; font-size: 13px; fill: var(--text-dim);
  }

  /* ---- punten ---- */
  .ds-punt { cursor: pointer; opacity: 0; pointer-events: none; transition: opacity .3s ease; }
  .ds-punt.aan { opacity: 1; pointer-events: auto; }
  .ds-punt:focus { outline: none; }
  .ds-punt:focus-visible .ds-halo { fill: color-mix(in srgb, var(--accent) 40%, transparent); }

  .ds-halo { fill: transparent; transition: fill .25s ease; }
  /* Een rand in de kleur van de pagina, zodat de bol niet vastloopt in de
     arcering eronder. Op een tekening heet dat een uitsparing. */
  .ds-bol, .ds-spiegel { stroke: var(--bg); stroke-width: 3; }
  .ds-bol { fill: var(--uit); transition: fill .25s ease; }
  .ds-nr {
    font-family: 'Oswald', sans-serif; font-size: 17px; font-weight: 600;
    fill: var(--accent-ink); pointer-events: none;
  }
  .ds-punt.aan .ds-bol { fill: var(--accent); }
  .ds-punt.gekozen .ds-halo { fill: color-mix(in srgb, var(--accent) 26%, transparent); }
  @media (hover: hover) {
    .ds-punt.aan:hover .ds-halo { fill: color-mix(in srgb, var(--accent) 26%, transparent); }
  }

  .ds-spiegel { fill: var(--uit); opacity: 0; transition: opacity .3s ease, fill .25s ease; }
  .ds-spiegel.aan { opacity: 1; fill: var(--accent); }

  /* ---- uitlegpaneel ---- */
  .ds-uitleg { min-height: 210px; }
  .ds-uitleg-nr {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--accent); color: var(--accent-ink);
    font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 1rem;
    margin-bottom: 16px;
  }
  .ds-uitleg-kop { margin: 0 0 6px; }
  .ds-uitleg-plek {
    font-family: 'Oswald', sans-serif; text-transform: uppercase;
    letter-spacing: .2em; font-size: .68rem; color: var(--accent-text); margin: 0 0 16px;
  }
  .ds-uitleg-tekst { font-size: .98rem; margin: 0; max-width: 46ch; }
  .ds-voet { font-size: .78rem; margin-top: 22px; opacity: .7; }
</style>
