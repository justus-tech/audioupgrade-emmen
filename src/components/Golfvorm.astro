---
/**
 * Een spectrumanalyser als beeldmerk voor de hero.
 *
 * WAT DIT MOET UITSTRALEN
 * Dat er muziek speelt. De eerste versie was een rij balken die elk hun eigen
 * sinus ademden: netjes, maar schematisch — je zag meteen dat het een patroon
 * was en geen geluid.
 *
 * Deze versie doet een echte spectrumanalyser na:
 *
 *   Frequentieverdeling  Lage tonen links, hoge rechts, logaritmisch verdeeld
 *                        zoals elke analyser dat toont. Muziek heeft van
 *                        nature meer energie onderin, dus de linkerkant staat
 *                        hoger dan de rechter.
 *   Ballistiek           Snel omhoog, langzaam omlaag. Dat is hoe een echte
 *                        analyser reageert, en het is precies wat het
 *                        levendig maakt in plaats van trillerig.
 *   Ritme                Een kickdrum op elke tel die de onderste banden
 *                        optilt, en een snare op de tweede en vierde tel die
 *                        de midden en hoogte raakt.
 *   Ruis                 Per band een eigen wandeling, zodat er nooit twee
 *                        banden precies gelijk lopen.
 *
 * ZUINIG MET DE ACCU
 * 99% van de bezoekers zit op een telefoon. Daarom:
 *   - alleen `transform` wordt aangepast, dus de browser hoeft niets opnieuw
 *     te berekenen aan de indeling van de pagina
 *   - de animatie stopt zodra hij uit beeld is of het tabblad naar de
 *     achtergrond gaat
 *   - staat "verminder beweging" aan, dan komt er een stilstaand spectrum en
 *     start er helemaal geen animatie
 *
 * Zonder JavaScript zie je datzelfde stilstaande spectrum.
 */
const { balken = 116 } = Astro.props;

const BREEDTE = 1160;
const HOOGTE = 120;
const vak = BREEDTE / balken;
/* Smal en dicht op elkaar: dat oogt als een analyser, niet als een grafiek. */
const dikte = Math.max(2, vak * 0.34);

/**
 * De beginhoogtes. Deze staan er ook als er geen JavaScript is, dus ze moeten
 * op zichzelf al goed ogen: een geloofwaardige momentopname van muziek.
 */
const staven = Array.from({ length: balken }, (_, i) => {
  const t = i / (balken - 1);
  // Muziek heeft de meeste energie onderin en loopt naar boven toe af.
  const helling = Math.pow(1 - t, 0.85) * 0.68 + 0.22;
  // Wat oneffenheid, anders is het een gladde helling in plaats van geluid.
  const rimpel =
    0.72 +
    0.28 * Math.sin(i * 0.7) * Math.cos(i * 0.23) +
    0.12 * Math.sin(i * 2.1);
  return Math.max(0.05, Math.min(1, helling * rimpel));
});
---
<div class="golfvorm" aria-hidden="true" data-balken={balken}>
  <svg viewBox={`0 0 ${BREEDTE} ${HOOGTE}`} preserveAspectRatio="none">
    {staven.map((h, i) => (
      <rect
        x={(i * vak + (vak - dikte) / 2).toFixed(2)}
        y="0"
        width={dikte.toFixed(2)}
        height={HOOGTE}
        rx={(dikte / 2).toFixed(2)}
        style={`transform: scaleY(${h.toFixed(3)})`}
      />
    ))}
  </svg>
</div>

<script>
  /**
   * De analyser. Er is geen echt geluid: dit is een model van hoe muziek
   * eruitziet in een spectrum. Zie de uitleg boven in dit bestand.
   */
  const vak = document.querySelector('.golfvorm');
  const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (vak && !stil) {
    const staven = [...vak.querySelectorAll('rect')];
    const n = staven.length;

    /** Waar in het spectrum zit deze balk: 0 = laag, 1 = hoog. */
    const positie = staven.map((_, i) => i / (n - 1));

    /** Hoe hard muziek gemiddeld in deze band zit. */
    const basis = positie.map((t) => Math.pow(1 - t, 0.85) * 0.68 + 0.2);

    /** Elke band z'n eigen wandeling, zodat er nooit twee gelijk lopen. */
    const ruis = positie.map(() => Math.random() * Math.PI * 2);
    const ruisSnelheid = positie.map((t) => 0.8 + t * 3.4);

    const waarde = staven.map(() => 0.2);
    const doel = staven.map(() => 0.2);

    const BPM = 98;
    const TEL = 60 / BPM;

    let tijd = 0;
    let vorig = 0;
    let loopt = false;
    let frame = 0;

    function stap(nu) {
      if (!loopt) return;
      const dt = Math.min(0.05, (nu - vorig) / 1000 || 0.016);
      vorig = nu;
      tijd += dt;

      // Waar in de maat zitten we? Vier tellen per maat.
      const tel = (tijd / TEL) % 4;
      const inTel = tel % 1;

      // Kickdrum op elke tel: kort, hard, alleen onderin.
      const kick = Math.exp(-inTel * 11) * 0.85;
      // Snare op tel 2 en 4: raakt de midden en de hoogte.
      const opSnare = Math.floor(tel) === 1 || Math.floor(tel) === 3;
      const snare = opSnare ? Math.exp(-inTel * 15) * 0.7 : 0;

      for (let i = 0; i < n; i++) {
        const t = positie[i];

        ruis[i] += dt * ruisSnelheid[i];
        // Twee sinussen over elkaar geeft een beweging die niet herhaalt.
        const wiebel = 0.5 + 0.5 * Math.sin(ruis[i]) * Math.cos(ruis[i] * 0.61);

        // De kick zit onder in het spectrum, de snare in het midden en hoog.
        const laag = Math.max(0, 1 - t * 5);
        const midHoog = Math.max(0, Math.min(1, (t - 0.18) * 2.2));

        doel[i] = Math.min(
          1,
          // Hoe hoger de band, hoe meer hij beweegt: hoge tonen zijn
          // grilliger dan bassen.
          basis[i] * (0.42 + (0.5 + t * 0.5) * wiebel) + kick * laag + snare * midHoog * 0.6
        );

        // Snel omhoog, langzaam omlaag: de ballistiek van een echte analyser.
        const snelheid = doel[i] > waarde[i] ? 0.6 : 0.11;
        waarde[i] += (doel[i] - waarde[i]) * snelheid;

        staven[i].style.transform = `scaleY(${Math.max(0.04, waarde[i]).toFixed(3)})`;
      }

      frame = requestAnimationFrame(stap);
    }

    function start() {
      if (loopt) return;
      loopt = true;
      vorig = performance.now();
      frame = requestAnimationFrame(stap);
    }

    function stop() {
      loopt = false;
      cancelAnimationFrame(frame);
    }

    // Niet laten draaien als niemand kijkt: dat kost alleen accu.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([item]) => (item.isIntersecting && !document.hidden ? start() : stop()),
        { threshold: 0 }
      ).observe(vak);
    } else {
      start();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (vak.getBoundingClientRect().bottom > 0) start();
    });
  }
</script>

<style>
  .golfvorm {
    position: absolute;
    inset: auto 0 0 0;
    height: clamp(130px, 21vh, 210px);
    pointer-events: none;
    /* Vervaagt naar boven weg, zodat de tekst erboven leesbaar blijft. */
    mask-image: linear-gradient(to top, #000 14%, transparent 94%);
    -webkit-mask-image: linear-gradient(to top, #000 14%, transparent 94%);
    opacity: .5;
  }
  .golfvorm svg { width: 100%; height: 100%; display: block; }

  .golfvorm rect {
    fill: var(--accent);
    /* Groeien vanaf de onderkant, zoals een analyser hoort te doen. */
    transform-box: fill-box;
    transform-origin: 50% 100%;
    will-change: transform;
  }

  /* Wie beweging heeft uitgezet krijgt het stilstaande spectrum uit de HTML. */
  @media (prefers-reduced-motion: reduce) {
    .golfvorm rect { will-change: auto; }
  }
</style>
