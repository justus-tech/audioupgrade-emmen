---
import '../styles/global.css';
import { SITE, PACKAGES, SCHEMA_SOORT } from '../data/site.js';
import { BRAND, LICHT, cssThema } from '../data/brand.js';
import Logo from '../components/Logo.astro';
import Herkomst from '../components/Herkomst.astro';
import { pad } from '../lib/pad.js';
import { whatsappLink, berichtOverAuto } from '../lib/whatsapp.js';
import Taalkiezer from '../components/Taalkiezer.astro';
import { TALEN, TAALVOLGORDE, STANDAARDTAAL, taalPad, wisselPad, padVan } from '../i18n/talen.js';
import { tekstenVan } from '../i18n/teksten.js';

/**
 * `taal` bepaalt het lang-attribuut, het menu, de voettekst en de
 * hreflang-verwijzingen. Zonder opgave: Nederlands. Zo blijven alle
 * bestaande pagina's werken zonder dat er iets aan hoeft.
 */
/**
 * `sleutel` is de naam van de pagina in de routekaart (zie i18n/talen.js).
 * Daarmee weet de taalknop dat /de/preise en /en/pricing dezelfde pagina
 * zijn. Pagina's zonder tegenhanger in andere talen — de modelpagina's, de
 * voorwaarden — geven hem niet mee; daar valt de taalknop terug op de
 * startpagina van die taal.
 */
const {
  title, description, path = '/', noindex = false,
  taal = STANDAARDTAAL, sleutel = null,
} = Astro.props;

const T = tekstenVan(taal).ui;
const dezeTaal = TALEN[taal] ?? TALEN[STANDAARDTAAL];
/**
 * Het volledige adres van deze pagina. pad() zet de mapnaam ervoor als de
 * site op de voorbeeldplek staat; Astro.site levert het domein.
 */
const canonical = new URL(pad(taalPad(taal, path)), Astro.site).href;

/**
 * Draait dit de voorbeeldsite op GitHub? Die mag NIET in Google komen: de
 * echte site staat nog op het oude domein, en twee versies van dezelfde
 * teksten laten Google kiezen welke hij toont. Dat wil je niet aan het
 * toeval overlaten.
 */
const voorbeeld = String(Astro.site || '').includes('github.io');

/**
 * Meet dit bezoek mee? Alleen op de echte, gepubliceerde site.
 *
 * De teller staat aan als METEN=1 in de omgeving staat, en dat gebeurt
 * alleen in .github/workflows/deploy.yml. Bouw je hier op de laptop, dan
 * zit het teltekstje er dus niet in. Dat is met opzet:
 *
 *   - je eigen gerommel telt niet mee in je cijfers;
 *   - de tests hoeven het internet niet op om een scriptje van Cloudflare
 *     te halen, en blijven dus ook werken zonder verbinding.
 */
const meten = !voorbeeld && process.env.METEN === '1';

/**
 * Cloudflare Web Analytics. Deze token is met opzet openbaar: hij staat in
 * de broncode van elke pagina en hoort daar ook. Je kunt er niets mee dan
 * bezoek melden aan deze ene site. Verwar hem niet met een API-sleutel.
 *
 * Er worden geen cookies gezet en geen IP-adressen bewaard. Daarom hoeft er
 * geen toestemmingsbalk voor — zie ook het cookiebeleid.
 */
const METEN_TOKEN = '5d1c66fd18124f3ebb875587dd008168';

/**
 * Het menu.
 *
 * In het Nederlands staan hier zes ingangen. In het Duits en het Engels is de
 * site één pagina: de modelpagina's, de werkwijze en de vragenpagina bestaan
 * daar (nog) niet, en een menu-item dat naar een Nederlandse pagina wijst is
 * erger dan geen menu-item. Daar tonen we dus alleen wat er echt is.
 */
/**
 * In het Nederlands staat de modellenlijst in het menu. In het Duits en Engels
 * niet: die pagina's zijn Nederlands en de kenteken-check erop werkt alleen
 * met Nederlandse kentekens. De rest van het menu is in alle talen hetzelfde.
 */
const MENU = [
  { sleutel: 'home', label: T.menu.home },
  { sleutel: 'prijzen', label: T.menu.upgrades },
  ...(taal === STANDAARDTAAL
    ? [{ href: '/audio-upgrade', label: T.menu.auto }]
    : []),
  { sleutel: 'werkwijze', label: T.menu.werkwijze },
  /* Op verzoek van Justus' broer erbij gezet, naast Contact. Zes items passen:
     op een telefoon schuift het menu horizontaal (zie nav.main in global.css),
     dus er valt niets af. */
  { sleutel: 'over', label: T.menu.over },
  { sleutel: 'contact', label: T.menu.contact },
];

const nav = MENU.map((item) => ({
  label: item.label,
  href: item.sleutel ? padVan(item.sleutel, taal) : item.href,
  hier: item.sleutel ? item.sleutel === sleutel : item.href === path,
}));

/**
 * De verwijzingen naar dezelfde pagina in de andere talen.
 *
 * Zonder deze regels weet Google niet dat /de en / hetzelfde bedrijf zijn en
 * kan hij ze als concurrenten van elkaar behandelen. x-default vertelt hem
 * welke versie hij moet tonen als hij de taal van de bezoeker niet kent.
 */
const anderetalen = TAALVOLGORDE.map((code) => ({
  hreflang: TALEN[code].hreflang,
  href: new URL(pad(wisselPad(code, sleutel)), Astro.site).href,
}));
---
<!doctype html>
<html lang={dezeTaal.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* Huisstijlkleuren uit src/data/brand.js — de enige plek waar ze staan.
      Donker staat op :root, licht hangt aan data-thema op <html>. */}
  <style is:global set:html={cssThema}></style>
  <meta name="theme-color" content={BRAND.bg} id="thema-kleur" />

  {/* Moet hierboven blijven staan en zónder type="module" of defer: dit
      script moet klaar zijn vóórdat de pagina getekend wordt. Anders ziet
      iemand die licht heeft gekozen eerst een tel de donkere site. */}
  <script is:inline set:html={`
    (function () {
      try {
        var keuze = localStorage.getItem('aue-thema');
        if (keuze === 'licht' || keuze === 'donker') {
          document.documentElement.dataset.thema = keuze;
        }
      } catch (e) {
        /* privémodus: dan blijft het gewoon donker */
      }
    })();
  `}></script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {/* Welke versie hoort bij welke taal. Zonder dit kan Google /de en / als
      twee concurrerende pagina's zien in plaats van als twee talen van
      hetzelfde. x-default is wat hij toont als hij de taal niet kent. */}
  {!noindex && anderetalen.map((t) => (
    <link rel="alternate" hreflang={t.hreflang} href={t.href} />
  ))}
  {!noindex && (
    <link rel="alternate" hreflang="x-default" href={new URL(pad(wisselPad('nl', sleutel)), Astro.site).href} />
  )}
  {(noindex || voorbeeld) && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="nl_NL" />
  {/* De afbeelding die WhatsApp toont als iemand de link deelt. Afmetingen
      erbij: dan reserveert WhatsApp meteen de goede ruimte en verspringt de
      voorbeeldweergave niet als het beeld binnenkomt.
      Opnieuw maken? node scripts/deelplaatje.mjs */}
  <meta property="og:image" content={new URL(pad('/og-image.png'), Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="Audio Upgrade Emmen — groots geluid, onzichtbaar ingebouwd" />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href={pad("/favicon.svg")} />
  <link rel="apple-touch-icon" href={pad("/og-image.png")} />
  {/* De lettertypen staan op onze eigen server; zie de kop van global.css.
      Hier stond eerst een verwijzing naar fonts.googleapis.com, en daarmee
      ging het IP-adres van elke bezoeker naar Google.

      Deze twee laden we vooruit: hierin staan de eerste woorden op het scherm
      (de kop in Oswald, de zin eronder in Inter). Zonder dit ontdekt de
      browser ze pas als hij de stylesheet gelezen heeft, en zie je de tekst
      eerst kort in het reservelettertype staan.

      Alleen de latin-bestanden. De latin-ext-varianten worden pas opgehaald
      als er echt een teken uit staat, bijvoorbeeld de š van Škoda. */}
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={pad("/fonts/oswald-latin.woff2")} />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={pad("/fonts/inter-latin.woff2")} />
  {/* De bedrijfsgegevens, machineleesbaar. Hier haalt Google zijn
      bedrijfskaartje uit, en een AI-assistent zijn antwoord op "waar kan ik
      in Drenthe CarPlay laten inbouwen".

      LET OP: hier staat bewust GEEN aggregateRating. Een beoordelingscijfer
      opgeven zonder echte beoordelingen is in strijd met de regels van Google
      én misleidend voor de klant. Zodra er echte Google-recensies zijn mogen
      die hier in. */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    /* Zie de uitleg bij SCHEMA_SOORT in site.js: hier stond 'AutoRepair' en
       dat trok de verkeerde bezoeker. De additionalType wijst naar de
       Wikipedia-pagina over car audio, zodat er geen misverstand kan bestaan
       over wat voor winkel dit precies is. */
    '@type': SCHEMA_SOORT,
    additionalType: 'https://en.wikipedia.org/wiki/Vehicle_audio',
    '@id': `${SITE.url}/#bedrijf`,
    name: SITE.name,
    url: SITE.url,
    telephone: SITE.phone,
    email: SITE.email,
    priceRange: '€695 - €3695',
    currenciesAccepted: 'EUR',
    vatID: SITE.btw,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.street,
      postalCode: SITE.postalCode,
      addressLocality: SITE.city,
      addressRegion: SITE.region,
      addressCountry: SITE.country,
    },
    areaServed: [
      { '@type': 'City', name: 'Emmen' },
      { '@type': 'AdministrativeArea', name: 'Drenthe' },
      { '@type': 'Country', name: 'Nederland' },
    ],
    knowsLanguage: 'nl-NL',
    availableLanguage: 'Nederlands',
    /* Geen vaste openingstijden: het is uitsluitend op afspraak. Dat zetten
       we in de omschrijving en niet in openingHours, want daar zou je dan
       tijden moeten verzinnen die niet kloppen. */
    description:
      'Premium car audio, draadloze CarPlay- en Android Auto-inbouw, DSP-tuning en akoestische deurdemping in Emmen (Drenthe). Uitsluitend op afspraak. Onzichtbaar weggewerkt achter de originele panelen, met behoud van fabrieksgarantie.',
    makesOffer: PACKAGES.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      description: p.short,
      priceCurrency: 'EUR',
      ...(p.bedrag ? { price: p.bedrag } : { availability: 'https://schema.org/InStock' }),
      itemOffered: { '@type': 'Service', name: p.name, serviceType: 'Car audio upgrade' },
    })),
  })} />
</head>
<body>
  {/* Voor wie met het toetsenbord navigeert. Zonder dit moet je op elke
      pagina eerst door het hele menu tabben voordat je bij de inhoud bent.
      De link is onzichtbaar tot hij focus krijgt. */}
  <a class="overslaan" href="#inhoud">{T.overslaan}</a>

  {/* Zet "(via google)" achter het voorgetypte WhatsApp-bericht als iemand
      via ?bron=google binnenkomt. Zo ziet Justus in zijn eigen WhatsApp welke
      gesprekken uit een advertentie komen, zonder cookie of tag. */}
  <Herkomst />

  <header class="site">
    <div class="wrap">
      <a class="logo" href={pad(taalPad(taal, '/'))} aria-label={SITE.name}>
        <Logo height={26} decoratief={true} />
        <span class="logo-text">Audio Upgrade <span>Emmen</span></span>
      </a>
      <nav class="main">
        {nav.map((item) => (
          <a href={pad(item.href)} aria-current={item.hier ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      {/* De twee schakelaars rechtsboven, in één rijtje. Op een telefoon staat
          dit hele blokje op de regel van het logo — zie .hulpmiddelen in
          global.css. */}
      <div class="hulpmiddelen">
        <Taalkiezer taal={taal} sleutel={sleutel} />

      {/* Wisselen tussen licht en donker. Twee tekeningen over elkaar: de CSS
          laat zien welke van de twee bij de huidige stand hoort. */}
      <button class="thema-knop" id="thema-knop" type="button"
              aria-label={T.themaKnop}>
        <svg viewBox="0 0 24 24" class="ik-zon" aria-hidden="true">
          <circle cx="12" cy="12" r="4.6" />
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1" />
        </svg>
        <svg viewBox="0 0 24 24" class="ik-maan" aria-hidden="true">
          <path d="M20 14.2A8.4 8.4 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z" />
        </svg>
      </button>
      </div>
    </div>
  </header>

  <main id="inhoud">
    <slot />
  </main>

  {/* Zweeft mee op de telefoon. Vrijwel al het bezoek komt van mobiel, en dit
      haalt de drempel weg om te appen: waar je ook op de pagina bent, de knop
      staat er. Op desktop verbergen we hem — daar staan de knoppen in beeld. */}
  <a class="wa-zwevend" href={whatsappLink(berichtOverAuto(), taal)} aria-label={T.voettekst.appDashboard}>
    {T.voettekst.appDashboard}
  </a>

  <script define:vars={{ donkerKleur: BRAND.bg, lichtKleur: LICHT.bg }}>
    /**
     * De knop voor licht en donker.
     *
     * De keuze staat in localStorage, zodat hij bij een volgend bezoek nog
     * klopt. Het inleesgedeelte staat bewust in de <head> — hier zetten we
     * alleen de knop aan.
     */
    const themaKnop = document.getElementById('thema-knop');
    const themaKleur = document.getElementById('thema-kleur');
    const systeemLicht = window.matchMedia('(prefers-color-scheme: light)');

    /**
     * Welke stand staat er nú op het scherm?
     *
     * Heeft de bezoeker zelf gekozen, dan staat dat in het data-thema van
     * <html>. Zo niet, dan volgt de site de instelling van de telefoon of
     * laptop — en die moeten we hier dus uitlezen, want er staat geen
     * attribuut waaraan we het kunnen zien.
     */
    function huidigThema() {
      const gekozen = document.documentElement.dataset.thema;
      if (gekozen === 'licht' || gekozen === 'donker') return gekozen;
      return systeemLicht.matches ? 'licht' : 'donker';
    }

    function toonThema(naam) {
      // De balk bovenaan de telefoon meekleuren, anders blijft die zwart.
      if (themaKleur) themaKleur.content = naam === 'licht' ? lichtKleur : donkerKleur;
      if (themaKnop) themaKnop.setAttribute('aria-pressed', naam === 'licht' ? 'true' : 'false');
    }

    function kiesThema(naam) {
      document.documentElement.dataset.thema = naam;
      toonThema(naam);
      try {
        localStorage.setItem('aue-thema', naam);
      } catch (e) {
        /* privémodus: dan geldt de keuze alleen voor dit bezoek */
      }
    }

    toonThema(huidigThema());

    if (themaKnop) {
      themaKnop.addEventListener('click', () => {
        kiesThema(huidigThema() === 'licht' ? 'donker' : 'licht');
      });
    }

    // Zet iemand zijn telefoon halverwege op nachtstand, dan gaat de site mee
    // — tenzij hij hier zelf een keuze heeft gemaakt.
    systeemLicht.addEventListener('change', () => {
      if (!document.documentElement.dataset.thema) toonThema(huidigThema());
    });

    /**
     * Inhoud rustig laten verschijnen bij het scrollen.
     *
     * De klasse komt pas op <html> te staan als dit script draait. Zo blijft
     * alles zichtbaar bij bezoekers zonder JavaScript — die zien dan gewoon
     * een gewone pagina in plaats van een lege.
     */
    /**
     * De zwevende WhatsApp-knop pas tonen zodra de hero uit beeld is.
     * Anders staat "Stuur foto dashboard" twee keer vlak onder elkaar op het
     * eerste scherm. Is er geen hero, dan staat hij er meteen.
     */
    const zwevend = document.querySelector('.wa-zwevend');
    const hero = document.querySelector('.hero');
    if (zwevend) {
      if (!hero || !('IntersectionObserver' in window)) {
        zwevend.classList.add('aan');
      } else {
        new IntersectionObserver(
          ([item]) => zwevend.classList.toggle('aan', !item.isIntersecting),
          { threshold: 0 }
        ).observe(hero);
      }
    }

    const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const doelen = document.querySelectorAll(
      'section > .wrap > *, .hero .wrap > *, .card, .step'
    );

    if (!stil && 'IntersectionObserver' in window && doelen.length) {
      document.documentElement.classList.add('js-reveal');
      doelen.forEach((el, i) => {
        el.setAttribute('data-reveal', '');
        // Elementen naast elkaar komen kort na elkaar in beeld, niet tegelijk.
        el.style.transitionDelay = `${Math.min(i % 6, 5) * 70}ms`;
      });

      const kijker = new IntersectionObserver(
        (items) => {
          items.forEach((it) => {
            if (!it.isIntersecting) return;
            it.target.classList.add('in');
            kijker.unobserve(it.target);
          });
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
      );

      doelen.forEach((el) => kijker.observe(el));
    }
  </script>

  <footer class="site">
    <div class="wrap">
      <div>
        <Logo height={34} class="footer-logo" />
        <strong>{SITE.name}</strong><br />
        {SITE.street}<br />
        {SITE.postalCode} {SITE.city}<br />
        {T.voettekst.opAfspraak}<br />
        <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a><br />
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      <div>
        <a href={whatsappLink(berichtOverAuto(null, taal), taal)}>{T.voettekst.appDashboard}</a><br />
        <a href={pad(padVan('prijzen', taal))}>{T.voettekst.upgrades}</a><br />
        <a href={pad(padVan('vragen', taal))}>{T.voettekst.vragen}</a><br />
        <a href={pad(padVan('over', taal))}>{T.voettekst.over}</a><br />
        {/* De modellenlijst bestaat alleen in het Nederlands: de kenteken-check
            erop werkt met de open data van de RDW en kent geen Duitse platen. */}
        {taal === STANDAARDTAAL && (
          <><a href={pad("/audio-upgrade")}>{T.voettekst.modellen}</a><br /></>
        )}
        <a href={pad(padVan('oldtimer', taal))}>{T.voettekst.klassiekers}</a>
      </div>
      <div class="legal">
        {/* De juridische teksten staan alleen in het Nederlands, en dat blijft
            zo: het zijn de voorwaarden waar je aan vastzit. Een vertaling die
            net iets anders zegt is juridisch gevaarlijker dan geen vertaling. */}
        <a href={pad("/algemene-voorwaarden")} hreflang="nl" lang="nl">{T.voettekst.voorwaarden}</a><br />
        <a href={pad("/privacybeleid")} hreflang="nl" lang="nl">{T.voettekst.privacy}</a><br />
        <a href={pad("/cookiebeleid")} hreflang="nl" lang="nl">{T.voettekst.cookies}</a><br />
        <span class="legal-klein">
          KVK: {SITE.kvk} · Btw: {SITE.btw}<br />
          © {new Date().getFullYear()} {SITE.name}
        </span>
      </div>
    </div>
  </footer>

  {/* Helemaal onderaan, zodat het nooit in de weg zit bij het laden. */}
  {meten && (
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${METEN_TOKEN}"}`}
    ></script>
  )}
</body>
</html>
