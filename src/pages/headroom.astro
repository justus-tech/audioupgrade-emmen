<div class="wb-print" id="wb-print" aria-hidden="true"></div>

{/* De belangrijkste knop staat altijd binnen duimbereik. */}
<div class="wb-balk">
  <div class="wb-balk-som">
    <span>Totaal</span>
    <strong id="wb-totaal">€ 0,00</strong>
  </div>
  <button type="button" class="btn solid" id="wb-pdf">Pdf &amp; versturen</button>
</div>

<script>
  import { PACKAGES, SITE } from '../data/site.js';
  /* De achtergrondkleur gaat mee naar Google, zodat het venster niet als een
     wit vlak in een donkere app staat. Uit brand.js, niet met de hand. */
  import { BRAND } from '../data/brand.js';
  import { APP, TABBLADEN } from '../data/app.js';
  import {
    SOORTEN, STANDAARD_INSTELLINGEN, euro, naarCent, regelPrijs, totalen, marge,
    offertenummer, geldigTot, stuklijst, aanbetaling, eindafrekening,
    factuurnummer, kortingNaarExcl, datumNl, soortenIn,
  } from '../lib/headroom/rekenen.js';
  import { offertePdf, pdfBestandsnaam } from '../lib/headroom/offerte-pdf.js';
  import { werkbonPdf, werkbonBestandsnaam } from '../lib/headroom/werkbon.js';
  import { factuurPdf, factuurBestandsnaam } from '../lib/headroom/factuur.js';
  import {
    DOSSIER_VELDEN, autoSleutel, sleutelUitNaam, sleutelsVoor, zoekDossier,
    dossierNaam, dossierStand, leegDossier, autoNaam,
  } from '../lib/headroom/autos.js';
  import {
    agenda, agendaItem, icsVoorKlus, icsBestandsnaam, hoeLangNog, googleLinksVoorKlus,
    googleEmbedUrl,
  } from '../lib/headroom/agenda.js';
  import { voorbereidingMetWaarom, voorbereiding } from '../lib/headroom/voorbereiding.js';
  import {
    rapport, periodes, soortNaam, rapportPdf, rapportBestandsnaam,
  } from '../lib/headroom/rapport.js';
  import {
    bevestiging, icsLuistersessie, luistersessieBestandsnaam, luistersessieItems,
    whatsappBericht, datumVoluit, googleLinkLuistersessie,
  } from '../lib/headroom/luistersessie.js';
  import {
    RAPPORT_SOORTEN, ACCU_METINGEN, NAZORG_VELDEN, KORTE_PUNTEN,
    leegRapport, rapportnummer, rapportenVoor, ontbreekt, meetrapportHtml,
  } from '../lib/headroom/meetrapport.js';
  import { MODELS } from '../data/models.js';
  /* Dezelfde schrijfwijze als de site: de RDW levert "GOLF VII 1.4 TSI" en dat
     moet "Golf VII 1.4 TSI" worden, niet "Golf Vii 1.4 Tsi". */
  import { kapitaliseer } from '../lib/match.js';

  const $ = (kies) => document.querySelector(kies);
  const $$ = (kies) => [...document.querySelectorAll(kies)];

  /* ================= OPSLAG =================
     Alles in één sleutel, zodat "bewaar als bestand" in één keer alles
     meeneemt en er niets half overblijft bij het terugzetten. */
  /* Deze naam verandert NIET mee met de naam van de app. Zie de
     waarschuwing in src/data/app.js. */
  const SLEUTEL = APP.opslagSleutel;

  /**
   * Offertes uit de opslag of uit een reservekopie een kenmerk geven.
   *
   * Alles van vóór deze versie heeft er nog geen. Zonder kenmerk valt een
   * offerte terug op zijn nummer, en dat is precies wat er misging.
   */
  const metKenmerk = (lijst) =>
    (Array.isArray(lijst) ? lijst : []).map((o, i) =>
      (o && o.id ? o : { ...o, id: `oud-${o?.nummer || 'x'}-${i}` }));

  const leegteStaat = () => ({
    instellingen: { ...STANDAARD_INSTELLINGEN },
    catalogus: [],
    offertes: [],
    /* Wat er per automodel is nagemeten. Zie src/lib/headroom/autos.js. */
    dossiers: [],
    /* Luistersessies: afspraken die aan een offerte voorafgaan. */
    sessies: [],
    /* De offerte waar je nu aan werkt en die je nog niet hebt bewaard. */
    concept: null,
    /* Het meetrapport waar je aan werkt, zonder de schermafbeeldingen. */
    meting: null,
  });

  function laden() {
    try {
      const rauw = localStorage.getItem(SLEUTEL);
      if (!rauw) return leegteStaat();
      const gelezen = JSON.parse(rauw);
      return {
        instellingen: { ...STANDAARD_INSTELLINGEN, ...(gelezen.instellingen || {}) },
        catalogus: Array.isArray(gelezen.catalogus) ? gelezen.catalogus : [],
        offertes: metKenmerk(gelezen.offertes),
        /* Opslag van vóór de autodossiers heeft dit veld nog niet. */
        dossiers: Array.isArray(gelezen.dossiers) ? gelezen.dossiers : [],
        /* En van vóór de luistersessies dit veld niet. */
        sessies: Array.isArray(gelezen.sessies) ? gelezen.sessies : [],
        concept: gelezen.concept || null,
        /* Opslag van vóór het meetrapport heeft dit veld nog niet. */
        meting: gelezen.meting || null,
      };
    } catch (e) {
      /* Kapotte of geblokkeerde opslag mag de app niet stilzetten. */
      return leegteStaat();
    }
  }

  function opslaan() {
    try {
      localStorage.setItem(SLEUTEL, JSON.stringify(staat));
    } catch (e) {
      melden('Opslaan lukt niet — staat je browser in privémodus?');
    }
  }

  let staat = laden();

  /* ================= DE OFFERTE DIE JE NU MAAKT ================= */
  /* Een kenmerk dat nergens anders voorkomt. Staat hierboven omdat een
     nieuwe offerte er meteen een krijgt. */
  const eigenId = () => `r${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`;

  /**
   * Het eerstvolgende nummer dat nog niet vergeven is.
   *
   * De teller uit Instellingen is het uitgangspunt, maar een nummer dat al in
   * je lijst staat wordt overgeslagen. Anders krijgt de tweede offerte van
   * vandaag hetzelfde nummer als de eerste — en met twee keer 2026-014 in je
   * boekhouding kun je niets.
   */
  function vrijNummer() {
    let n = Math.max(1, Math.round(Number(staat.instellingen.volgnummer) || 1));
    const bezet = new Set(staat.offertes.map((o) => o.nummer));
    while (bezet.has(offertenummer(n))) n += 1;
    return { n, nummer: offertenummer(n) };
  }

  const nieuweOfferte = () => ({
    /* Een eigen kenmerk dat je nergens ziet. Het zichtbare offertenummer is
       niet geschikt om offertes uit elkaar te houden: dat wordt pas vastgelegd
       als je bewaart, en tot dat moment dragen twee nieuwe offertes hetzelfde
       nummer. Op nummer bijwerken overschreef daardoor de vorige klant. */
    id: eigenId(),
    nummer: vrijNummer().nummer,
    datum: new Date(),
    zakelijk: false,
    klant: {},
    auto: {},
    regels: [],
    opmerking: '',
    /* De afspraken die anders per WhatsApp gingen. Standaard aan: verreweg de
       meeste offertes gaan via WhatsApp de deur uit, en dat is een afspraak op
       afstand. `startDirect` staat uit, want dat moet de klant zelf vragen. */
    opAfstand: true,
    startDirect: false,
    voorwaardenBijlage: true,
    /* De afspraak. Leeg tot Justus een dag prikt; dan komt de klus in de
       Agenda te staan en rekent de app de besteldatum uit. */
    inbouwdatum: '',
    inbouwtijd: '09:00',
    besteld: false,
    /* Welke voorbereidingsstappen al afgevinkt zijn, op tekst en niet op
       nummer: pas ik de lijst ooit aan, dan blijven de vinkjes kloppen. */
    afgevinkt: [],
  });

  let offerte = nieuweOfferte();
  let voorkeuren = new Set();
  let bewerktOnderdeel = null;

  const melden = (tekst) => { $('#wb-auto-melding').textContent = tekst; };

  /** "1 onderdeel", "3 onderdelen" — geen "1 onderdelen". */
  const telling = (n, enkel, meer) => `${n} ${n === 1 ? enkel : meer}`;

  /**
   * Een ingetikt bedrag, nooit onder nul.
   *
   * De rekensom negeerde een negatieve inkoopprijs al, maar hij bleef wél zo
   * in je lijst staan. Dan zie je "-€ 50,00" bij een onderdeel terwijl de app
   * met nul rekent, en snap je je marge niet meer. Een min is altijd een
   * typefout; korting geef je met het kortingsveld.
   */
  const bedragIn = (waarde) => Math.max(0, naarCent(waarde));

  /** Een ingetikt aantal uren, nooit onder nul. */
  const urenIn = (waarde) => Math.max(0, Number(String(waarde).replace(',', '.')) || 0);

  /* ================= TABBLADEN ================= */
  /**
   * Eén tabblad tonen.
   *
   * Het adres verandert mee: /headroom?tab=agenda. Daarmee kun je vanaf je
   * beginscherm rechtstreeks in de agenda springen, en doet de terugknop van
   * je telefoon wat je verwacht in plaats van de app af te sluiten.
   */
  function toonTab(naam, { inGeschiedenis = false } = {}) {
    const bestaat = $$('.wb-tab').some((k) => k.dataset.tab === naam);
    const doel = bestaat ? naam : 'offerte';
    $$('.wb-tab').forEach((k) => k.classList.toggle('aan', k.dataset.tab === doel));
    $$('.wb-paneel').forEach((p) => { p.hidden = p.dataset.paneel !== doel; });
    window.scrollTo({ top: 0 });

    const adres = `${location.pathname}?tab=${doel}`;
    if (inGeschiedenis) history.pushState({ tab: doel }, '', adres);
    else history.replaceState({ tab: doel }, '', adres);
  }

  $$('.wb-tab').forEach((knop) => {
    knop.addEventListener('click', () => toonTab(knop.dataset.tab, { inGeschiedenis: true }));
  });

  /* De terugknop van de telefoon zet je een tabblad terug. */
  window.addEventListener('popstate', (e) => {
    toonTab(e.state?.tab || new URLSearchParams(location.search).get('tab') || 'offerte');
  });

  /* ================= KENTEKEN ================= */
  $('#wb-kenteken-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const plaat = $('#wb-kenteken').value.toUpperCase().replace(/[^A-Z0-9]/g, '');
    if (!/^[A-Z0-9]{6}$/.test(plaat)) {
      melden('Een Nederlands kenteken heeft zes tekens.');
      return;
    }
    melden('Even kijken…');
    try {
      const antwoord = await fetch(
        `https://opendata.rdw.nl/resource/m9d7-ebf2.json?kenteken=${plaat}`
      );
      const gegevens = await antwoord.json();
      if (!gegevens.length) {
        metDeHand(plaat, 'Niet gevonden bij de RDW. Vul hem hieronder met de hand in.');
        return;
      }
      const auto = gegevens[0];
      /* De RDW schrijft de datum als 20180417. De eerste vier tekens zijn
         het jaar, en dat is het enige wat wij ervan nodig hebben. */
      const jaar = String(auto.datum_eerste_toelating || '').slice(0, 4);
      offerte.auto = {
        kenteken: plaat,
        merk: kapitaliseer(auto.merk),
        model: kapitaliseer(auto.handelsbenaming),
        bouwjaar: jaar,
        kleur: kapitaliseer(auto.eerste_kleur).toLowerCase(),
      };
      vulAutoVelden();
      toonAutoVelden(true);
      /* Niet elke auto heeft een handelsbenaming bij de RDW staan. Zonder deze
         controle stond er "Gevonden: Volkswagen  (2016)." met een gat erin, en
         werd er niet bij gezegd dat het model nog ontbreekt — terwijl daar het
         autodossier op hangt. */
      const naam = autoNaam(offerte.auto.merk, offerte.auto.model);
      melden(offerte.auto.model
        ? `Gevonden: ${naam} (${jaar}).`
        : `Gevonden: ${naam} (${jaar}). Het model staat niet bij de RDW — vul het hieronder aan.`);
      /* Nu pas weten we welke auto het is, dus nu pas kan de app zeggen of er
         over dit model iets is vastgelegd. Zonder deze regel bleef daar
         "vul eerst een kenteken in" staan. */
      tekenAlles();
    } catch (err) {
      metDeHand(plaat, 'De RDW is even niet bereikbaar. Vul de auto met de hand in.');
    }
  });

  /**
   * Geen auto gevonden: terug naar met de hand invullen.
   *
   * Hier ging het twee keer mis. Bij een storing werd alleen `offerte.auto`
   * vervangen — de velden op het scherm bleven de vórige auto tonen, en het
   * scherm werd niet opnieuw getekend, dus het weggeschreven concept hield
   * ook nog het oude kenteken vast. Je zag dan auto A staan terwijl er auto B
   * in zat, en na een herstart kwam A weer terug.
   */
  function metDeHand(plaat, bericht) {
    offerte.auto = { kenteken: plaat };
    vulAutoVelden();
    toonAutoVelden(true);
    melden(bericht);
    tekenAlles();
  }

  const toonAutoVelden = (aan) => { $('#wb-auto-velden').hidden = !aan; };

  function vulAutoVelden() {
    $('#wb-merk').value = offerte.auto.merk || '';
    $('#wb-model').value = offerte.auto.model || '';
    $('#wb-bouwjaar').value = offerte.auto.bouwjaar || '';
  }

  $('#wb-auto-handmatig').addEventListener('click', () => toonAutoVelden(true));
  ['merk', 'model', 'bouwjaar'].forEach((veld) => {
    $(`#wb-${veld}`).addEventListener('input', (e) => {
      offerte.auto[veld] = e.target.value;
    });
    /* Pas als je klaar bent met typen kijken we of er een dossier bij hoort.
       Bij elke toetsaanslag zou de melding staan te knipperen. */
    $(`#wb-${veld}`).addEventListener('change', tekenDossierMelding);
  });
  $('#wb-kenteken').addEventListener('input', (e) => {
    offerte.auto.kenteken = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
  });

  /* ================= KLANT ================= */
  /* [data-klant] en niet .wb-keuze: die klasse zit ook op de drie
     factuurknoppen. Met .wb-keuze sprong de klant terug naar particulier
     zodra je op 'Eindfactuur' tikte, en verdween het veld voor de
     bedrijfsnaam. */
  $$('[data-klant]').forEach((knop) => {
    knop.addEventListener('click', () => {
      offerte.zakelijk = knop.dataset.klant === 'zakelijk';
      $$('[data-klant]').forEach((k) => k.classList.toggle('aan', k === knop));
      /* De korting is ingetikt in de maat van de klant. Wissel je van
         particulier naar zakelijk, dan verandert die maat en moet hij
         opnieuw gelezen worden. */
      leesKorting();
      $('#wb-bedrijf-veld').hidden = !offerte.zakelijk;
      tekenAlles();
    });
  });

  const klantVelden = {
    naam: 'naam', adres: 'adres', telefoon: 'telefoon', email: 'email', bedrijf: 'bedrijf',
  };
  Object.entries(klantVelden).forEach(([sleutel, id]) => {
    $(`#wb-${id}`).addEventListener('input', (e) => { offerte.klant[sleutel] = e.target.value; });
    /* Bij het verlaten van het veld pas wegschrijven: bij elke toetsaanslag de
       hele opslag opnieuw wegzetten maakt het typen stroperig. */
    $(`#wb-${id}`).addEventListener('change', bewaarConcept);
  });
  $('#wb-opmerking').addEventListener('input', (e) => { offerte.opmerking = e.target.value; });
  $('#wb-opmerking').addEventListener('change', bewaarConcept);

  /* ================= DE AFSPRAAK EN DE AGENDA ================= */
  ['inbouwdatum', 'inbouwtijd'].forEach((veld) => {
    $(`#wb-${veld}`).addEventListener('change', (e) => {
      offerte[veld] = e.target.value;
      /* Staat deze offerte al in de lijst, werk hem dan meteen bij: anders
         zie je je eigen datum niet terug in de agenda. */
      if (staat.offertes.some((o) => o.nummer === offerte.nummer)) {
        bewaarOfferte();
        opslaan();
      }
      tekenAfspraak();
      tekenOpgeslagen();
    });
  });

  /** De regel onder de datum: wanneer moet er besteld zijn, en mag dat al. */
  function tekenAfspraak() {
    const vak = $('#wb-afspraak-uitleg');
    const item = agendaItem(offerte, staat.instellingen);
    if (!item) { vak.innerHTML = ''; return; }

    const bewaard = staat.offertes.some((o) => o.nummer === offerte.nummer);
    vak.innerHTML =
      `<div class="wb-cijfers">` +
      `<div><span>Inbouw</span><strong>${datumNl(item.datum)}</strong>` +
      `<em>${item.hoeLang}</em></div>` +
      `<div><span>Uiterlijk bestellen</span><strong>${datumNl(item.besteldag)}</strong>` +
      `<em>${hoeLangNog(item.bestelDagenTot)}</em></div>` +
      `</div>` +
      (item.aanbetaald
        ? ''
        : `<p class="wb-uitleg">Bestel pas als de aanbetaling binnen is. Zet de status
           van deze offerte op <strong>aanbetaald</strong> zodra het geld er is.</p>`) +
      (bewaard
        ? ''
        : `<p class="wb-waarschuwing">Deze offerte staat nog niet in je Agenda.
           Tik onderaan op <strong>Offerte bewaren</strong>.</p>`);
  }

  /** De offerte in de lijst, of de offerte die nu open staat. */
  const offerteVan = (nummer) =>
    staat.offertes.find((o) => o.nummer === nummer) ||
    (offerte.nummer === nummer ? offerte : null);

  /**
   * Iets wijzigen aan een bewaarde offerte — op BEIDE plekken.
   *
   * Een offerte staat op twee plekken zolang hij openstaat: in de lijst en in
   * het formulier. Werk je er maar één bij, dan overschrijft de volgende
   * bewaaractie hem met de oude waarde. Zo raakte de status "aanbetaald"
   * kwijt zodra je daarna de inbouwdatum verzette.
   */
  function werkBij(nummer, veranderingen) {
    const bewaard = staat.offertes.find((o) => o.nummer === nummer);
    if (bewaard) Object.assign(bewaard, veranderingen);
    if (offerte.nummer === nummer) Object.assign(offerte, veranderingen);
    opslaan();
  }

  const LABELS = {
    wacht: 'wacht op aanbetaling',
    nu: 'nu bestellen',
    straks: 'nog even tijd',
    'te-laat': 'te laat — geen aanbetaling',
    gedaan: 'geregeld',
  };

  /**
   * Je Google-agenda in een venstertje op het tabblad Agenda.
   *
   * Kijken, geen koppeling: de browser houdt twee sites uit elkaar, dus de
   * app kan niet lezen wat erin staat. Voor inplannen is dat genoeg — je ziet
   * in één scherm of een dag al vol staat.
   *
   * Het venster wordt pas aangemaakt als er een adres staat. Een leeg
   * venstertje van Google op je scherm is alleen maar in de weg.
   */
  function tekenGoogleAgenda() {
    const vak = $('#wb-google-venster');
    const url = googleEmbedUrl(staat.instellingen.googleAgenda, { achtergrond: BRAND.bg });

    if (!url) {
      vak.innerHTML =
        `<p class="wb-uitleg">Plak bij <strong>Instellingen</strong> het adres van je
         Google-agenda, dan staat hij hier. Zo zie je meteen of een dag al vol zit
         voordat je iets afspreekt.</p>` +
        (String(staat.instellingen.googleAgenda || '').trim()
          ? `<p class="wb-waarschuwing">Wat er nu staat herken ik niet als een agenda
             van Google. Plak je e-mailadres, of de hele link die onder
             <em>Agenda integreren</em> staat.</p>`
          : '');
      return;
    }

    /* Alleen opnieuw aanmaken als het adres écht veranderd is: anders laadt
       het venster bij elke tekenronde opnieuw en zie je hem knipperen. */
    const bestaand = vak.querySelector('iframe');
    if (bestaand && bestaand.src === url) return;

    vak.innerHTML = '';
    const venster = document.createElement('iframe');
    venster.className = 'wb-google-agenda';
    venster.src = url;
    venster.loading = 'lazy';
    venster.title = 'Je Google-agenda';
    /* Dit venster hoort niets met de app te kunnen. */
    venster.referrerPolicy = 'no-referrer';
    vak.appendChild(venster);
  }

  function tekenAgenda() {
    const klussen = agenda(staat.offertes, staat.instellingen);
    const sessies = luistersessieItems(staat.sessies);
    /* Eén agenda, niet twee: een inbouw en een luistersessie staan door
       elkaar op datum, want zo staan ze ook in je dag. */
    const items = [...klussen, ...sessies].sort((a, b) => a.datum - b.datum);
    const komend = items.filter((i) => i.dagen >= 0);
    $('#wb-agenda-leeg').hidden = items.length > 0;

    /* Bovenaan alleen wat vandaag aandacht vraagt. Staat er niets, dan staat
       er ook niets — een leeg vak met "niets te doen" is ruis. */
    const bestellen = komend.filter((i) => i.bestellen === 'nu' || i.bestellen === 'te-laat');
    /* Alles wat vandaag of morgen op de stoep staat, inbouw én luistersessie.
       Een luistersessie is zo gebeurd dat je hem vergeet; juist daarom. */
    const opKorteTermijn = komend.filter((i) => i.dagen <= 1);
    const dringend = [...bestellen, ...opKorteTermijn.filter((i) => !bestellen.includes(i))];

    const bel = $('#wb-agenda-bel');
    bel.hidden = dringend.length === 0;
    bel.textContent = dringend.length || '';

    /* De zinnen aan elkaar geplakt en niet over meerdere regels uitgesmeerd:
       een regeleinde midden in een zin blijft in de tekst staan, en dan staat
       er bij het kopiëren "morgen om" met een enter erachter. */
    const zin = (i) => {
      if (i.soort === 'luistersessie') {
        return `<strong>Luistersessie met ${ontsnap(i.wie)}</strong>` +
          ` — ${i.hoeLang} om ${ontsnap(i.tijd)}.` +
          ' Hek openzetten of bij de telefoon blijven.';
      }
      if (i.dagen <= 1 && i.bestellen !== 'nu' && i.bestellen !== 'te-laat') {
        return `<strong>Inbouw ${ontsnap(i.wie)}</strong>` +
          ` — ${i.hoeLang} om ${ontsnap(i.tijd)}.` +
          ' Loop het lijstje van vandaag na.';
      }
      if (i.bestellen === 'nu') {
        return `<strong>Bestellen voor ${ontsnap(i.wie)}</strong>` +
          ` — inbouw ${datumNl(i.datum)}, ${i.hoeLang}.`;
      }
      return `<strong>${ontsnap(i.wie)}</strong>` +
        `: de besteldag is ${hoeLangNog(i.bestelDagenTot)} en de aanbetaling is nog niet binnen.` +
        ' Bel of app de klant.';
    };

    $('#wb-agenda-nu').innerHTML = dringend.length
      ? `<div class="wb-kaart wb-dringend"><span class="eyebrow">Nu doen</span>` +
        dringend.map((i) => `<p>${zin(i)}</p>`).join('') +
        `</div>`
      : '';

    const vak = $('#wb-agenda-lijst');
    vak.innerHTML = '';
    /* Wat geweest is onderaan en ingeklapt: je kijkt vooruit, niet terug. */
    for (const item of [...komend, ...items.filter((i) => i.dagen < 0).reverse()]) {
      vak.appendChild(item.soort === 'luistersessie' ? sessieKaart(item) : agendaKaart(item));
    }
  }

  /** Eén klus in de agenda, met de twee lijstjes eronder. */
  function agendaKaart(item) {
    const bron = offerteVan(item.nummer);
    const v = voorbereidingMetWaarom(bron || {});
    const afgevinkt = new Set(bron?.afgevinkt || []);

    const kaart = document.createElement('div');
    kaart.className = `wb-kaart wb-klus${item.dagen < 0 ? ' wb-geweest' : ''}`;
    kaart.innerHTML = `
      <div class="wb-regel-kop">
        <span><strong>${datumNl(item.datum)} · ${ontsnap(item.tijd)}</strong>
          <small>${ontsnap(item.wie)} — ${ontsnap(item.auto || 'auto onbekend')}</small>
        </span>
        <em class="wb-wanneer">${item.hoeLang}</em>
      </div>
      <div class="wb-bestel wb-${item.bestellen}">
        <span>Uiterlijk bestellen</span>
        <strong>${datumNl(item.besteldag)}</strong>
        <em>${LABELS[item.bestellen]}</em>
      </div>
      <div class="wb-regel-rij">
        <button type="button" class="btn wb-ics">Agendabestand</button>
        <button type="button" class="btn wb-google">In Google Agenda</button>
        <button type="button" class="wb-link wb-open">Offerte openen</button>
      </div>
      <label class="wb-vink wb-besteld">
        <input type="checkbox"${bron?.besteld ? ' checked' : ''} />
        <span>De onderdelen zijn besteld
          <em>Daarna houdt deze klus op je eraan te herinneren.</em>
        </span>
      </label>`;

    for (const [wanneer, titel] of [['week', 'Een week van tevoren'], ['dag', 'De dag ervoor']]) {
      const blok = document.createElement('div');
      blok.className = 'wb-voorbereiding';
      blok.innerHTML = `<span class="eyebrow">${titel}</span>`;
      for (const stap of v[wanneer]) {
        const regel = document.createElement('label');
        regel.className = 'wb-vink';
        regel.innerHTML =
          `<input type="checkbox"${afgevinkt.has(stap.tekst) ? ' checked' : ''} />` +
          `<span>${ontsnap(stap.tekst)}` +
          (stap.waarom ? `<em>${ontsnap(stap.waarom)}</em>` : '') +
          `</span>`;
        regel.querySelector('input').addEventListener('change', (e) => {
          const lijst = new Set(offerteVan(item.nummer)?.afgevinkt || []);
          if (e.target.checked) lijst.add(stap.tekst);
          else lijst.delete(stap.tekst);
          werkBij(item.nummer, { afgevinkt: [...lijst] });
        });
        blok.appendChild(regel);
      }
      kaart.appendChild(blok);
    }

    kaart.querySelector('.wb-besteld input').addEventListener('change', (e) => {
      werkBij(item.nummer, { besteld: e.target.checked });
      tekenOpgeslagen();
    });

    /* Twee afspraken, dus twee vensters. Google kent geen link die er twee
       tegelijk aanmaakt; dit is de kortste weg die er wel is. */
    kaart.querySelector('.wb-google').addEventListener('click', () => {
      const links = googleLinksVoorKlus(item, { voorbereiding: voorbereiding(bron || {}) });
      window.open(links.inbouw.url, '_blank', 'noopener');
      if (item.bestellen !== 'gedaan') {
        window.open(links.bestellen.url, '_blank', 'noopener');
      }
    });

    kaart.querySelector('.wb-ics').addEventListener('click', () => {
      const ics = icsVoorKlus(item, { voorbereiding: voorbereiding(bron || {}) });
      const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
      const adres = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = adres;
      link.download = icsBestandsnaam(item);
      link.click();
      URL.revokeObjectURL(adres);
    });

    kaart.querySelector('.wb-open').addEventListener('click', () => {
      const eerder = staat.offertes.find((o) => o.nummer === item.nummer);
      if (!eerder) return;
      offerte = { ...eerder, datum: new Date(eerder.datum) };
      vulFormulierUitOfferte();
      tekenAlles();
      toonTab('offerte', { inGeschiedenis: true });
    });

    return kaart;
  }

  /* ================= LUISTERSESSIE ================= */
  const LS_VELDEN = ['voornaam', 'kenteken', 'datum', 'tijd', 'duur', 'telefoon'];

  /** Wat er nu in het formulier staat. */
  function sessieUitFormulier() {
    return {
      voornaam: $('#wb-ls-voornaam').value.trim(),
      kenteken: $('#wb-ls-kenteken').value.trim(),
      datum: $('#wb-ls-datum').value,
      tijd: $('#wb-ls-tijd').value || '10:00',
      duurMinuten: Number($('#wb-ls-duur').value) || 45,
      telefoon: $('#wb-ls-telefoon').value.trim(),
    };
  }

  /* Het bericht opnieuw opstellen zodra er iets verandert. Dat overschrijft
     wat Justus zelf heeft bijgetypt — daarom staat dat er ook bij. */
  function tekenBericht() {
    $('#wb-ls-bericht').value = bevestiging(sessieUitFormulier());
  }

  LS_VELDEN.forEach((veld) => {
    $(`#wb-ls-${veld}`).addEventListener('input', tekenBericht);
    $(`#wb-ls-${veld}`).addEventListener('change', tekenBericht);
  });

  const lsMelden = (tekst, waarschuwing = false) => {
    $('#wb-ls-melding').innerHTML = tekst
      ? `<p class="${waarschuwing ? 'wb-waarschuwing' : 'wb-uitleg'}">${ontsnap(tekst)}</p>`
      : '';
  };

  /** Ontbreekt er iets waardoor het bericht onaf is? */
  function sessieCompleet(sessie) {
    if (!sessie.datum) return 'Zet er eerst een datum bij.';
    if (!sessie.voornaam) return 'Zonder voornaam is het een bericht aan niemand.';
    return '';
  }

  $('#wb-ls-whatsapp').addEventListener('click', () => {
    const sessie = sessieUitFormulier();
    const mis = sessieCompleet(sessie);
    if (mis) { lsMelden(mis, true); return; }
    lsMelden('');
    /* De tekst uit het veld en niet opnieuw opgesteld: heeft Justus er iets
       bij getypt, dan gaat dát mee. */
    window.open(whatsappBericht($('#wb-ls-bericht').value, sessie.telefoon), '_blank');
  });

  const bewaarBestand = (inhoud, naam, soort) => {
    const adres = URL.createObjectURL(new Blob([inhoud], { type: soort }));
    const link = document.createElement('a');
    link.href = adres;
    link.download = naam;
    link.click();
    URL.revokeObjectURL(adres);
  };

  $('#wb-ls-ics').addEventListener('click', () => {
    const sessie = sessieUitFormulier();
    const mis = sessieCompleet(sessie);
    if (mis) { lsMelden(mis, true); return; }
    lsMelden('Stuur dit bestand mee met je bericht, dan zet de klant de afspraak in één tik in zijn agenda.');
    bewaarBestand(icsLuistersessie(sessie), luistersessieBestandsnaam(sessie), 'text/calendar;charset=utf-8');
  });

  $('#wb-ls-google').addEventListener('click', () => {
    const sessie = sessieUitFormulier();
    const mis = sessieCompleet(sessie);
    if (mis) { lsMelden(mis, true); return; }
    lsMelden('Google Agenda opent met de afspraak erin. Controleer hem en druk op Opslaan.');
    window.open(googleLinkLuistersessie(sessie), '_blank', 'noopener');
  });

  $('#wb-ls-bewaar').addEventListener('click', () => {
    const sessie = sessieUitFormulier();
    const mis = sessieCompleet(sessie);
    if (mis) { lsMelden(mis, true); return; }
    staat.sessies.unshift({ id: eigenId(), ...sessie });
    staat.sessies = staat.sessies.slice(0, 200);
    opslaan();
    lsMelden(`Genoteerd: ${sessie.voornaam} op ${datumVoluit(sessie.datum)}.`);
    tekenOpgeslagen();
  });

  /** Een bewaarde luistersessie in de agenda. */
  function sessieKaart(item) {
    const kaart = document.createElement('div');
    kaart.className = `wb-kaart wb-klus${item.dagen < 0 ? ' wb-geweest' : ''}`;
    kaart.innerHTML = `
      <div class="wb-regel-kop">
        <span><strong>${datumNl(item.datum)} · ${ontsnap(item.tijd)}</strong>
          <small>Luistersessie — ${ontsnap(item.wie)}${
            item.kenteken ? ` · ${ontsnap(item.kenteken)}` : ''}</small>
        </span>
        <em class="wb-wanneer">${item.hoeLang}</em>
      </div>
      <div class="wb-regel-rij">
        <button type="button" class="btn wb-ls-ics2">Agendabestand</button>
        <button type="button" class="btn wb-ls-google">In Google Agenda</button>
        <button type="button" class="wb-link wb-ls-weg">Weghalen</button>
      </div>
      <div class="wb-regel-rij">
        <button type="button" class="wb-link wb-ls-opnieuw">Bericht opnieuw sturen</button>
      </div>`;

    kaart.querySelector('.wb-ls-google').addEventListener('click', () => {
      window.open(googleLinkLuistersessie(item), '_blank', 'noopener');
    });
    kaart.querySelector('.wb-ls-ics2').addEventListener('click', () => {
      bewaarBestand(
        icsLuistersessie(item), luistersessieBestandsnaam(item), 'text/calendar;charset=utf-8'
      );
    });
    kaart.querySelector('.wb-ls-opnieuw').addEventListener('click', () => {
      window.open(whatsappBericht(bevestiging(item), item.telefoon), '_blank');
    });
    kaart.querySelector('.wb-ls-weg').addEventListener('click', () => {
      if (!confirm(`Luistersessie van ${item.wie} weghalen?`)) return;
      staat.sessies = staat.sessies.filter((x) => x.id !== item.id);
      opslaan();
      tekenOpgeslagen();
    });
    return kaart;
  }

  /* ================= RAPPORT ================= */
  let gekozenPeriode = 'maand';

  const rijtje = (paren) => paren
    .map(([wat, bedrag, bij]) =>
      `<div><span>${wat}</span><strong>${bedrag}</strong>${bij ? `<em>${bij}</em>` : ''}</div>`)
    .join('');

  function tekenRapport() {
    const lijst = periodes();
    const periode = lijst.find((x) => x.id === gekozenPeriode) || lijst[0];

    /* De keuzelijst één keer vullen; daarna alleen de stand bijwerken. */
    const kies = $('#wb-r-periode');
    if (kies.options.length !== lijst.length) {
      kies.innerHTML = lijst
        .map((x) => `<option value="${x.id}">${ontsnap(x.naam)}</option>`)
        .join('');
    }
    kies.value = periode.id;

    const r = rapport(staat.offertes, staat.instellingen, periode);

    /**
     * WAT ER NOG MOET BINNENKOMEN staat bovenaan, en met opzet.
     *
     * Dit is het enige blok waar je iets mee moet. Een factuur van twee
     * maanden geleden die nooit betaald is valt in een lijst van veertig
     * offertes niet op; hier wel.
     */
    const open = r.openstaand;
    const totaalOpen = open.verstuurd.inclCent + open.aanbetaald.inclCent + open.gefactureerd.inclCent;
    $('#wb-r-openstaand').innerHTML = totaalOpen
      ? `<div class="wb-kaart${open.gefactureerd.inclCent ? ' wb-dringend' : ''}">
           <span class="eyebrow">Moet nog binnenkomen</span>
           <div class="wb-cijfers">${rijtje([
        open.gefactureerd.inclCent
          ? ['Gefactureerd, nog niet betaald', euro(open.gefactureerd.inclCent),
            `${telling(open.gefactureerd.aantal, 'factuur', 'facturen')} — hier achteraan`]
          : null,
        open.aanbetaald.inclCent
          ? ['Restant na de aanbetaling', euro(open.aanbetaald.inclCent),
            `${telling(open.aanbetaald.aantal, 'klus', 'klussen')} in de planning`]
          : null,
        open.verstuurd.inclCent
          ? ['Offertes waar nog niets op binnen is', euro(open.verstuurd.inclCent),
            telling(open.verstuurd.aantal, 'offerte', 'offertes')]
          : null,
      ].filter(Boolean))}</div>
         </div>`
      : '';

    const o = r.omzet;
    $('#wb-r-omzet').innerHTML =
      `<div class="wb-kaart">
         <span class="eyebrow">Omzet ${ontsnap(periode.kop)}</span>
         ${o.aantal
        ? `<div class="wb-cijfers">${rijtje([
          ['Omzet excl. btw', euro(o.exclCent), telling(o.aantal, 'klus', 'klussen')],
          ['Btw', euro(o.btwCent), ''],
          ['Omzet incl. btw', euro(o.inclCent), ''],
          ['Inkoop', euro(o.inkoopCent), ''],
          ['Marge', euro(o.margeCent), `${o.margePct.toFixed(1).replace('.', ',')}%`],
          ['Gemiddeld per klus', euro(o.gemiddeldInclCent), 'inclusief btw'],
          ['Montage-uren', `${String(o.uren).replace('.', ',')}`, 'uur'],
        ])}</div>`
        : `<p class="wb-leeg">Nog geen klus die is doorgegaan in deze periode.
             Een klus telt mee zodra de status op <strong>aanbetaald</strong> staat.</p>`}
       </div>`;

    $('#wb-r-soorten').innerHTML = r.perSoort.length
      ? `<div class="wb-kaart">
           <span class="eyebrow">Waar de marge vandaan komt</span>
           <div class="wb-cijfers">${rijtje(r.perSoort.map((s) => [
        ontsnap(soortNaam(s.soort)),
        euro(s.margeCent),
        `${telling(s.aantal, 'klus', 'klussen')} · omzet ${euro(s.exclCent)}`,
      ]))}</div>
           <p class="wb-uitleg">Zit er meer dan één soort werk op een offerte, dan telt
             die omzet bij allebei mee. Deze kolom telt dus niet op tot je totaal.</p>
         </div>`
      : '';

    const c = r.conversie;
    $('#wb-r-conversie').innerHTML = c.verstuurd
      ? `<div class="wb-kaart">
           <span class="eyebrow">Hoeveel gaat er door</span>
           <div class="wb-cijfers">${rijtje([
        ['Doorgegaan', `${c.doorgegaan} van ${c.verstuurd}`, `${c.pct.toFixed(0)}% van wat je verstuurde`],
        ['Gemaakt in deze periode', String(c.gemaakt), 'inclusief concepten'],
      ])}</div>
         </div>`
      : '';
  }

  $('#wb-r-periode').addEventListener('change', (e) => {
    gekozenPeriode = e.target.value;
    tekenRapport();
  });

  $('#wb-r-pdf').addEventListener('click', () => {
    const lijst = periodes();
    const periode = lijst.find((x) => x.id === gekozenPeriode) || lijst[0];
    const r = rapport(staat.offertes, staat.instellingen, periode);
    const doc = rapportPdf(r, staat.instellingen);
    bewaarBestand(doc.naarBytes(), rapportBestandsnaam(r), 'application/pdf');
  });

  /* ================= AFSPRAKEN OP PAPIER ================= */
  const AFSPRAKEN = {
    opAfstand: 'wb-op-afstand',
    startDirect: 'wb-start-direct',
    voorwaardenBijlage: 'wb-bijlage',
  };

  /**
   * De vinkjes terugzetten zoals ze bij deze offerte horen.
   *
   * Op dezelfde manier gelezen als in de pdf: ontbreekt het veld (een offerte
   * van voor deze versie), dan staat 'op afstand' en de bijlage aan en 'direct
   * beginnen' uit.
   *
   * Vraagt de klant niet om binnen de bedenktijd te beginnen, dan is dat
   * vinkje zinloos: er is dan geen bedenktijd om binnen te beginnen. Daarom
   * verdwijnt hij zodra 'op afstand' uit staat.
   */
  function tekenAfspraken() {
    $('#wb-op-afstand').checked = offerte.opAfstand !== false;
    $('#wb-start-direct').checked = !!offerte.startDirect;
    $('#wb-bijlage').checked = offerte.voorwaardenBijlage !== false;
    $('#wb-start-veld').hidden = offerte.opAfstand === false;
  }

  Object.entries(AFSPRAKEN).forEach(([sleutel, id]) => {
    $(`#${id}`).addEventListener('change', (e) => {
      offerte[sleutel] = e.target.checked;
      /* Gaat 'op afstand' uit, dan kan 'direct beginnen' niet blijven staan:
         dat zou een zin op de offerte zetten die nergens op slaat. */
      if (sleutel === 'opAfstand' && !e.target.checked) offerte.startDirect = false;
      tekenAfspraken();
    });
  });

  /* ================= VOORKEUREN ================= */
  $$('#wb-voorkeuren .wb-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const soort = chip.dataset.soort;
      if (voorkeuren.has(soort)) voorkeuren.delete(soort);
      else voorkeuren.add(soort);
      chip.classList.toggle('aan', voorkeuren.has(soort));
      tekenOnderdeelknoppen();
    });
  });

  /* ================= TOEVOEGEN ================= */
  /**
   * Welk werk zit er in een pakket van de site?
   *
   * De pakketten staan in site.js met hun inhoud, maar niet met welke
   * handelingen erbij horen. Dat staat hier, en het bepaalt welke blokken er
   * op de werkbon komen: bij de Akoestische Basis gaan de deuren open, komt
   * er demping in én komen er speakers.
   *
   * Overgenomen uit de omschrijvingen op de site. Klopt er iets niet met hoe
   * je het werkelijk doet, pas het hier aan.
   */
  const PAKKET_WERK = {
    'carplay-upgrade': ['carplay'],
    'akoestische-basis': ['speakers-voor', 'demping'],
    'oem-plus-executive': ['speakers-voor', 'demping', 'versterker', 'dsp', 'subwoofer'],
    'reference-edition': ['speakers-voor', 'speakers-achter', 'demping', 'versterker', 'dsp', 'subwoofer'],
    'competitie-show': ['speakers-voor', 'demping', 'versterker', 'dsp', 'subwoofer'],
    'akoestische-isolatie': ['demping'],
  };

  function tekenPakketknoppen() {
    const vak = $('#wb-pakketten');
    vak.innerHTML = '';
    for (const pakket of PACKAGES) {
      /* Alleen pakketten met een vast bedrag. Het showbouw-pakket heeft dat
         niet — daar hangt de prijs af van wat er getekend wordt. */
      if (!pakket.bedrag) continue;
      const knop = document.createElement('button');
      knop.type = 'button';
      knop.className = 'wb-toevoeg';
      knop.innerHTML = `<span>${pakket.name}</span><em>${euro(pakket.bedrag * 100)}</em>`;
      knop.addEventListener('click', () => {
        /* De prijzen op de site zijn inclusief btw. In de offerte rekenen we
           met bedragen exclusief; anders zou er btw over btw komen. */
        const inclCent = Math.round(pakket.bedrag * 100);
        const exclCent = Math.round(inclCent / (1 + staat.instellingen.btwPct / 100));
        offerte.regels.push({
          id: eigenId(),
          omschrijving: pakket.name,
          toelichting: pakket.short || '',
          aantal: 1,
          vastExclCent: exclCent,
          inkoopCent: 0,
          uren: 0,
          soorten: PAKKET_WERK[pakket.slug] || [],
          toebehoren: [],
        });
        tekenAlles();
      });
      vak.appendChild(knop);
    }
  }

  function tekenOnderdeelknoppen() {
    const vak = $('#wb-onderdelen');
    vak.innerHTML = '';
    const opSoort = voorkeuren.size
      ? staat.catalogus.filter((o) => voorkeuren.has(o.soort))
      : staat.catalogus;
    $('#wb-catalogus-leeg').hidden = staat.catalogus.length > 0;

    const zoek = $('#wb-onderdeel-zoek').value.trim().toLowerCase();
    $('#wb-onderdeel-zoekveld').hidden = staat.catalogus.length <= ZICHTBAAR;

    const gevonden = opSoort.filter((o) => past(o, zoek));
    const lijst = zoek ? gevonden : gevonden.slice(0, ZICHTBAAR);
    const rest = gevonden.length - lijst.length;

    const meer = $('#wb-onderdelen-meer');
    meer.hidden = !rest && !(zoek && gevonden.length);
    meer.textContent = zoek
      ? `${telling(gevonden.length, 'onderdeel', 'onderdelen')} gevonden.`
      : `Nog ${telling(rest, 'onderdeel', 'onderdelen')} meer — zoek hierboven.`;

    for (const onderdeel of lijst) {
      const prijs = regelPrijs(onderdeel, staat.instellingen);
      const knop = document.createElement('button');
      knop.type = 'button';
      knop.className = 'wb-toevoeg';
      const merk = onderdeel.merk ? `${onderdeel.merk} · ` : '';
      knop.innerHTML =
        `<span>${ontsnap(onderdeel.omschrijving)}<small>${ontsnap(merk)}${soortNaam(onderdeel.soort)}</small></span>` +
        `<em>${euro(offerte.zakelijk ? prijs.exclCent : prijs.inclCent)}</em>`;
      knop.addEventListener('click', () => {
        offerte.regels.push({ ...onderdeel, id: eigenId(), aantal: 1 });
        tekenAlles();
      });
      vak.appendChild(knop);
    }
    if (staat.catalogus.length && !lijst.length) {
      const leeg = document.createElement('p');
      leeg.className = 'wb-leeg';
      leeg.textContent = zoek
        ? 'Niets gevonden. Probeer een deel van de naam of het artikelnummer.'
        : 'Geen onderdelen in deze categorieën.';
      vak.appendChild(leeg);
    }
  }

  const soortNaam = (id) => (SOORTEN.find((s) => s.id === id) || {}).naam || 'Overig';

  /** Tekst van een gebruiker nooit rauw in de pagina zetten. */
  function ontsnap(tekst) {
    return String(tekst ?? '').replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));
  }

  $('#wb-eigen-regel').addEventListener('click', () => {
    offerte.regels.push({
      id: eigenId(), omschrijving: '', toelichting: '', aantal: 1,
      inkoopCent: 0, margePct: staat.instellingen.margePct, uren: 0, open: true,
    });
    tekenAlles();
  });

  /* ================= DE REGELS ================= */
  function tekenRegels() {
    const vak = $('#wb-regels');
    vak.innerHTML = '';
    $('#wb-regels-leeg').hidden = offerte.regels.length > 0;

    offerte.regels.forEach((regel, i) => {
      const prijs = regelPrijs(regel, staat.instellingen);
      const rij = document.createElement('div');
      rij.className = 'wb-regel';
      rij.innerHTML = `
        <div class="wb-regel-kop">
          <input type="text" class="wb-regel-naam" value="${ontsnap(regel.omschrijving)}"
                 placeholder="Omschrijving" aria-label="Omschrijving" />
          <strong>${euro(offerte.zakelijk ? prijs.exclCent : prijs.inclCent)}</strong>
        </div>
        <div class="wb-regel-rij">
          <div class="wb-aantal">
            <button type="button" class="wb-min" aria-label="Eén minder">−</button>
            <span>${prijs.aantal}</span>
            <button type="button" class="wb-plus" aria-label="Eén meer">+</button>
          </div>
          <button type="button" class="wb-link wb-open">${regel.open ? 'Verbergen' : 'Aanpassen'}</button>
          <button type="button" class="wb-link wb-weg">Weghalen</button>
        </div>
        <div class="wb-regel-detail" ${regel.open ? '' : 'hidden'}>
          <label class="wb-breed">Toelichting op de offerte
            <input type="text" class="wb-d-toelichting" value="${ontsnap(regel.toelichting || '')}" />
          </label>
          <div class="wb-veldrij">
            <label>Inkoop excl. btw
              <input type="text" class="wb-d-inkoop" inputmode="decimal"
                     value="${regel.inkoopCent ? (regel.inkoopCent / 100).toFixed(2).replace('.', ',') : ''}" />
            </label>
            <label>Marge %
              <input type="text" class="wb-d-marge" inputmode="decimal"
                     value="${regel.margePct ?? ''}" />
            </label>
            <label>Montage-uren
              <input type="text" class="wb-d-uren" inputmode="decimal" value="${regel.uren || ''}" />
            </label>
            <label>Vaste prijs excl. btw
              <input type="text" class="wb-d-vast" inputmode="decimal"
                     value="${regel.vastExclCent != null ? (regel.vastExclCent / 100).toFixed(2).replace('.', ',') : ''}"
                     placeholder="laat leeg om te rekenen" />
            </label>
          </div>
          <p class="wb-uitleg">
            Onderdeel ${euro(Math.round((regel.inkoopCent || 0) * (1 + (regel.margePct ?? staat.instellingen.margePct) / 100)))}
            + montage ${euro(Math.round((regel.uren || 0) * staat.instellingen.uurtariefCent))}
            = ${euro(prijs.perStukExcl)} excl. btw per stuk
          </p>
        </div>`;

      const zetEnTeken = (sleutel, waarde) => { regel[sleutel] = waarde; tekenAlles(); };

      rij.querySelector('.wb-regel-naam').addEventListener('input', (e) => {
        /* Niet opnieuw tekenen tijdens typen: dan springt de cursor weg. */
        regel.omschrijving = e.target.value;
        werkTotalenBij();
      });
      rij.querySelector('.wb-min').addEventListener('click', () => {
        zetEnTeken('aantal', Math.max(1, prijs.aantal - 1));
      });
      rij.querySelector('.wb-plus').addEventListener('click', () => {
        zetEnTeken('aantal', prijs.aantal + 1);
      });
      rij.querySelector('.wb-open').addEventListener('click', () => {
        zetEnTeken('open', !regel.open);
      });
      rij.querySelector('.wb-weg').addEventListener('click', () => {
        offerte.regels.splice(i, 1);
        tekenAlles();
      });
      rij.querySelector('.wb-d-toelichting').addEventListener('input', (e) => {
        regel.toelichting = e.target.value;
      });
      rij.querySelector('.wb-d-inkoop').addEventListener('change', (e) => {
        zetEnTeken('inkoopCent', bedragIn(e.target.value));
      });
      rij.querySelector('.wb-d-marge').addEventListener('change', (e) => {
        const n = Number(String(e.target.value).replace(',', '.'));
        zetEnTeken('margePct', Number.isFinite(n) && e.target.value !== '' ? n : undefined);
      });
      rij.querySelector('.wb-d-uren').addEventListener('change', (e) => {
        zetEnTeken('uren', urenIn(e.target.value));
      });
      rij.querySelector('.wb-d-vast').addEventListener('change', (e) => {
        const leeg = String(e.target.value).trim() === '';
        zetEnTeken('vastExclCent', leeg ? undefined : bedragIn(e.target.value));
      });

      vak.appendChild(rij);
    });
  }

  /* ================= TOTALEN EN MARGE ================= */
  function werkTotalenBij() {
    const korting = offerte.kortingExclCent || 0;
    const t = totalen(offerte.regels, staat.instellingen, korting);
    $('#wb-totaal').textContent = euro(offerte.zakelijk ? t.exclCent : t.inclCent);
    $('#wb-nummer').textContent = `nr. ${offerte.nummer}`;

    const m = marge(offerte.regels, staat.instellingen, korting);
    /* Een regel zonder inkoopprijs telt als gratis ingekocht en maakt de
       marge mooier dan hij is. Dat gebeurt vanzelf bij de pakketten van de
       site: die hebben wel een verkoopprijs, maar wat er aan onderdelen in
       gaat weet alleen Justus. Dus zeggen we het erbij in plaats van een
       percentage te tonen waar hij op zou gaan varen. */
    const zonderInkoop = offerte.regels.filter((r) => !r.inkoopCent).length;
    $('#wb-marge').innerHTML = `
      <div><span>Omzet excl. btw</span><strong>${euro(m.omzetCent)}</strong></div>
      <div><span>Inkoop</span><strong>${euro(m.kostprijsCent)}</strong></div>
      <div><span>Marge</span><strong>${euro(m.margeCent)}</strong></div>
      <div><span>Marge %</span><strong>${m.margePct.toFixed(1).replace('.', ',')}%</strong></div>
      <div><span>Montage</span><strong>${m.urenTotaal} uur · ${euro(m.arbeidCent)}</strong></div>` +
      (zonderInkoop
        ? `<p class="wb-waarschuwing">Let op: bij ${zonderInkoop} ${
            zonderInkoop === 1 ? 'regel staat' : 'regels staat'
          } nog geen inkoopprijs. Je marge is dus lager dan hier staat — vul hem in bij
          <strong>Aanpassen</strong>.</p>`
        : '');
  }

  /**
   * DE KORTING.
   *
   * Wat Justus intikt staat in de maat die de klant ziet — bij een particulier
   * inclusief btw. Binnen de app rekent alles exclusief, dus we bewaren de
   * omgerekende waarde op de offerte. Zo klopt de btw, de marge én de
   * aanbetaling meteen mee.
   */
  function leesKorting() {
    const kaal = totalen(offerte.regels, staat.instellingen);
    offerte.kortingExclCent = kortingNaarExcl(
      $('#wb-korting').value, kaal.exclCent, offerte.zakelijk, staat.instellingen.btwPct
    );
  }

  function tekenKorting() {
    const t = totalen(offerte.regels, staat.instellingen, offerte.kortingExclCent || 0);
    const vak = $('#wb-korting-uitleg');
    if (!t.kortingExclCent) {
      vak.innerHTML = '';
      return;
    }
    vak.innerHTML =
      `<span>De klant ziet</span><strong>-${euro(offerte.zakelijk ? t.kortingExclCent : t.kortingInclCent)}</strong>` +
      `<em>nieuw totaal ${euro(offerte.zakelijk ? t.exclCent : t.inclCent)}</em>`;
  }

  $('#wb-korting').addEventListener('input', () => {
    leesKorting();
    tekenKorting();
    werkTotalenBij();
    tekenAanbetaling();
  });

  /**
   * Het percentage dat nu in het veld staat. Leeg betekent: de standaard uit
   * de instellingen. Zo hoeft Justus het niet elke keer in te tikken, maar kan
   * hij er per klant van afwijken.
   */
  function huidigPercentage() {
    const ingetypt = $('#wb-aanbetaling-pct').value.trim();
    if (ingetypt === '') return staat.instellingen.aanbetalingPct;
    return Number(ingetypt.replace(',', '.')) || 0;
  }

  /** Welke factuur je wilt maken: aanbetaling, eindfactuur of alles ineens. */
  let factuurSoort = 'aanbetaling';

  $$('[data-factuur]').forEach((knop) => {
    knop.addEventListener('click', () => {
      factuurSoort = knop.dataset.factuur;
      $$('[data-factuur]').forEach((k) => k.classList.toggle('aan', k === knop));
      /* Het percentage hoort alleen bij een aanbetaling. */
      $('#wb-pct-veld').hidden = factuurSoort !== 'aanbetaling';
      tekenAanbetaling();
    });
  });

  function tekenAanbetaling() {
    const vak = $('#wb-aanbetaling');
    if (!offerte.regels.length) {
      vak.innerHTML = '<p class="wb-leeg">Zet er eerst iets op de offerte.</p>';
      return;
    }
    const korting = offerte.kortingExclCent || 0;
    let rijen;

    if (factuurSoort === 'aanbetaling') {
      const a = aanbetaling(offerte.regels, staat.instellingen, huidigPercentage(), korting);
      rijen = [
        ['Klant betaalt nu', euro(a.inclCent)],
        ['Restant bij oplevering', euro(a.restInclCent)],
        [`Waarvan btw ${staat.instellingen.btwPct}%`, euro(a.btwCent)],
      ];
    } else {
      const e = eindafrekening(
        offerte.regels, staat.instellingen, korting,
        factuurSoort === 'eind' ? (offerte.factuur?.inclCent || 0) : 0
      );
      rijen = [];
      if (e.reedsBetaaldInclCent) {
        rijen.push(['Offertetotaal', euro(e.totaalInclCent)]);
        rijen.push(['Al aanbetaald', `-${euro(e.reedsBetaaldInclCent)}`]);
      }
      rijen.push(['Klant betaalt nu', euro(e.teBetalenInclCent)]);
      rijen.push([`Waarvan btw ${staat.instellingen.btwPct}%`, euro(e.teBetalenBtwCent)]);
    }

    vak.innerHTML = rijen
      .map(([label, bedrag]) => `<div><span>${label}</span><strong>${bedrag}</strong></div>`)
      .join('') +
      (staat.instellingen.iban
        ? ''
        : `<p class="wb-waarschuwing">Je rekeningnummer staat nog niet ingevuld. Zonder dat
           kan de klant niet betalen — zet hem bij <strong>Instellingen</strong>.</p>`) +
      (factuurSoort === 'eind' && !offerte.factuur
        ? `<p class="wb-waarschuwing">Er is nog geen aanbetaling gefactureerd bij deze offerte.
           De eindfactuur is dan het hele bedrag — bedoelde je <strong>Alles ineens</strong>?</p>`
        : '');
  }

  $('#wb-aanbetaling-pct').addEventListener('input', tekenAanbetaling);

  function tekenAlles() {
    bewaarConcept();
    tekenAfspraak();
    tekenKorting();
    tekenRegels();
    tekenOnderdeelknoppen();
    werkTotalenBij();
    tekenDossierMelding();
    tekenAanbetaling();
  }

  /* ================= CATALOGUS ================= */
  /**
   * ZOEKEN IN JE ONDERDELEN.
   *
   * Een ingelezen leveranciersprijslijst is zo vierhonderd artikelen. Alles
   * tegelijk laten zien maakte de offertepagina veertigduizend pixels lang —
   * vijftig schermen scrollen voordat je bij de rest van het formulier bent.
   * Dus: zoeken, en zonder zoekterm alleen de eerste handvol.
   */
  const ZICHTBAAR = 12;

  function past(onderdeel, zoek) {
    if (!zoek) return true;
    return [onderdeel.omschrijving, onderdeel.merk, onderdeel.artikelnummer, onderdeel.leverancier]
      .filter(Boolean)
      .join(' ')
      .toLowerCase()
      .includes(zoek);
  }

  function tekenCatalogus() {
    const vak = $('#wb-catalogus');
    vak.innerHTML = '';
    if (!staat.catalogus.length) {
      vak.innerHTML = '<p class="wb-leeg">Nog geen onderdelen.</p>';
      $('#wb-cat-zoekveld').hidden = true;
      return;
    }

    /* Het zoekveld verschijnt pas als er zoveel in staat dat scrollen niet
       meer werkt. Bij tien onderdelen is een zoekveld alleen maar in de weg. */
    $('#wb-cat-zoekveld').hidden = staat.catalogus.length <= ZICHTBAAR;
    const zoek = $('#wb-cat-zoek').value.trim().toLowerCase();

    /* Met de index erbij: aanpassen en weghalen wijzen naar de plek in de
       hele lijst, niet naar de plek in wat er nu toevallig staat. */
    const gevonden = staat.catalogus
      .map((onderdeel, i) => ({ onderdeel, i }))
      .filter(({ onderdeel }) => past(onderdeel, zoek));

    const tonen = zoek ? gevonden : gevonden.slice(0, ZICHTBAAR);
    const rest = gevonden.length - tonen.length;

    const kop = document.createElement('p');
    kop.className = 'wb-uitleg';
    kop.innerHTML = zoek
      ? `${telling(gevonden.length, 'onderdeel', 'onderdelen')} gevonden van de
         ${staat.catalogus.length}.`
      : `Je hebt ${telling(staat.catalogus.length, 'onderdeel', 'onderdelen')}.` +
        (rest ? ` Hieronder de eerste ${tonen.length}; zoek hierboven om de rest te vinden.` : '');
    vak.appendChild(kop);

    if (!gevonden.length) {
      const leeg = document.createElement('p');
      leeg.className = 'wb-leeg';
      leeg.textContent = 'Niets gevonden. Probeer een deel van de naam of het artikelnummer.';
      vak.appendChild(leeg);
      return;
    }

    tonen.forEach(({ onderdeel, i }) => {
      const prijs = regelPrijs(onderdeel, staat.instellingen);
      const rij = document.createElement('div');
      rij.className = 'wb-regel';
      rij.innerHTML = `
        <div class="wb-regel-kop">
          <span>${ontsnap(onderdeel.omschrijving)}
            <small>${ontsnap(onderdeel.merk || '')} ${soortNaam(onderdeel.soort)}</small>
          </span>
          <strong>${euro(prijs.inclCent)}</strong>
        </div>
        <div class="wb-regel-rij">
          <span class="wb-uitleg">inkoop ${euro(onderdeel.inkoopCent)} · ${onderdeel.margePct ?? staat.instellingen.margePct}% · ${onderdeel.uren || 0} uur</span>
          <button type="button" class="wb-link wb-bewerk">Aanpassen</button>
          <button type="button" class="wb-link wb-weg">Weghalen</button>
        </div>`;
      rij.querySelector('.wb-bewerk').addEventListener('click', () => {
        bewerktOnderdeel = i;
        $('#wb-o-naam').value = onderdeel.omschrijving || '';
        $('#wb-o-toelichting').value = onderdeel.toelichting || '';
        $('#wb-o-soort').value = onderdeel.soort || 'overig';
        $('#wb-o-merk').value = onderdeel.merk || '';
        $('#wb-o-artikelnummer').value = onderdeel.artikelnummer || '';
        $('#wb-o-leverancier').value = onderdeel.leverancier || '';
        toebehorenNu = (onderdeel.toebehoren || []).map((t) => ({ ...t }));
        tekenToebehoren();
        $('#wb-o-inkoop').value = (onderdeel.inkoopCent / 100).toFixed(2).replace('.', ',');
        $('#wb-o-marge').value = onderdeel.margePct ?? '';
        $('#wb-o-uren').value = onderdeel.uren || '';
        $('#wb-onderdeel-kop').textContent = 'Onderdeel aanpassen';
        $('#wb-o-annuleer').hidden = false;
        toonVoorbeeld();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      rij.querySelector('.wb-weg').addEventListener('click', () => {
        staat.catalogus.splice(i, 1);
        opslaan();
        tekenCatalogus();
        tekenOnderdeelknoppen();
      });
      vak.appendChild(rij);
    });
  }

  /**
   * WAT ER VERPLICHT BIJ EEN ONDERDEEL HOORT.
   *
   * Een composet is nooit alleen een composet: er gaan ringen bij, twee
   * adapterkabels en een rol butyl. Die staan hier, aan het onderdeel vast.
   * Kies je het onderdeel op een offerte, dan komt de hele sleep mee — in de
   * inkoop (dus in je marge) en op de werkbon (dus bij de auto). De klant
   * blijft één regel zien.
   *
   * Dit is het antwoord op "alles moet kloppen met elk kabeltje": je legt het
   * één keer vast bij het onderdeel, en daarna kun je het niet meer vergeten.
   */
  let toebehorenNu = [];

  function tekenToebehoren() {
    const vak = $('#wb-o-toebehoren');
    vak.innerHTML = '';
    if (!toebehorenNu.length) {
      vak.innerHTML = '<p class="wb-leeg">Niets — dit onderdeel gaat er los in.</p>';
      return;
    }
    toebehorenNu.forEach((stuk, i) => {
      const rij = document.createElement('div');
      rij.className = 'wb-toebehoren';
      rij.innerHTML = `
        <input type="text" class="wb-t-naam wb-breed" value="${ontsnap(stuk.omschrijving || '')}"
               placeholder="Adapterringen 165 mm" aria-label="Omschrijving" />
        <input type="text" class="wb-t-artikel" value="${ontsnap(stuk.artikelnummer || '')}"
               placeholder="Artikelnr." aria-label="Artikelnummer" />
        <input type="text" class="wb-t-leverancier" value="${ontsnap(stuk.leverancier || '')}"
               placeholder="Leverancier" aria-label="Leverancier" />
        <input type="text" class="wb-t-aantal" inputmode="numeric" value="${stuk.aantal || 1}"
               placeholder="1" aria-label="Aantal" />
        <input type="text" class="wb-t-inkoop" inputmode="decimal"
               value="${stuk.inkoopCent ? (stuk.inkoopCent / 100).toFixed(2).replace('.', ',') : ''}"
               placeholder="inkoop" aria-label="Inkoopprijs" />
        <button type="button" class="wb-link wb-t-weg" aria-label="Regel weghalen">Weg</button>`;

      rij.querySelector('.wb-t-naam').addEventListener('input', (e) => { stuk.omschrijving = e.target.value; });
      rij.querySelector('.wb-t-artikel').addEventListener('input', (e) => { stuk.artikelnummer = e.target.value; });
      rij.querySelector('.wb-t-leverancier').addEventListener('input', (e) => { stuk.leverancier = e.target.value; });
      rij.querySelector('.wb-t-aantal').addEventListener('change', (e) => {
        stuk.aantal = Math.max(1, Math.round(Number(e.target.value) || 1));
        toonVoorbeeld();
      });
      rij.querySelector('.wb-t-inkoop').addEventListener('change', (e) => {
        stuk.inkoopCent = bedragIn(e.target.value);
        toonVoorbeeld();
      });
      rij.querySelector('.wb-t-weg').addEventListener('click', () => {
        toebehorenNu.splice(i, 1);
        tekenToebehoren();
        toonVoorbeeld();
      });
      vak.appendChild(rij);
    });
  }

  $('#wb-o-toebehoren-erbij').addEventListener('click', () => {
    toebehorenNu.push({ omschrijving: '', artikelnummer: '', leverancier: '', aantal: 1, inkoopCent: 0 });
    tekenToebehoren();
  });

  function leesOnderdeelFormulier() {
    const margeIn = $('#wb-o-marge').value.trim();
    return {
      omschrijving: $('#wb-o-naam').value.trim(),
      toelichting: $('#wb-o-toelichting').value.trim(),
      soort: $('#wb-o-soort').value,
      merk: $('#wb-o-merk').value.trim(),
      artikelnummer: $('#wb-o-artikelnummer').value.trim(),
      leverancier: $('#wb-o-leverancier').value.trim(),
      inkoopCent: bedragIn($('#wb-o-inkoop').value),
      margePct: margeIn === '' ? undefined : Number(margeIn.replace(',', '.')),
      uren: urenIn($('#wb-o-uren').value),
      /* Een kopie, geen verwijzing: anders wijzigt het volgende onderdeel dat
         je bewerkt stilletjes de toebehoren van het vorige mee. */
      toebehoren: toebehorenNu.map((t) => ({ ...t })),
    };
  }

  function toonVoorbeeld() {
    const onderdeel = leesOnderdeelFormulier();
    const prijs = regelPrijs(onderdeel, staat.instellingen);
    const stukken = onderdeel.toebehoren.length;
    $('#wb-o-voorbeeld').innerHTML = onderdeel.inkoopCent || onderdeel.uren || stukken
      ? `<span>De klant betaalt</span><strong>${euro(prijs.inclCent)}</strong>
         <em>incl. btw · marge ${euro(prijs.exclCent - prijs.kostprijsCent)}` +
        (stukken ? ` · inkoop is incl. ${stukken} ${stukken === 1 ? 'bijartikel' : 'bijartikelen'}` : '') +
        `</em>`
      : '';
  }

  ['#wb-o-inkoop', '#wb-o-marge', '#wb-o-uren'].forEach((kies) => {
    $(kies).addEventListener('input', toonVoorbeeld);
  });

  $('#wb-o-bewaar').addEventListener('click', () => {
    const onderdeel = leesOnderdeelFormulier();
    if (!onderdeel.omschrijving) {
      alert('Geef het onderdeel eerst een naam.');
      return;
    }
    if (bewerktOnderdeel != null) staat.catalogus[bewerktOnderdeel] = onderdeel;
    else staat.catalogus.push(onderdeel);
    opslaan();
    leegOnderdeelFormulier();
    tekenCatalogus();
    tekenOnderdeelknoppen();
  });

  $('#wb-o-annuleer').addEventListener('click', leegOnderdeelFormulier);

  /* Tijdens het typen meezoeken: je wilt na drie letters al zien of het erin
     staat, niet pas als je het hele artikelnummer hebt ingetikt. */
  $('#wb-cat-zoek').addEventListener('input', tekenCatalogus);
  $('#wb-onderdeel-zoek').addEventListener('input', tekenOnderdeelknoppen);

  function leegOnderdeelFormulier() {
    bewerktOnderdeel = null;
    ['#wb-o-naam', '#wb-o-toelichting', '#wb-o-merk', '#wb-o-artikelnummer',
     '#wb-o-leverancier', '#wb-o-inkoop', '#wb-o-marge', '#wb-o-uren']
      .forEach((kies) => { $(kies).value = ''; });
    toebehorenNu = [];
    tekenToebehoren();
    $('#wb-onderdeel-kop').textContent = 'Onderdeel toevoegen';
    $('#wb-o-annuleer').hidden = true;
    toonVoorbeeld();
  }

  /* ================= AUTO'S: HET DOSSIER PER MODEL ================= */
  let bewerktDossier = null;

  /** De sleutel en het dossier die bij de auto op de offerte horen. */
  function huidigDossier() {
    const auto = offerte.auto || {};
    if (!auto.merk && !auto.model) return { sleutel: '', naam: '', dossier: null };
    const sleutel = autoSleutel(
      { merk: auto.merk, handelsbenaming: auto.model, voertuigsoort: 'Personenauto' },
      MODELS
    );
    /**
     * De naam van het dossier is die van het MODEL, niet van de uitvoering.
     * De RDW noemt een auto "GOLF VII 1.4 TSI"; het dossier moet "Volkswagen
     * Golf" heten, want de speakermaat van een 1.4 TSI is dezelfde als die
     * van een 2.0 TDI. Kent de site het model, dan nemen we die naam over.
     */
    const bekend = MODELS.find((m) => m.slug === sleutel);
    const naam = bekend
      ? `${bekend.brand} ${bekend.model}`
      : [auto.merk, auto.model].filter(Boolean).join(' ');
    /* Ook onder de oude noemer kijken: dossiers die met de hand zijn ingetikt
       stonden voor deze versie onder een andere sleutel. */
    const sleutels = sleutelsVoor(
      { merk: auto.merk, handelsbenaming: auto.model }, MODELS
    );
    return { sleutel, naam, dossier: zoekDossier(staat.dossiers, sleutels, auto.bouwjaar) };
  }

  /**
   * De melding op de offerte: is er iets vastgelegd over deze auto?
   *
   * Dit staat er omdat je het vóór de klus wilt weten, niet als je al met een
   * deurpaneel in je handen staat.
   */
  function tekenDossierMelding() {
    const vak = $('#wb-dossier-melding');
    const { sleutel, dossier } = huidigDossier();
    if (!sleutel) {
      vak.innerHTML = '<p class="wb-uitleg">Vul eerst een kenteken in.</p>';
      return;
    }
    const stand = dossierStand(dossier);
    if (!dossier) {
      vak.innerHTML =
        `<p class="wb-waarschuwing">Van deze auto is nog niets vastgelegd. Op de werkbon
         komen lege regels om ter plekke in te vullen — de app verzint geen speakermaten
         of stekkers. Leg het vast onder <strong>Auto's</strong>.</p>`;
      const knop = document.createElement('button');
      knop.type = 'button';
      knop.className = 'wb-link';
      knop.textContent = 'Dit model nu vastleggen';
      knop.addEventListener('click', () => nieuwDossierVoorHuidigeAuto());
      vak.appendChild(knop);
      return;
    }
    vak.innerHTML =
      `<p class="wb-uitleg">Vastgelegd: <strong>${ontsnap(dossierNaam(dossier))}</strong> —
       ${stand.ingevuld} van de ${stand.totaal} gegevens ingevuld.</p>` +
      (stand.ontbreekt.length
        ? `<p class="wb-waarschuwing">Nog niet vastgelegd: ${stand.ontbreekt
            .map((id) => ontsnap((DOSSIER_VELDEN.find((v) => v.id === id) || {}).naam || id))
            .join(', ')}.</p>`
        : '');
  }

  /** Begin een dossier voor de auto die nu op de offerte staat. */
  function nieuwDossierVoorHuidigeAuto() {
    const { sleutel, naam } = huidigDossier();
    bewerktDossier = null;
    /**
     * De bouwjaren blijven leeg, met opzet. Het bouwjaar van déze auto is
     * niet het begin van de generatie: vul je 2018 in bij een Golf 7, dan
     * vindt de app het dossier niet meer terug bij een Golf 7 uit 2015.
     * Justus weet welke jaren een generatie loopt; de app niet.
     */
    vulDossierFormulier(leegDossier(sleutel, naam));
    toonTab('autos', { inGeschiedenis: true });
  }

  function vulDossierFormulier(dossier) {
    $('#wb-a-naam').value = dossier.naam || '';
    $('#wb-a-van').value = dossier.vanJaar || '';
    $('#wb-a-tot').value = dossier.totJaar || '';
    $('#wb-a-sleutel').textContent = dossier.sleutel
      ? `Herkend als: ${dossier.sleutel}`
      : 'Nog geen auto gekozen — vul hierboven een modelnaam in.';
    $('#wb-a-sleutel').dataset.sleutel = dossier.sleutel || '';
    for (const veld of DOSSIER_VELDEN) {
      const invoer = $(`[data-dossier="${veld.id}"]`);
      if (invoer) invoer.value = dossier[veld.id] || '';
    }
    $('#wb-a-kop').textContent = bewerktDossier != null ? 'Model aanpassen' : 'Model vastleggen';
    $('#wb-a-annuleer').hidden = bewerktDossier == null;
  }

  function leesDossierFormulier() {
    const dossier = {
      /* Zonder sleutel wordt het dossier nooit teruggevonden bij een kenteken.
         Is er geen, dan maken we er een van de modelnaam. */
      /* Zonder sleutel wordt het dossier nooit teruggevonden bij een kenteken.
         Komt hij niet van een offerte, dan gaat de getikte modelnaam door
         dezelfde herkenning als een echte auto — anders zou "Volkswagen Golf
         VII" onder een andere noemer staan dan de Golf op een offerte, en
         vond de app hem nooit. */
      sleutel: $('#wb-a-sleutel').dataset.sleutel
        || sleutelUitNaam($('#wb-a-naam').value, MODELS),
      naam: $('#wb-a-naam').value.trim(),
      vanJaar: $('#wb-a-van').value.trim(),
      totJaar: $('#wb-a-tot').value.trim(),
    };
    for (const veld of DOSSIER_VELDEN) {
      const invoer = $(`[data-dossier="${veld.id}"]`);
      dossier[veld.id] = invoer ? invoer.value.trim() : '';
    }
    return dossier;
  }

  $('#wb-a-bewaar').addEventListener('click', () => {
    const dossier = leesDossierFormulier();
    if (!dossier.naam) {
      alert('Geef het model eerst een naam, bijvoorbeeld "Volkswagen Golf".');
      return;
    }
    if (bewerktDossier != null) staat.dossiers[bewerktDossier] = dossier;
    else staat.dossiers.push(dossier);
    opslaan();
    bewerktDossier = null;
    vulDossierFormulier(leegDossier());
    tekenDossiers();
    tekenDossierMelding();
  });

  $('#wb-a-annuleer').addEventListener('click', () => {
    bewerktDossier = null;
    vulDossierFormulier(leegDossier());
  });

  function tekenDossiers() {
    const vak = $('#wb-a-lijst');
    vak.innerHTML = '';
    if (!staat.dossiers.length) {
      vak.innerHTML = '<p class="wb-leeg">Nog geen modellen vastgelegd.</p>';
      return;
    }
    staat.dossiers.forEach((dossier, i) => {
      const stand = dossierStand(dossier);
      const rij = document.createElement('div');
      rij.className = 'wb-regel';
      rij.innerHTML = `
        <div class="wb-regel-kop">
          <span>${ontsnap(dossierNaam(dossier))}
            <small>${stand.ingevuld} van de ${stand.totaal} gegevens</small>
          </span>
        </div>
        <div class="wb-regel-rij">
          <button type="button" class="wb-link wb-bewerk">Aanpassen</button>
          <button type="button" class="wb-link wb-weg">Weghalen</button>
        </div>`;
      rij.querySelector('.wb-bewerk').addEventListener('click', () => {
        bewerktDossier = i;
        vulDossierFormulier(dossier);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      rij.querySelector('.wb-weg').addEventListener('click', () => {
        staat.dossiers.splice(i, 1);
        opslaan();
        tekenDossiers();
        tekenDossierMelding();
      });
      vak.appendChild(rij);
    });
  }

  /* ================= INSTELLINGEN ================= */
  const instellingVelden = [
    ['#wb-i-uurtarief', 'uurtariefCent', (v) => naarCent(v), (w) => (w / 100).toFixed(2).replace('.', ',')],
    ['#wb-i-marge', 'margePct', (v) => Number(v.replace(',', '.')) || 0, (w) => w],
    ['#wb-i-btw', 'btwPct', (v) => Number(v.replace(',', '.')) || 0, (w) => w],
    ['#wb-i-geldig', 'geldigDagen', (v) => Number(v) || 0, (w) => w],
    ['#wb-i-volgnummer', 'volgnummer', (v) => Number(v) || 1, (w) => w],
    ['#wb-i-besteldagen', 'bestelDagen', (v) => Number(v) || 14, (w) => w],
    ['#wb-i-googleagenda', 'googleAgenda', (v) => v.trim(), (w) => w || ''],
    ['#wb-i-iban', 'iban', (v) => v.trim(), (w) => w || ''],
    ['#wb-i-tenaamstelling', 'tenaamstelling', (v) => v.trim(), (w) => w || ''],
    ['#wb-i-aanbetaling', 'aanbetalingPct', (v) => Number(v.replace(',', '.')) || 0, (w) => w],
    ['#wb-i-betaaltermijn', 'betaaltermijnDagen', (v) => Number(v) || 0, (w) => w],
    ['#wb-i-factuurnummer', 'factuurVolgnummer', (v) => Number(v) || 1, (w) => w],
  ];

  function tekenInstellingen() {
    for (const [kies, sleutel, , naarTekst] of instellingVelden) {
      $(kies).value = naarTekst(staat.instellingen[sleutel]);
    }
  }

  for (const [kies, sleutel, naarWaarde] of instellingVelden) {
    $(kies).addEventListener('change', (e) => {
      staat.instellingen[sleutel] = naarWaarde(e.target.value);
      opslaan();
      tekenInstellingen();
      tekenCatalogus();
      tekenGoogleAgenda();
      tekenAlles();
    });
  }

  /**
   * De snelkoppelingen naar elk tabblad.
   *
   * Gewone links en geen knoppen: alleen een echte link kan Chrome op je
   * beginscherm zetten. Ze staan hier in de app zodat je niet zelf een adres
   * hoeft over te typen.
   */
  $('#wb-adres-app').textContent = `${SITE.url.replace(/^https?:\/\//, '')}${APP.pad}`;
  $('#wb-tabkoppelingen').innerHTML = TABBLADEN
    .map((t) => `<a class="btn wb-tabkoppeling" href="?tab=${t.id}">${ontsnap(t.naam)}</a>`)
    .join('');

  /* ================= RESERVEKOPIE ================= */
  $('#wb-export').addEventListener('click', () => {
    /* Het merkje 'reservekopie' is belangrijk: daaraan ziet het inlezen dat
       dit bestand ALLES vervangt. Een bestand zonder dat merkje — een
       prijslijst bijvoorbeeld — wordt juist toegevoegd aan wat er al staat. */
    const blob = new Blob([JSON.stringify({ soort: 'reservekopie', ...staat }, null, 2)], {
      type: 'application/json',
    });
    const adres = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = adres;
    /* De lokale datum, niet die van Greenwich: tussen middernacht en twee uur
       's nachts heette de reservekopie anders een dag ouder dan hij is. */
    const nu = new Date();
    const twee = (n) => String(n).padStart(2, '0');
    const vandaag = `${nu.getFullYear()}-${twee(nu.getMonth() + 1)}-${twee(nu.getDate())}`;
    link.download = `${APP.naam.toLowerCase()}-${vandaag}.json`;
    link.click();
    URL.revokeObjectURL(adres);
  });

  /**
   * EEN BESTAND INLEZEN — en twee heel verschillende gevallen.
   *
   *   Een reservekopie      alles erin: instellingen, onderdelen, auto's,
   *                         offertes. Die zet je terug: hij vervangt.
   *   Een prijslijst        alleen onderdelen. Die wil je erbíj, niet in
   *                         plaats van. Anders ben je met één tik je hele
   *                         autodossier kwijt omdat je een lijst speakers
   *                         inlas.
   *
   * Het verschil zit hem erin of er meer in het bestand staat dan alleen de
   * onderdelen. Wat er gaat gebeuren staat in de vraag, zodat je nooit per
   * ongeluk het verkeerde doet.
   */
  $('#wb-import').addEventListener('change', async (e) => {
    const bestand = e.target.files?.[0];
    if (!bestand) return;
    try {
      const gelezen = JSON.parse(await bestand.text());
      if (!Array.isArray(gelezen.catalogus)) throw new Error('geen eigen bestand');

      /**
       * Alleen een bestand dat zichzelf een reservekopie noemt vervangt
       * alles. Hier stond eerst "heeft het meer velden dan alleen de
       * onderdelen?" — en dat was fout: een aangeleverde prijslijst mét
       * autodossiers erin had daarmee alle instellingen gewist.
       */
      const isReservekopie = gelezen.soort === 'reservekopie';
      const aantal = gelezen.catalogus.length;

      if (isReservekopie) {
        /**
         * Wat er in het bestand zit én wat je nu hebt.
         *
         * Alleen vertellen wat erin zit is de verkeerde helft van het verhaal:
         * zet je een kopie van vorige maand terug, dan ben je de offertes van
         * deze maand kwijt, en dat is precies wat je moet weten vóór je op ja
         * drukt.
         */
        const nu = [
          telling(staat.catalogus.length, 'onderdeel', 'onderdelen'),
          telling(staat.offertes.length, 'offerte', 'offertes'),
          telling(staat.dossiers.length, 'auto', "auto's"),
        ].join(', ');
        const straks = [
          telling(aantal, 'onderdeel', 'onderdelen'),
          telling((gelezen.offertes || []).length, 'offerte', 'offertes'),
          telling((gelezen.dossiers || []).length, 'auto', "auto's"),
        ].join(', ');
        const zeker = confirm(
          'Dit is een volledige reservekopie.\n\n' +
          `Je hebt nu:  ${nu}\n` +
          `In dit bestand:  ${straks}\n\n` +
          `Alles wat nu in ${APP.naam} staat wordt vervangen door wat er in dit ` +
          'bestand staat. Wat er nu is en niet in het bestand zit, is daarna weg.\n\n' +
          'Doorgaan?'
        );
        if (!zeker) { e.target.value = ''; return; }
        staat = {
          instellingen: { ...STANDAARD_INSTELLINGEN, ...(gelezen.instellingen || {}) },
          catalogus: gelezen.catalogus,
          offertes: metKenmerk(gelezen.offertes),
          dossiers: Array.isArray(gelezen.dossiers) ? gelezen.dossiers : [],
          /* Een reservekopie van vóór de luistersessies heeft dit veld niet.
             Zonder deze regel bleef staat.sessies leeg achter en liep de app
             stuk zodra je er een wilde bewaren. */
          sessies: Array.isArray(gelezen.sessies) ? gelezen.sessies : [],
        };
        alert(
          'Teruggezet: ' + [
            telling(staat.catalogus.length, 'onderdeel', 'onderdelen'),
            telling(staat.offertes.length, 'offerte', 'offertes'),
            telling(staat.dossiers.length, 'auto', "auto's"),
          ].join(', ') + '.'
        );
      } else {
        /* Toevoegen, en wat er al staat overslaan. Zonder die controle staat
           na twee keer inlezen alles dubbel in je lijst. */
        const bekend = new Set(
          staat.catalogus.map((o) => `${o.leverancier}|${o.artikelnummer}`.toLowerCase())
        );
        const nieuw = gelezen.catalogus.filter((o) => {
          const sleutel = `${o.leverancier || ''}|${o.artikelnummer || ''}`.toLowerCase();
          if (!o.artikelnummer || bekend.has(sleutel)) return !o.artikelnummer;
          bekend.add(sleutel);
          return true;
        });
        staat.catalogus = [...staat.catalogus, ...nieuw];

        const dossiers = Array.isArray(gelezen.dossiers) ? gelezen.dossiers : [];
        const bekendeAutos = new Set(
          staat.dossiers.map((d) => `${d.sleutel}|${d.vanJaar}|${d.totJaar}|${d.chassis || ''}`)
        );
        const nieuweAutos = dossiers.filter((d) => {
          const sleutel = `${d.sleutel}|${d.vanJaar}|${d.totJaar}|${d.chassis || ''}`;
          if (bekendeAutos.has(sleutel)) return false;
          bekendeAutos.add(sleutel);
          return true;
        });
        staat.dossiers = [...staat.dossiers, ...nieuweAutos];

        /**
         * Instellingen uit een aangeleverd bestand vullen alleen LEGE velden.
         *
         * Zo kan er een rekeningnummer meekomen zonder dat een bestand ooit
         * iets overschrijft wat Justus zelf heeft ingesteld. Een uurtarief dat
         * hij gisteren goed heeft gezet blijft dus staan, ook als er in het
         * bestand een ander getal staat.
         */
        let aangevuld = 0;
        for (const [sleutel, waarde] of Object.entries(gelezen.instellingen || {})) {
          const nu = staat.instellingen[sleutel];
          const leeg = nu === undefined || nu === null || nu === '';
          if (leeg && waarde !== '' && waarde != null) {
            staat.instellingen[sleutel] = waarde;
            aangevuld += 1;
          }
        }

        const overgeslagen = aantal - nieuw.length;
        alert(
          `${telling(nieuw.length, 'onderdeel', 'onderdelen')} toegevoegd` +
          (nieuweAutos.length ? ` en ${telling(nieuweAutos.length, 'auto', "auto's")}` : '') + '.' +
          (aangevuld ? `\n${telling(aangevuld, 'lege instelling', 'lege instellingen')} ingevuld.` : '') +
          (overgeslagen
            ? `\n${overgeslagen} ${overgeslagen === 1 ? 'stond' : 'stonden'} er al in en ` +
              `${overgeslagen === 1 ? 'is' : 'zijn'} overgeslagen.`
            : '')
        );
      }

      opslaan();
      tekenInstellingen();
      tekenCatalogus();
      tekenDossiers();
      tekenAlles();
    } catch (err) {
      alert(`Dit bestand kon ik niet lezen. Komt het uit ${APP.naam}?`);
    }
    e.target.value = '';
  });

  /* ================= BEWAREN EN OPNIEUW ================= */
  /**
   * DE STATUS VAN EEN OFFERTE.
   *
   * Zo zie je in één oogopslag wat er nog open staat. De app zet hem waar hij
   * het zeker weet — offerte verstuurd, aanbetaling gefactureerd, eindfactuur
   * eruit — en de rest zet Justus zelf door erop te tikken.
   */
  const STATUSSEN = ['concept', 'verstuurd', 'aanbetaald', 'gefactureerd', 'betaald'];

  /**
   * HET CONCEPT — de offerte waar je nu aan werkt.
   *
   * WAAROM DIT BESTAAT
   * Android sluit een tabblad dat op de achtergrond staat gewoon af als hij
   * geheugen nodig heeft. Ga je tussendoor naar WhatsApp of naar de camera —
   * en dat doe je de hele dag — dan kun je bij terugkomst een leeg scherm
   * treffen met een half uur werk eraf. Er staat geen server achter deze app
   * die dat opvangt.
   *
   * Daarom onthoudt de app wat er op dit moment in het formulier staat, ook
   * zonder dat je op Bewaren drukt. Het is één plek, geen lijst: hij bewaart
   * wat er nu open staat, en die wordt leeg zodra je aan een nieuwe begint.
   * Je lijst met bewaarde offertes blijft dus precies wat je zelf bewaard
   * hebt — dit staat daarnaast.
   */
  const heeftInhoud = (o) => !!(
    o?.regels?.length || o?.klant?.naam || o?.klant?.bedrijf ||
    o?.auto?.kenteken || o?.auto?.merk || o?.inbouwdatum || o?.opmerking
  );

  function bewaarConcept() {
    const nieuwConcept = heeftInhoud(offerte)
      ? { ...offerte, datum: offerte.datum.toISOString() }
      : null;
    /* Niets veranderd? Dan ook niet schrijven. Anders staat de app bij elke
       toetsaanslag de hele opslag opnieuw weg te zetten. */
    if (JSON.stringify(staat.concept) === JSON.stringify(nieuwConcept)) return;
    staat.concept = nieuwConcept;
    opslaan();
  }

  /**
   * De offerte bewaren, of bijwerken als hij er al staat.
   *
   * Op het eigen kenmerk en niet op het nummer. Op nummer ging het twee keer
   * mis: eerst stond dezelfde offerte vier keer in de lijst nadat je hem had
   * bewaard, verstuurd, aanbetaald en afgerekend; daarna overschreef een
   * tweede nieuwe offerte de eerste, omdat die allebei nog het nummer van de
   * teller droegen. Een klant verdwenen zonder melding.
   *
   * Het nummer wordt daarom pas vastgelegd als je bewaart, en de teller
   * schuift op datzelfde moment op. Zo hoort bij elk vergeven nummer ook echt
   * een offerte, en houdt je reeks geen gaten van offertes die nooit bestonden.
   */
  function bewaarOfferte() {
    if (!offerte.id) offerte.id = eigenId();
    const i = staat.offertes.findIndex((o) => o.id === offerte.id);

    if (i < 0) {
      const { n, nummer } = vrijNummer();
      offerte.nummer = nummer;
      staat.instellingen.volgnummer = n + 1;
    }

    const plat = { ...offerte, datum: offerte.datum.toISOString() };
    if (i >= 0) staat.offertes[i] = plat;
    else staat.offertes.unshift(plat);
    staat.offertes = staat.offertes.slice(0, 200);
  }

  $('#wb-bewaar').addEventListener('click', () => {
    if (!offerte.status) offerte.status = 'concept';
    bewaarOfferte();
    opslaan();
    tekenOpgeslagen();
    tekenInstellingen();
    /* Het nummer wordt bij het bewaren vastgelegd; de balk bovenin en de
       marge moeten dat meteen laten zien. */
    tekenAlles();
  });

  $('#wb-zoek').addEventListener('input', tekenBewaard);

  $('#wb-nieuw').addEventListener('click', () => {
    /**
     * Eerst vragen als er werk in staat dat nergens bewaard is.
     *
     * Deze knop staat vlak onder Bewaren, en in de werkplaats tik je met een
     * vette duim. Zonder deze vraag ben je een half uur invoeren kwijt met één
     * misser. Staat de offerte al in je lijst, dan valt er niets te verliezen
     * en vraagt hij niets.
     */
    const bewaard = staat.offertes.some((o) => o.id === offerte.id);
    if (!bewaard && heeftInhoud(offerte)) {
      const weg = confirm(
        'Deze offerte staat nog niet in je lijst. Begin je een nieuwe, dan is ' +
        'wat je hier hebt ingevuld weg.\n\nToch een nieuwe beginnen?'
      );
      if (!weg) return;
    }
    offerte = nieuweOfferte();
    voorkeuren = new Set();
    $$('#wb-voorkeuren .wb-chip').forEach((c) => c.classList.remove('aan'));
    ['#wb-kenteken', '#wb-naam', '#wb-adres', '#wb-telefoon', '#wb-email', '#wb-bedrijf', '#wb-opmerking',
     '#wb-merk', '#wb-model', '#wb-bouwjaar', '#wb-aanbetaling-pct', '#wb-korting',
     '#wb-inbouwdatum']
      .forEach((kies) => { $(kies).value = ''; });
    $('#wb-inbouwtijd').value = '09:00';
    toonAutoVelden(false);
    melden('');
    tekenAfspraken();
    tekenAlles();
    window.scrollTo({ top: 0 });
  });

  /**
   * Alles wat uit je bewaarde offertes wordt getekend.
   *
   * De lijst onderaan de offerte en de agenda lezen dezelfde gegevens. Werk je
   * er maar één bij, dan staat de agenda een tik achter en denk je dat er geen
   * klus in staat.
   */
  function tekenOpgeslagen() {
    tekenBewaard();
    tekenAgenda();
    tekenGoogleAgenda();
    tekenRapport();
  }

  function tekenBewaard() {
    const vak = $('#wb-bewaard');
    vak.innerHTML = '';
    if (!staat.offertes.length) return;

    const zoek = $('#wb-zoek').value.trim().toLowerCase();
    const gevonden = staat.offertes.filter((eerder) => {
      if (!zoek) return true;
      const hooiberg = [
        eerder.nummer,
        eerder.klant?.naam, eerder.klant?.bedrijf,
        eerder.auto?.kenteken, eerder.auto?.merk, eerder.auto?.model,
      ].filter(Boolean).join(' ').toLowerCase();
      return hooiberg.includes(zoek);
    });

    const kop = document.createElement('p');
    kop.className = 'wb-uitleg';
    kop.textContent = zoek
      ? `${gevonden.length} van de ${staat.offertes.length} offertes`
      : `Eerder bewaard (${staat.offertes.length}):`;
    vak.appendChild(kop);

    /* Zonder zoekopdracht de laatste tien; zoek je, dan alles wat past. */
    for (const eerder of zoek ? gevonden : gevonden.slice(0, 10)) {
      const wie = eerder.klant?.naam || eerder.klant?.bedrijf || 'zonder naam';
      const t = totalen(eerder.regels || [], staat.instellingen, eerder.kortingExclCent || 0);
      const status = eerder.status || 'concept';
      const af = status === 'betaald' || status === 'gefactureerd';

      const rij = document.createElement('div');
      rij.className = 'wb-regel';
      rij.innerHTML = `
        <div class="wb-regel-kop">
          <span>${ontsnap(eerder.nummer)} · ${ontsnap(wie)}
            <small>${ontsnap(eerder.auto?.kenteken || '')} ${ontsnap(
        [eerder.auto?.merk, eerder.auto?.model].filter(Boolean).join(' ')
      )}</small>
          </span>
          <strong>${euro(eerder.zakelijk ? t.exclCent : t.inclCent)}</strong>
        </div>
        <div class="wb-regel-rij">
          <button type="button" class="wb-status${af ? ' af' : ''}">${status}</button>
          <button type="button" class="wb-link wb-open-offerte">Openen</button>
        </div>`;

      /* Op de status tikken zet hem een stap verder. Zo hoef je geen menu
         open te klappen met olie aan je handen. */
      rij.querySelector('.wb-status').addEventListener('click', () => {
        const nu = STATUSSEN.indexOf(status);
        werkBij(eerder.nummer, { status: STATUSSEN[(nu + 1) % STATUSSEN.length] });
        tekenOpgeslagen();
      });
      rij.querySelector('.wb-open-offerte').addEventListener('click', () => {
        offerte = { ...eerder, datum: new Date(eerder.datum) };
        vulFormulierUitOfferte();
        tekenAlles();
        window.scrollTo({ top: 0 });
      });
      vak.appendChild(rij);
    }
  }

  function vulFormulierUitOfferte() {
    $('#wb-kenteken').value = offerte.auto?.kenteken || '';
    $('#wb-naam').value = offerte.klant?.naam || '';
    $('#wb-adres').value = offerte.klant?.adres || '';
    $('#wb-telefoon').value = offerte.klant?.telefoon || '';
    $('#wb-email').value = offerte.klant?.email || '';
    $('#wb-bedrijf').value = offerte.klant?.bedrijf || '';
    $('#wb-opmerking').value = offerte.opmerking || '';
    $('#wb-inbouwdatum').value = offerte.inbouwdatum || '';
    $('#wb-inbouwtijd').value = offerte.inbouwtijd || '09:00';
    /* De korting terugzetten in de maat die de klant ziet. */
    $('#wb-korting').value = offerte.kortingExclCent
      ? (offerte.zakelijk
        ? offerte.kortingExclCent / 100
        : Math.round(offerte.kortingExclCent * (1 + staat.instellingen.btwPct / 100)) / 100
      ).toFixed(2).replace('.', ',')
      : '';
    vulAutoVelden();
    toonAutoVelden(!!offerte.auto?.merk);
    $('#wb-bedrijf-veld').hidden = !offerte.zakelijk;
    $$('[data-klant]').forEach((k) => {
      k.classList.toggle('aan', (k.dataset.klant === 'zakelijk') === !!offerte.zakelijk);
    });
    tekenAfspraken();
  }

  /* ================= PDF EN VERSTUREN ================= */
  $('#wb-pdf').addEventListener('click', async () => {
    if (!offerte.regels.length) {
      alert('Zet er eerst iets op de offerte.');
      return;
    }
    const compleet = {
      ...offerte,
      geldigTot: geldigTot(offerte.datum, staat.instellingen.geldigDagen),
    };
    const doc = offertePdf(compleet, staat.instellingen);
    const blob = doc.naarBlob();
    const naam = pdfBestandsnaam(compleet);
    const bestand = new File([blob], naam, { type: 'application/pdf' });

    const auto = autoNaam(offerte.auto?.merk, offerte.auto?.model);
    const bericht = `Hoi${offerte.klant?.naam ? ` ${offerte.klant.naam.split(' ')[0]}` : ''}, ` +
      `hierbij de offerte${auto ? ` voor je ${auto}` : ''}. ` +
      `Vragen? App gerust terug. Groet, Justus — ${SITE.name}`;

    /* Op de telefoon opent dit het deelvenster: daar staat WhatsApp tussen
       en gaat de pdf als bijlage mee. Dat is de kortste weg van werkbank
       naar klant. */
    if (navigator.canShare?.({ files: [bestand] })) {
      try {
        await navigator.share({ files: [bestand], text: bericht });
        bewaarNaVersturen();
        return;
      } catch (err) {
        /* Afgebroken door de gebruiker: dan gewoon downloaden. */
      }
    }

    const adres = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = adres;
    link.download = naam;
    link.click();
    URL.revokeObjectURL(adres);
    bewaarNaVersturen();

    const nummer = String(offerte.klant?.telefoon || '').replace(/[^0-9]/g, '');
    /* 0612... wordt 31612...: wa.me wil het landnummer en geen nul vooraan. */
    const internationaal = nummer.startsWith('0') ? `31${nummer.slice(1)}` : nummer;
    if (internationaal.length >= 11) {
      window.open(`https://wa.me/${internationaal}?text=${encodeURIComponent(bericht)}`, '_blank');
    }
  });

  /* ================= DE AANBETALINGSFACTUUR ================= */
  $('#wb-factuur').addEventListener('click', async () => {
    if (!offerte.regels.length) {
      alert('Zet er eerst iets op de offerte.');
      return;
    }
    /* Zonder rekeningnummer is een factuur waardeloos: de klant weet niet
       waar het geld heen moet. Daarom blokkeren en niet alleen waarschuwen. */
    if (!staat.instellingen.iban) {
      alert('Vul eerst je rekeningnummer in bij Instellingen. Zonder dat kan de klant niet betalen.');
      return;
    }
    if (!offerte.klant?.naam && !offerte.klant?.bedrijf) {
      alert('Vul eerst de naam van de klant in. Een factuur zonder naam is niet geldig.');
      return;
    }
    const pct = huidigPercentage();
    const korting = offerte.kortingExclCent || 0;
    const deel = factuurSoort === 'aanbetaling'
      ? aanbetaling(offerte.regels, staat.instellingen, pct, korting)
      : eindafrekening(
        offerte.regels, staat.instellingen, korting,
        factuurSoort === 'eind' ? (offerte.factuur?.inclCent || 0) : 0
      );
    const teBetalenCent = factuurSoort === 'aanbetaling' ? deel.inclCent : deel.teBetalenInclCent;
    if (teBetalenCent <= 0) {
      alert('Er staat niets open om te factureren.');
      return;
    }
    /**
     * Het adres is boven de honderd euro wettelijk verplicht op een factuur.
     * Daaronder mag een vereenvoudigde factuur. We blokkeren niet — Justus
     * kent zijn klant — maar we zeggen het wel, één keer, met het bedrag erbij.
     */
    if (!offerte.klant?.adres && teBetalenCent > 10000) {
      const toch = confirm(
        `Er staat geen adres bij de klant. Boven de honderd euro — en dit is ` +
        `${euro(teBetalenCent)} — is een factuur zonder adres van de klant niet geldig.\n\n` +
        'Toch doorgaan?'
      );
      if (!toch) return;
    }

    const datum = new Date();
    const nummer = factuurnummer(staat.instellingen.factuurVolgnummer, datum);
    const doc = factuurPdf(offerte, staat.instellingen, {
      soort: factuurSoort, nummer, datum, percentage: pct,
    });
    const blob = doc.naarBlob();
    const naam = factuurBestandsnaam(nummer, offerte);
    const bestand = new File([blob], naam, { type: 'application/pdf' });

    const auto = autoNaam(offerte.auto?.merk, offerte.auto?.model);
    const bericht = factuurSoort === 'aanbetaling'
      ? `Hoi${offerte.klant?.naam ? ` ${offerte.klant.naam.split(' ')[0]}` : ''}, ` +
        `hierbij de aanbetalingsfactuur${auto ? ` voor je ${auto}` : ''}: ${euro(teBetalenCent)}. ` +
        `Zodra die binnen is plan ik je in. Groet, Justus — ${SITE.name}`
      : `Hoi${offerte.klant?.naam ? ` ${offerte.klant.naam.split(' ')[0]}` : ''}, ` +
        `${auto ? `je ${auto} is klaar. ` : ''}Hierbij de factuur: ${euro(teBetalenCent)}. ` +
        `Bedankt en veel luisterplezier. Groet, Justus — ${SITE.name}`;

    if (navigator.canShare?.({ files: [bestand] })) {
      try {
        await navigator.share({ files: [bestand], text: bericht });
        naFactuur(nummer, teBetalenCent);
        return;
      } catch (err) {
        /* Afgebroken: dan gewoon downloaden. */
      }
    }
    const adres = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = adres;
    link.download = naam;
    link.click();
    URL.revokeObjectURL(adres);
    naFactuur(nummer, teBetalenCent);
  });

  /**
   * Na het versturen schuift het factuurnummer op.
   *
   * Dat moet, en het moet ook maar één keer: een factuurnummer mag niet twee
   * keer bestaan. Het nummer en het bedrag blijven bij de offerte staan, zodat
   * je bij de eindfactuur weet wat er al betaald is.
   */
  function naFactuur(nummer, bedragCent) {
    /**
     * Alleen een AANBETALING wordt onthouden als "al betaald". Een eindfactuur
     * of een factuur ineens sluit de klus af; zou die ook in offerte.factuur
     * komen, dan trekt een volgende eindfactuur hem er nog eens vanaf.
     */
    if (factuurSoort === 'aanbetaling') {
      offerte.factuur = { nummer, inclCent: bedragCent, datum: new Date().toISOString() };
    }
    offerte.status = factuurSoort === 'aanbetaling' ? 'aanbetaald' : 'gefactureerd';
    staat.instellingen.factuurVolgnummer =
      (Number(staat.instellingen.factuurVolgnummer) || 1) + 1;
    bewaarOfferte();
    opslaan();
    tekenInstellingen();
    tekenAanbetaling();
    tekenOpgeslagen();
  }

  /* ================= DE WERKBON ================= */
  $('#wb-werkbon').addEventListener('click', async () => {
    if (!offerte.regels.length) {
      alert('Zet er eerst iets op de offerte.');
      return;
    }
    const { dossier } = huidigDossier();
    const doc = werkbonPdf(offerte, dossier);
    const blob = doc.naarBlob();
    const naam = werkbonBestandsnaam(offerte);
    const bestand = new File([blob], naam, { type: 'application/pdf' });

    /* Delen mag hier ook: naar de printer, naar je eigen telefoon, naar een
       monteur. Alleen niet naar de klant — dat staat op de bon zelf. */
    if (navigator.canShare?.({ files: [bestand] })) {
      try {
        await navigator.share({ files: [bestand] });
        return;
      } catch (err) {
        /* Afgebroken: dan gewoon downloaden. */
      }
    }
    const adres = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = adres;
    link.download = naam;
    link.click();
    URL.revokeObjectURL(adres);
  });

  /**
   * Na het versturen schuift het offertenummer op. Zo krijgt de volgende
   * klant een eigen nummer en kun je een offerte altijd terugvinden.
   */
  function bewaarNaVersturen() {
    if (!offerte.status || offerte.status === 'concept') offerte.status = 'verstuurd';
    /* De teller schuift niet meer hier op maar in bewaarOfferte, en alleen als
       de offerte er nog niet stond. Deed hij het hier ook, dan sprong hij bij
       elke verstuurde offerte twee nummers verder. */
    bewaarOfferte();
    opslaan();
    tekenOpgeslagen();
    tekenInstellingen();
  }


  /* ================= HET MEETRAPPORT ================= */
  /**
   * HET RAPPORT DAT DE KLANT MEEKRIJGT.
   *
   * Twee dingen zitten hier bewust anders in elkaar dan bij de rest van de app.
   *
   * 1. DE SCHERMAFBEELDINGEN WORDEN NIET BEWAARD. Een schermafbeelding van een
   *    meetprogramma is al gauw een paar honderd kilobyte, en de opslag van een
   *    browser houdt bij een megabyte of vijf op. Twee rapporten met plaatjes
   *    erin en je hele catalogus, je offertes en je autodossiers passen er niet
   *    meer bij — dan verlies je dingen die je niet meer terug kunt halen. De
   *    tekst blijft dus wel bewaard, de plaatjes niet. Dat staat er ook bij.
   *
   * 2. HET RAPPORT IS GEEN PDF MAAR EEN AFDRUK. Onze eigen pdf-schrijver kan
   *    geen foto's. In plaats van daar een halve fotobibliotheek voor te
   *    bouwen, drukt de browser dit blok gewoon af — en "opslaan als pdf" zit
   *    in datzelfde printvenster.
   */
  let meting = leegRapport('geluid');

  /** De invoervelden van de nazorg, in het paneel gezet zoals ze in de lib staan. */
  function tekenNazorgvelden() {
    $('#mr-nazorg').innerHTML = NAZORG_VELDEN.map((v) => `
      <label class="wb-breed">${v.naam}
        <input type="text" data-nazorg="${v.id}" />
      </label>`).join('');
    $$('#mr-nazorg [data-nazorg]').forEach((invoer) => {
      invoer.addEventListener('input', () => {
        meting.nazorg[invoer.dataset.nazorg] = invoer.value;
        bewaarMeting();
      });
    });
  }

  /** De drie regels van "In het kort", elk met een eigen kop en tekst. */
  function tekenKort() {
    $('#mr-kort').innerHTML = meting.kort.map((p, i) => `
      <label class="wb-breed">${p.kop}
        <textarea data-kort="${i}" rows="5">${p.tekst}</textarea>
      </label>`).join('');
    $$('#mr-kort [data-kort]').forEach((invoer) => {
      invoer.addEventListener('input', () => {
        meting.kort[Number(invoer.dataset.kort)].tekst = invoer.value;
        bewaarMeting();
      });
    });
  }

  /** De systeemtabel: maximaal vijf regels, want meer past niet op het blad. */
  const SYSTEEM_MAX = 5;
  function tekenSysteem() {
    $('#mr-systeem').innerHTML = meting.systeem.map((r, i) => `
      <div class="wb-veldrij mr-rij">
        <label>Onderdeel
          <input type="text" data-sys="onderdeel" data-rij="${i}" value="${(r.onderdeel || '').replace(/"/g, '&quot;')}" placeholder="Speakers voor" />
        </label>
        <label>Merk en type
          <input type="text" data-sys="merktype" data-rij="${i}" value="${(r.merktype || '').replace(/"/g, '&quot;')}" placeholder="Gladen RS 165" />
        </label>
        <label>Plaats
          <input type="text" data-sys="plaats" data-rij="${i}" value="${(r.plaats || '').replace(/"/g, '&quot;')}" placeholder="voordeuren" />
        </label>
        <button type="button" class="wb-link mr-weg" data-rij="${i}">Regel weg</button>
      </div>`).join('') || '<p class="wb-uitleg">Nog geen regels.</p>';

    $$('#mr-systeem [data-sys]').forEach((invoer) => {
      invoer.addEventListener('input', () => {
        meting.systeem[Number(invoer.dataset.rij)][invoer.dataset.sys] = invoer.value;
        bewaarMeting();
      });
    });
    $$('#mr-systeem .mr-weg').forEach((knop) => {
      knop.addEventListener('click', () => {
        meting.systeem.splice(Number(knop.dataset.rij), 1);
        bewaarMeting();
        tekenSysteem();
      });
    });
    $('#mr-systeem-erbij').disabled = meting.systeem.length >= SYSTEEM_MAX;
  }

  /** De accumetingen: per regel een waarde voor en een waarde na. */
  function tekenAccuMetingen() {
    const m = meting.accu.metingen;
    $('#mr-accu-metingen').innerHTML = ACCU_METINGEN.map((r) => `
      <div class="wb-veldrij mr-rij">
        <p class="wb-uitleg wb-breed"><strong>${r.naam}</strong> — ${r.uitleg}</p>
        <label>Voor
          <input type="text" inputmode="decimal" data-accu="${r.id}Voor" value="${(m[`${r.id}Voor`] || '').replace(/"/g, '&quot;')}" placeholder="12,4" />
        </label>
        <label>Na
          <input type="text" inputmode="decimal" data-accu="${r.id}Na" value="${(m[`${r.id}Na`] || '').replace(/"/g, '&quot;')}" placeholder="12,7" />
        </label>
      </div>`).join('');
    $$('#mr-accu-metingen [data-accu]').forEach((invoer) => {
      invoer.addEventListener('input', () => {
        meting.accu.metingen[invoer.dataset.accu] = invoer.value;
        bewaarMeting();
      });
    });
  }

  /**
   * De vier plekken voor een schermafbeelding.
   *
   * De laatste twee — looptijd en fase — mogen leeg blijven. Blijven ze leeg,
   * dan komt dat blad er ook niet in; een leeg blad in een rapport dat de klant
   * meekrijgt ziet eruit alsof er iets mis is gegaan.
   */
  const BEELDEN = [
    { id: 'voorBeeld', naam: 'Frequentierespons voor', nodig: true },
    { id: 'naBeeld', naam: 'Frequentierespons na', nodig: true },
    { id: 'faseVoor', naam: 'Looptijd en fase voor', nodig: false },
    { id: 'faseNa', naam: 'Looptijd en fase na', nodig: false },
  ];

  function tekenBeelden() {
    $('#mr-beelden').innerHTML = BEELDEN.map((b) => `
      <div class="mr-beeldveld">
        <label class="wb-breed">${b.naam}${b.nodig ? '' : ' <span class="mr-mag">mag leeg</span>'}
          <input type="file" accept="image/*" data-beeld="${b.id}" />
        </label>
        ${meting[b.id] ? `<img class="mr-mini" src="${meting[b.id]}" alt="${b.naam}" />
          <button type="button" class="wb-link" data-beeld-weg="${b.id}">Weghalen</button>` : ''}
      </div>`).join('');

    $$('#mr-beelden [data-beeld]').forEach((invoer) => {
      invoer.addEventListener('change', () => {
        const bestand = invoer.files?.[0];
        if (!bestand) return;
        const lezer = new FileReader();
        lezer.onload = () => {
          meting[invoer.dataset.beeld] = String(lezer.result || '');
          tekenBeelden();
          tekenOntbreekt();
        };
        lezer.readAsDataURL(bestand);
      });
    });
    $$('#mr-beelden [data-beeld-weg]').forEach((knop) => {
      knop.addEventListener('click', () => {
        meting[knop.dataset.beeldWeg] = '';
        tekenBeelden();
        tekenOntbreekt();
      });
    });
  }

  /**
   * Wat er nog ontbreekt, en waarom dat erg is.
   *
   * De voormeting staat bovenaan met een oranje streep ernaast. Dat is de enige
   * stap die je niet kunt inhalen: staat de auto eenmaal goed, dan is er niets
   * meer om mee te vergelijken.
   */
  function tekenOntbreekt() {
    const gemist = ontbreekt(meting);
    $('#mr-ontbreekt').innerHTML = gemist.length
      ? `<div class="wb-waarschuwing"><strong>Nog niet compleet.</strong>
          <ul>${gemist.map((r) => `<li>${r}</li>`).join('')}</ul></div>`
      : '<p class="wb-uitleg">Compleet. Je kunt afdrukken.</p>';
    $('#mr-print').disabled = gemist.length > 0;
  }

  /** Welke kaarten horen bij dit soort rapport? */
  function tekenSoort() {
    const soort = meting.soort;
    $$('[data-meting]').forEach((k) => k.classList.toggle('aan', k.dataset.meting === soort));
    $$('[data-paneel="meting"] [data-voor]').forEach((blok) => {
      blok.hidden = blok.dataset.voor !== soort;
    });
    $('#mr-soort-uitleg').textContent = soort === 'accu'
      ? 'Hoort bij elke klus met een versterker, subwoofer of DSP. De site belooft bij die pakketten dat je de accu en de laadspanning meet.'
      : 'Hoort bij elke klus met een DSP. Zonder de meting van voor de afstemming kan dit rapport niet gemaakt worden.';
    tekenOntbreekt();
  }

  /** De tekstvelden bewaren. De plaatjes gaan hier bewust niet in mee. */
  function bewaarMeting() {
    const { voorBeeld, naBeeld, faseVoor, faseNa, ...zonderBeeld } = meting;
    staat.meting = zonderBeeld;
    opslaan();
    tekenOntbreekt();
  }

  /** Het formulier vullen uit wat er in `meting` staat. */
  function vulMeting() {
    $('#mr-nummer').value = meting.nummer;
    $('#mr-datum').value = meting.datum;
    $('#mr-klant').value = meting.klant;
    $('#mr-kenteken').value = meting.kenteken;
    $('#mr-bouwjaar').value = meting.bouwjaar;
    $('#mr-auto').value = meting.auto;
    $('#mr-meetpositie').value = meting.meetpositie;
    $('#mr-respons-toelichting').value = meting.responsToelichting;
    $('#mr-accu-type').value = meting.accu.type;
    $('#mr-accu-toelichting').value = meting.accuToelichting;
    NAZORG_VELDEN.forEach((v) => {
      const invoer = $(`[data-nazorg="${v.id}"]`);
      if (invoer) invoer.value = meting.nazorg[v.id] || '';
    });
    tekenKort();
    tekenSysteem();
    tekenBeelden();
    tekenAccuMetingen();
    tekenSoort();
  }

  /* De gewone tekstvelden aan het rapport knopen. */
  const MR_VELDEN = {
    '#mr-nummer': 'nummer',
    '#mr-datum': 'datum',
    '#mr-klant': 'klant',
    '#mr-kenteken': 'kenteken',
    '#mr-bouwjaar': 'bouwjaar',
    '#mr-auto': 'auto',
    '#mr-meetpositie': 'meetpositie',
    '#mr-respons-toelichting': 'responsToelichting',
    '#mr-accu-toelichting': 'accuToelichting',
  };
  Object.entries(MR_VELDEN).forEach(([kies, sleutel]) => {
    $(kies).addEventListener('input', () => {
      meting[sleutel] = $(kies).value;
      bewaarMeting();
    });
  });
  $('#mr-accu-type').addEventListener('input', () => {
    meting.accu.type = $('#mr-accu-type').value;
    bewaarMeting();
  });

  $$('[data-meting]').forEach((knop) => {
    knop.addEventListener('click', () => {
      meting.soort = knop.dataset.meting;
      bewaarMeting();
      tekenSoort();
    });
  });

  $('#mr-systeem-erbij').addEventListener('click', () => {
    if (meting.systeem.length >= SYSTEEM_MAX) return;
    meting.systeem.push({ onderdeel: '', merktype: '', plaats: '' });
    bewaarMeting();
    tekenSysteem();
  });

  $('#mr-kort-terug').addEventListener('click', () => {
    meting.kort = KORTE_PUNTEN.map((p) => ({ ...p }));
    bewaarMeting();
    tekenKort();
  });

  /**
   * Overnemen uit de offerte waar je aan werkt.
   *
   * Scheelt overtypen én typefouten in een kenteken. De regels van de offerte
   * worden meteen de systeemtabel: dat is precies wat erin gaat.
   */
  $('#mr-uit-offerte').addEventListener('click', () => {
    const naam = offerte.klant?.naam || offerte.klant?.bedrijf || '';
    if (naam) meting.klant = naam;
    if (offerte.auto?.kenteken) meting.kenteken = offerte.auto.kenteken;
    if (offerte.auto?.bouwjaar) meting.bouwjaar = String(offerte.auto.bouwjaar);
    const auto = autoNaam(offerte.auto?.merk, offerte.auto?.model);
    if (auto) meting.auto = auto;

    /* De regels van de offerte als systeemtabel. Alleen wat er echt in de auto
       komt: kabels en montagemateriaal zegt de klant niets. */
    const uitOfferte = (offerte.regels || [])
      .filter((r) => r.soort !== 'kabels' && r.soort !== 'overig')
      .slice(0, SYSTEEM_MAX)
      .map((r) => ({
        /* Een regel uit je catalogus heeft één soort; een pakket heeft er
           meer. Bij een pakket zegt de soort dus niets, en staat de naam van
           het pakket zelf in de kolom ernaast. */
        onderdeel: (SOORTEN.find((so) => so.id === r.soort) || {}).naam || '',
        merktype: [r.merk, r.omschrijving].filter(Boolean).join(' ').trim(),
        plaats: '',
      }));
    if (uitOfferte.length) meting.systeem = uitOfferte;

    /* Welk rapport hoort bij dit werk? Zit er een DSP in, dan is dat het
       geluidsrapport; anders het accurapport. */
    const passend = rapportenVoor(soortenIn(offerte.regels || []));
    if (passend.length && !passend.some((r) => r.id === meting.soort)) meting.soort = passend[0].id;

    bewaarMeting();
    vulMeting();
  });

  /**
   * AFDRUKKEN.
   *
   * Het rapport komt in het blok dat alleen bij het printen zichtbaar is, en
   * dan roepen we het printvenster op. Het nummer schuift daarna een op, zodat
   * het volgende rapport niet hetzelfde nummer krijgt.
   */
  $('#mr-print').addEventListener('click', () => {
    const gemist = ontbreekt(meting);
    if (gemist.length) {
      alert(`Dit rapport kan nog niet:\n\n- ${gemist.join('\n- ')}`);
      return;
    }
    if (!meting.nummer) meting.nummer = nieuwRapportnummer();
    $('#wb-print').innerHTML = meetrapportHtml(meting);
    $('#mr-nummer').value = meting.nummer;
    bewaarMeting();
    window.print();
  });

  /** Het eerstvolgende rapportnummer, en de teller schuift op. */
  function nieuwRapportnummer() {
    const n = Math.max(1, Math.round(Number(staat.instellingen.rapportVolgnummer) || 1));
    staat.instellingen.rapportVolgnummer = n + 1;
    return rapportnummer(n, meting.datum || new Date());
  }

  /* ================= STARTEN ================= */
  tekenPakketknoppen();
  tekenCatalogus();
  tekenToebehoren();
  tekenDossiers();
  vulDossierFormulier(leegDossier());
  tekenInstellingen();
  tekenOpgeslagen();

  /**
   * Was je ergens mee bezig toen de telefoon het tabblad afsloot? Dan sta je
   * weer precies waar je was. Alleen als er iets in stond, natuurlijk.
   */
  if (heeftInhoud(staat.concept)) {
    offerte = { ...staat.concept, datum: new Date(staat.concept.datum) };
    voorkeuren = new Set(soortenIn(offerte.regels || []));
    $$('#wb-voorkeuren .wb-chip').forEach((c) => {
      c.classList.toggle('aan', voorkeuren.has(c.dataset.soort));
    });
    vulFormulierUitOfferte();
  }

  tekenNazorgvelden();
  /* Wat er van het meetrapport bewaard is, terug in het formulier. De
     schermafbeeldingen staan er niet in — zie de uitleg bij bewaarMeting. */
  meting = { ...leegRapport('geluid'), ...(staat.meting || {}) };
  meting.accu = { type: '', metingen: {}, ...(meting.accu || {}) };
  meting.nazorg = { ...(meting.nazorg || {}) };
  meting.systeem = Array.isArray(meting.systeem) ? meting.systeem : [];
  meting.kort = Array.isArray(meting.kort) && meting.kort.length
    ? meting.kort
    : KORTE_PUNTEN.map((p) => ({ ...p }));
  vulMeting();

  tekenAfspraken();
  tekenAlles();
  /* Kom je binnen via een snelkoppeling van je beginscherm, dan sta je meteen
     op het goede tabblad. */
  tekenBericht();
  toonTab(new URLSearchParams(location.search).get('tab') || 'offerte');

  /* Het moment waarop Android een tabblad afsluit is precies dit moment.
     Wat er nog niet weggeschreven was, gaat hier alsnog mee. */
  window.addEventListener('pagehide', bewaarConcept);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') bewaarConcept();
  });
</script>

<style is:global>
  /* De app is een app, geen pagina: alles binnen duimbereik, niets dat
     opzij schuift, en knoppen die je met een handschoen nog raakt.

     WAAROM is:global
     Astro merkt opmaak standaard af op de elementen die in dit bestand
     staan. De helft van deze app wordt pas tijdens het gebruik aangemaakt —
     de regels van de offerte, de knoppen van je onderdelen — en die vielen
     daardoor buiten de boot: knoppen zonder vorm, bedragen tegen de tekst
     aan geplakt. Met is:global geldt de opmaak ook voor die elementen.
     Dat kan hier veilig: deze pagina staat op zichzelf. */
  body.headroom { padding-bottom: 96px; }

  /**
   * DE TABBLADEN ZIJN GEEN SECTIES VAN DE WEBSITE.
   *
   * global.css geeft elke <section> 88 pixels lucht boven en onder, en zet er
   * een scheidingslijntje tussen. Dat hoort bij de marketingpagina's, waar je
   * rustig langs scrollt. In de app kostte het op elk tabblad ruim honderd
   * pixels van je scherm voordat de eerste kop in beeld kwam — op een telefoon
   * is dat een derde van wat je ziet — plus een lijntje dat nergens op sloeg.
   */
  .wb-paneel { padding: 0; }
  .wb-paneel + .wb-paneel::before { content: none; }

  .wb-kop {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px calc(14px + env(safe-area-inset-top, 0px));
    background: var(--bg-alt);
    border-bottom: 1px solid var(--line);
  }
  .wb-kop strong {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .2em;
    font-size: .95rem;
  }
  .wb-kop span { color: var(--text-dim); font-size: .8rem; }

  .wb-tabs {
    display: flex;
    gap: 2px;
    padding: 10px 12px 0;
    background: var(--bg-alt);
    overflow-x: auto;
  }
  .wb-tab {
    flex: 1 1 auto;
    min-height: 44px;
    padding: 10px 14px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--text-dim);
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .78rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .wb-tab.aan { color: var(--text); border-bottom-color: var(--accent); }

  main { padding: 18px 14px 0; }

  .wb-h { font-size: 1.5rem; margin-bottom: 14px; }
  .wb-h3 {
    font-size: .8rem;
    letter-spacing: .16em;
    color: var(--text-dim);
    margin: 18px 0 8px;
  }
  .wb-h3:first-of-type { margin-top: 6px; }

  .wb-kaart {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 14px;
    margin-bottom: 14px;
  }
  .wb-kaart .eyebrow { margin-bottom: .7em; }

  .wb-uitleg { font-size: .82rem; color: var(--text-dim); margin-top: 8px; }
  .wb-leeg { font-size: .85rem; color: var(--text-dim); }
  .wb-melding { font-size: .85rem; color: var(--text-dim); min-height: 1.2em; margin-top: 10px; }

  /* ---- formuliervelden ---- */
  .wb-veldrij {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 10px;
  }
  .wb-veldrij .wb-breed { grid-column: 1 / -1; }
  label {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: .72rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  /* :not(.plate) is geen detail: zonder dat wint deze regel van de
     kentekenplaat uit global.css en verdwijnt de oranje band. */
  input[type="text"]:not(.plate), input[type="tel"], input[type="email"],
  input[type="search"], input[type="date"], input[type="time"], select, textarea {
    width: 100%;
    min-height: 46px;
    padding: 11px 12px;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
    /* 16px of groter, anders zoomt iPhone bij het tikken in op het veld en
       staat de app daarna scheef. */
    font-size: 16px;
    text-transform: none;
    letter-spacing: normal;
  }
  textarea { min-height: 62px; resize: vertical; }
  .wb-opmerking { margin-top: 14px; }

  /* ---- kenteken ---- */
  .wb-kenteken { display: flex; flex-direction: column; gap: 12px; align-items: center; }
  .wb-kenteken .plate { max-width: 100%; }
  .wb-kenteken .btn { width: 100%; }

  /* ---- keuzeknoppen en chips ---- */
  .wb-schakel { display: flex; gap: 8px; }
  .wb-keuze {
    flex: 1;
    min-height: 46px;
    padding: 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-dim);
    font-size: .85rem;
    cursor: pointer;
  }
  .wb-keuze.aan { border-color: var(--accent); color: var(--text); background: var(--bg); }

  /* Drie keuzes naast elkaar passen op 320 pixels alleen met kleinere tekst. */
  .wb-schakel.wb-drie .wb-keuze { font-size: .78rem; padding: 10px 4px; }

  /* ---- vinkjes met uitleg ----
     Het hele blok is het label, dus je kunt met je duim overal op de regel
     tikken in plaats van precies op het hokje. */
  .wb-vink {
    display: flex;
    /* Niet erven van de gewone label-regel hieronder: die zet velden onder
       elkaar in kleine hoofdletters. Dat is opmaak voor een veldnaam, niet
       voor een zin die je moet lezen. */
    flex-direction: row;
    gap: 12px;
    align-items: flex-start;
    min-height: 46px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-transform: none;
    letter-spacing: normal;
    cursor: pointer;
  }
  .wb-vink:last-child { border-bottom: 0; padding-bottom: 0; }
  .wb-vink input[type="checkbox"] {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--accent);
  }
  .wb-vink > span {
    display: block;
    font-size: .88rem;
    color: var(--text);
    line-height: 1.35;
  }
  .wb-vink em {
    display: block;
    margin-top: 4px;
    font-style: normal;
    font-size: .78rem;
    color: var(--text-dim);
  }

  /* ---- agenda ----
     Geen nieuwe kleuren: wat aandacht vraagt krijgt het oranje van het merk,
     de rest blijft grijs. Zo springt er per scherm maar één ding uit. */
  .wb-bel {
    display: inline-block;
    min-width: 17px;
    margin-left: 5px;
    padding: 1px 4px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--bg);
    font-size: .62rem;
    line-height: 15px;
    text-align: center;
  }
  /* Het venster met je Google-agenda. Hoog genoeg om een week te zien,
     maar niet zo hoog dat de rest van de agenda eronder verdwijnt. */
  .wb-google-agenda {
    display: block;
    width: 100%;
    height: 420px;
    margin-top: 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }
  @media (min-width: 1000px) {
    .wb-google-agenda { height: 560px; }
  }

  .wb-dringend { border-color: var(--accent); }
  .wb-dringend p { margin: 8px 0 0; font-size: .88rem; line-height: 1.4; }

  .wb-klus .wb-regel-kop { align-items: flex-start; }
  .wb-wanneer { font-style: normal; font-size: .8rem; color: var(--text-dim); white-space: nowrap; }
  /* Wat geweest is mag op de achtergrond verdwijnen, maar niet verdwijnen. */
  .wb-geweest { opacity: .55; }

  .wb-bestel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 12px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: .8rem;
    color: var(--text-dim);
  }
  .wb-bestel strong { font-family: 'Oswald', sans-serif; font-size: 1rem; color: var(--text); }
  .wb-bestel em { font-style: normal; }
  /* Alleen deze twee vragen iets van je vandaag. */
  .wb-bestel.wb-nu, .wb-bestel.wb-te-laat { border-color: var(--accent); }
  .wb-bestel.wb-nu em, .wb-bestel.wb-te-laat em { color: var(--accent-text); }
  .wb-bestel.wb-gedaan strong { color: var(--text-dim); }

  .wb-voorbereiding { margin-top: 16px; padding-top: 4px; border-top: 1px solid var(--line); }
  .wb-voorbereiding .wb-vink { padding: 10px 0; }

  .wb-zoeken { margin-top: 16px; }

  /* Het statuslabel bij een bewaarde offerte. */
  .wb-status {
    display: inline-block;
    padding: 3px 9px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: .68rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .wb-status.af { border-color: var(--accent); color: var(--accent-text); }

  .wb-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .wb-chip {
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-dim);
    font-size: .82rem;
    cursor: pointer;
  }
  .wb-chip.aan { border-color: var(--accent); color: var(--accent-text); }

  /* ---- toevoegknoppen ---- */
  .wb-knoprij { display: flex; flex-direction: column; gap: 8px; }
  /* Een link die eruitziet als een knop: Chrome kan alleen een echte link op
     je beginscherm zetten, en een knop van 46 pixels raak je met een duim. */
  .wb-tabkoppeling {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    text-decoration: none;
  }
  .wb-toevoeg {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 52px;
    padding: 10px 14px;
    text-align: left;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    font-size: .92rem;
    cursor: pointer;
  }
  .wb-toevoeg small { display: block; font-size: .72rem; color: var(--text-dim); }
  .wb-toevoeg em {
    font-style: normal;
    font-family: 'Oswald', sans-serif;
    letter-spacing: .04em;
    color: var(--accent-text);
    white-space: nowrap;
  }

  /* ---- regels ---- */
  .wb-regel { border-bottom: 1px solid var(--line); padding: 12px 0; }
  .wb-regel:last-of-type { border-bottom: 0; }
  .wb-regel-kop { display: flex; align-items: center; gap: 10px; justify-content: space-between; }
  .wb-regel-kop small { display: block; font-size: .72rem; color: var(--text-dim); }
  .wb-regel-kop strong {
    font-family: 'Oswald', sans-serif;
    letter-spacing: .04em;
    white-space: nowrap;
  }
  .wb-regel-naam { min-height: 42px; }
  .wb-regel-rij {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .wb-aantal { display: flex; align-items: center; gap: 4px; }
  .wb-aantal button {
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    font-size: 1.2rem;
    cursor: pointer;
  }
  .wb-aantal span { min-width: 28px; text-align: center; }
  .wb-regel-detail { margin-top: 10px; }

  /* Ook een tekstknop moet je met een duim kunnen raken. Vandaar de
     minimumhoogte: met alleen padding werd hij 35 pixels en dat is te klein
     voor iemand die naast een auto staat. */
  .wb-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    border: 0;
    background: transparent;
    color: var(--accent-text);
    font-size: .82rem;
    padding: 10px 0;
    cursor: pointer;
    text-decoration: underline;
  }

  /* ---- cijfers ---- */
  .wb-marge { background: var(--bg-alt); }
  /* Een regel met een omschrijving links en een bedrag rechts. In het rapport
     staat er soms ook nog een toelichting achter; op een telefoon past dat
     niet naast elkaar, dus die zakt dan naar een eigen regel eronder. Het
     bedrag mag nooit over twee regels breken — dan lees je "€" en op de
     volgende regel "695,00". */
  .wb-cijfers { display: grid; gap: 6px; }
  .wb-cijfers div {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 2px 12px;
    font-size: .9rem;
  }
  .wb-cijfers span { color: var(--text-dim); }
  .wb-cijfers strong {
    font-family: 'Oswald', sans-serif;
    letter-spacing: .04em;
    white-space: nowrap;
  }
  .wb-cijfers em {
    grid-column: 1 / -1;
    font-style: normal;
    font-size: .78rem;
    color: var(--text-dim);
  }
  /* Op een breed scherm past de toelichting wel gewoon achter het bedrag. */
  @media (min-width: 1000px) {
    .wb-cijfers div { grid-template-columns: 1fr auto auto; }
    .wb-cijfers em { grid-column: auto; }
  }

  /* Een waarschuwing die je niet over het hoofd ziet, maar die ook niet
     schreeuwt: de oranje streep links doet het werk. */
  .wb-waarschuwing {
    margin-top: 10px;
    padding-left: 12px;
    border-left: 2px solid var(--accent);
    font-size: .82rem;
    color: var(--text-dim);
  }
  .wb-waarschuwing strong { color: var(--text); }

  .wb-voorbeeld {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: .85rem;
    color: var(--text-dim);
  }
  .wb-voorbeeld strong {
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem;
    color: var(--accent-text);
  }
  .wb-voorbeeld em { font-style: normal; font-size: .78rem; }

  /* ---- toebehoren: een rij velden per bijartikel ----
     Op een telefoon past dit niet naast elkaar, dus de omschrijving krijgt een
     eigen regel en de rest verdeelt zich over de breedte. */
  .wb-toebehoren {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
    gap: 8px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .wb-toebehoren .wb-breed { grid-column: 1 / -1; }
  .wb-toebehoren input { min-height: 44px; }

  /* ---- knoppen ---- */
  .wb-vol { display: block; width: 100%; margin-top: 10px; text-align: center; }
  .wb-bestand { cursor: pointer; }

  /* ---- de balk onderin ---- */
  .wb-balk {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px calc(12px + env(safe-area-inset-bottom, 0px));
    background: var(--bg-alt);
    border-top: 1px solid var(--line);
  }
  .wb-balk-som { flex: 1; display: flex; flex-direction: column; line-height: 1.2; }
  .wb-balk-som span {
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .wb-balk-som strong { font-family: 'Oswald', sans-serif; font-size: 1.3rem; letter-spacing: .04em; }
  .wb-balk .btn { padding: 14px 20px; white-space: nowrap; }


  /* ================= HET MEETRAPPORT ================= */
  /* ---- de velden in het tabblad ---- */
  .mr-rij { border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 12px; }
  .mr-rij:last-of-type { border-bottom: 0; }
  .mr-beeldveld { border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 12px; }
  .mr-beeldveld:last-of-type { border-bottom: 0; }
  .mr-mag { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); }
  /* Een kleine weergave van de gekozen schermafbeelding, zodat je ziet dat je
     de goede te pakken hebt voordat je afdrukt. */
  .mr-mini {
    display: block;
    width: 100%;
    max-height: 160px;
    object-fit: contain;
    margin: 8px 0;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  [data-paneel="meting"] input[type="file"] {
    width: 100%;
    min-height: 44px;
    padding: 9px 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    font-size: .9rem;
  }

  /* ---- het blad zelf ---- */
  /* Op het scherm staat het rapport er niet; het bestaat alleen op papier.
     Zonder deze regel staat er een tweede, witte versie van het rapport onder
     de app. */
  .wb-print { display: none; }

  @media print {
    /* Alles van de app weg, alleen het rapport blijft staan. */
    body > header, body > nav, body > main, body > .wb-balk { display: none !important; }
    .wb-print { display: block; }
    /* De app heeft ruimte om zich heen; een vel papier niet. Blijft die
       ruimte staan, dan schuift elk blad een stukje op en drukt de printer er
       een leeg vel achteraan. */
    html, body.headroom { margin: 0; padding: 0; background: none; }
    @page { size: A4; margin: 0; }
  }

  .wb-print { color: var(--text); }
  /* De site zet bodytekst in grijs. Op een scherm leest dat prettig, op papier
     van acht punt niet: dat wordt vaal zodra de printer een streepje spaart.
     In het rapport is de tekst dus gewoon inkt; alleen bijschriften blijven
     grijs. */
  .wb-print p, .wb-print li, .wb-print td, .wb-print h3 { color: var(--text); }
  /**
   * Een blad is een A4. Elk blad begint op een nieuwe pagina; het laatste niet,
   * anders drukt de printer er een leeg vel achteraan.
   *
   * Bewust 295 mm en geen 297: een blad dat precies zo hoog is als het papier
   * valt er bij de minste afronding nét naast, en dan komt er achter elk blad
   * een leeg vel uit de printer. Die twee millimeter zie je niet.
   */
  .mr-blad {
    box-sizing: border-box;
    min-height: 295mm;
    padding: 14mm 15mm 12mm;
    display: flex;
    flex-direction: column;
    break-after: page;
    page-break-after: always;
  }
  .mr-blad:last-child { break-after: auto; page-break-after: auto; }

  .mr-kop {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--accent);
  }
  .mr-merk {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: .82rem;
  }
  .mr-soort { font-size: .74rem; color: var(--text-dim); letter-spacing: .08em; text-transform: uppercase; }
  .mr-nr { color: var(--accent-text); font-weight: 700; }

  .mr-titelblok {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin: 14px 0 4px;
  }
  .mr-velden { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 18px; }
  /* Alleen naast de kentekenplaat mag dit blok de rest van de breedte pakken.
     Stond die regel op .mr-velden zelf, dan groeide het blok op het laatste
     blad ook in de hóógte mee en stonden de velden een halve pagina uit
     elkaar. */
  .mr-titelblok .mr-velden { flex: 1; }
  .mr-velden, .mr-tips, .mr-punten, .mr-tabel { align-content: start; }
  .mr-velden-breed { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .mr-veld { display: flex; flex-direction: column; line-height: 1.3; }
  .mr-label {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .mr-veld strong { font-size: .92rem; font-weight: 600; }

  /* De kentekenplaat, dezelfde als op de offerte: metaal met de oranje band. */
  .mr-plaat {
    display: flex;
    align-items: stretch;
    min-width: 132px;
    height: 32px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-alt);
  }
  .mr-plaat-band { width: 20px; background: var(--accent); }
  .mr-plaat-tekst {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    letter-spacing: .14em;
  }

  .mr-h {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .72rem;
    color: var(--accent-text);
    margin: 16px 0 6px;
  }
  .mr-uitleg { font-size: .82rem; line-height: 1.5; margin: 0 0 8px; }
  .mr-klein-los { font-size: .72rem; color: var(--text-dim); margin-top: 8px; }

  .mr-tabel { width: 100%; border-collapse: collapse; font-size: .82rem; }
  .mr-tabel th {
    text-align: left;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text-dim);
    font-weight: 400;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--line-strong);
  }
  .mr-tabel td { padding: 7px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .mr-tabel td + td, .mr-tabel th + th { padding-left: 12px; }
  .mr-meet td + td, .mr-meet th + th { text-align: right; width: 22%; }
  .mr-klein { display: block; font-size: .7rem; color: var(--text-dim); }
  .mr-leeg-regel { font-size: .82rem; color: var(--text-dim); }

  .mr-punten { display: grid; gap: 10px; }
  .mr-punt { padding-left: 12px; border-left: 2px solid var(--accent); }
  .mr-punt h3 {
    margin: 0 0 2px;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: .74rem;
  }
  .mr-punt p { margin: 0; font-size: .82rem; line-height: 1.5; }

  .mr-handtekening { margin-top: auto; padding-top: 18px; display: flex; flex-direction: column; }
  .mr-streep { width: 150px; border-top: 1px solid var(--line-strong); margin-bottom: 6px; }
  .mr-handtekening strong { font-size: .88rem; }
  .mr-handtekening span { font-size: .74rem; color: var(--text-dim); }
  .mr-meetkop { margin-top: 4px; }

  /* De twee grafieken vullen samen het blad: even hoog, over de volle breedte. */
  .mr-beeld { margin: 0 0 10px; flex: 1; display: flex; flex-direction: column; min-height: 0; }
  .mr-beeld img {
    width: 100%;
    flex: 1;
    min-height: 0;
    object-fit: contain;
    border: 1px solid var(--line);
  }
  .mr-beeld figcaption {
    margin-top: 4px;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .mr-leeg {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    font-size: .78rem;
    color: var(--text-dim);
    background: var(--bg-alt);
    border: 1px dashed var(--line-strong);
  }

  .mr-tips { margin: 0; padding-left: 18px; }
  .mr-tips li { font-size: .82rem; line-height: 1.5; margin-bottom: 8px; }

  .mr-contact { display: flex; gap: 20px; margin-top: auto; padding-top: 18px; }
  .mr-contact > div:first-child { flex: 1; }
  .mr-qr { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 32mm; flex: none; }
  .mr-qr svg { width: 32mm; height: 32mm; display: block; }
  .mr-qr span {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: .58rem;
    line-height: 1.4;
    color: var(--text-dim);
    text-align: center;
  }

  .mr-voet {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
    font-size: .62rem;
    color: var(--text-dim);
  }

  /* Hover alleen waar er echt een muis is. Op een telefoon blijft hover na
     een tik plakken en lijkt de knop daarna uitgeschakeld. */
  @media (hover: hover) {
    .wb-toevoeg:hover, .wb-keuze:hover, .wb-chip:hover { border-color: var(--accent); }
    .wb-tab:hover { color: var(--text); }
  }

  /* Vanaf een tablet mag het wat ruimer, maar de telefoon blijft de maat. */
  @media (min-width: 720px) {
    main { max-width: 640px; margin: 0 auto; }
    .wb-kenteken { flex-direction: row; justify-content: center; }
    .wb-kenteken .btn { width: auto; }
  }

  /* Op een laptop: meer velden naast elkaar en twee klussen naast elkaar in de
     agenda. De kaarten blijven onder elkaar staan — dan leest de offerte van
     boven naar beneden, net als op de telefoon, en hoef je niet te wennen. */
  @media (min-width: 1000px) {
    main { max-width: 920px; padding-bottom: 24px; }
    .wb-veldrij { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #wb-agenda-lijst {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      align-items: start;
    }
    #wb-agenda-lijst .wb-kaart { margin-top: 0; }
    .wb-knoprij { flex-direction: row; flex-wrap: wrap; }
    .wb-knoprij .btn, .wb-knoprij .wb-tabkoppeling { flex: 1 1 200px; }
  }
</style>
</body>
</html>
