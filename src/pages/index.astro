---
import Base from '../layouts/Base.astro';
import PackageCard from '../components/PackageCard.astro';
import KentekenCheck from '../components/KentekenCheck.astro';
import Merken from '../components/Merken.astro';
import Golflijn from '../components/Golflijn.astro';
import Fotoband from '../components/Fotoband.astro';
import OverJustus from '../components/OverJustus.astro';
/* Foto: Unsplash — vrij te gebruiken. Zie src/components/Fotoband.astro. */
import deurspeaker from '../assets/foto/deurspeaker.jpg';
import { PACKAGES, SITE } from '../data/site.js';
import { ONTZORGEN, LEVENSLANG } from '../data/generiek.js';
import { pad } from '../lib/pad.js';
import { whatsappLink, berichtOverAuto } from '../lib/whatsapp.js';

const pakketten = PACKAGES.filter((p) => p.slug !== 'akoestische-isolatie');
---
<Base
  title="Car Audio & CarPlay Upgrades in Emmen | Audio Upgrade Emmen"
  description="Klaar met blikkerig geluid? Audio Upgrade Emmen (Drenthe) levert premium car audio, CarPlay-inbouw, DSP-tuning en onzichtbare deurdemping — met 100% behoud van je fabrieksgarantie."
  path="/"
>
  <div class="hero">
    <Golflijn />
    <div class="wrap">
      <span class="eyebrow">Emmen · Drenthe · Uitsluitend op afspraak</span>
      <h1>Groots geluid.<br /><span class="hero-accent">Onzichtbaar ingebouwd.</span></h1>
      <p class="lead">
        Klaar met blikkerig geluid? Wij bouwen premium car audio weg achter je
        originele panelen — met 100% behoud van je fabrieksgarantie.
      </p>
      {/* De kenteken-check als eerste actie. Zes tekens invullen is een veel
          kleinere stap dan een bericht opstellen, en de bezoeker ziet direct
          zijn eigen auto. Wie al weet wat hij wil, kan er meteen onder
          doorklikken naar WhatsApp. */}
      <KentekenCheck compact={true} />

      <div class="hero-knoppen">
        <a class="btn wa" href={whatsappLink(berichtOverAuto())}>Stuur foto dashboard</a>
        <a class="btn" href={pad("/upgrades")}>Bekijk de upgrades</a>
      </div>
      {/* "Inbouw in één dag" is hier weg. Dat stond er wel, maar het staat al
          op elke pakketkaart ("klaar in ± 2 uur", "één werkdag") en de
          levenslange garantie is een sterker argument: dat doet niemand
          anders in deze branche. */}
      <p class="hero-bewijs">
        All-in prijzen · Levenslange garantie op ons werk · Fabrieksgarantie blijft
      </p>
    </div>
  </div>

  <section>
    <div class="wrap">
      <span class="eyebrow">Pasklaar maatwerk voor jouw auto</span>
      <h2>Upgrades</h2>
      <div class="grid cols-4 mt">
        {pakketten.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>

      {/* Direct onder de prijzen, want daar wordt de afweging gemaakt. Stond
          eerder alleen in artikel 8 van de algemene voorwaarden. */}
      <p class="garantiestrip">
        <strong>{LEVENSLANG.kort}</strong>
        <span>Zolang de auto van jou blijft. Voor de apparatuur geldt de fabrieksgarantie.</span>
      </p>

      <div style="margin-top:4rem"><Merken /></div>
    </div>
  </section>

  {/* Breekt de pagina open op de plek waar hij anders drie blokken tekst
      achter elkaar zou zijn. */}
  <Fotoband
    foto={deurspeaker}
    alt="Speakerrooster in een deurpaneel, verlicht door de sfeerverlichting van de auto"
    kop="Onzichtbaar ingebouwd"
    tekst="Aan de buitenkant verandert er niets. Het verschil zit achter het paneel."
  />

  <section>
    <div class="wrap">
      <span class="eyebrow">Vakwerk zonder afkortingen</span>
      <h2>Geen hout. Geen vocht. Geen half werk.</h2>
      <div class="grid cols-3 mt">
        <div class="step">
          <h3>Massieve montage</h3>
          <p>Hout (MDF) neemt vocht op, zet uit en gaat rotten. Wij gebruiken uitsluitend CNC-gefreesde, massieve kunststof of aluminium adapterringen. Waterbestendig en akoestisch dood.</p>
        </div>
        <div class="step">
          <h3>100% gesoldeerd</h3>
          <p>Wij haten knijpstekkers. Elke verbinding wordt vakkundig gesoldeerd, voorzien van krimpkous en afgewerkt met originele stoftape (TESA). 100% storingsvrij.</p>
        </div>
        <div class="step">
          <h3>Akoestische DSP-tuning</h3>
          <p>Een dure speaker klinkt nergens naar zonder de juiste afstelling. Wij stemmen looptijden en frequenties exact af op de akoestiek van jóuw specifieke auto.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Direct onder de beloften over vakwerk: daar staat wát er gebeurt, hier
      wie het doet. Zonder reviews is dit het enige bewijs dat er iemand met
      verstand van zaken achter staat. */}
  <section class="alt">
    <div class="wrap">
      <OverJustus meer={true} />
    </div>
  </section>

  {/* Het bezwaar dat mensen het vaakst tegenhoudt: "ik kan mijn auto een dag
      niet missen". Stond eerst naast een blok over een demobus, maar die is
      er niet — zie de opmerking in src/data/generiek.js. */}
  {/* Bewust géén "alt": het blok hierboven heeft die achtergrond al, en twee
      keer dezelfde tint achter elkaar leest als één lange lap. */}
  <section>
    <div class="wrap">
      <div class="troef troef-breed">
        <span class="eyebrow">Binnen 15 km rond Emmen</span>
        <h2>{ONTZORGEN.kop}</h2>
        <p>{ONTZORGEN.tekst}</p>
        <a class="btn" href={pad("/contact")}>Plan je afspraak</a>
      </div>
    </div>
  </section>

  <section class="center">
    <div class="wrap">
      <h2>Klaar voor de ultieme geluidservaring?</h2>
      <p style="margin: 0 auto 2em;">Eén foto van je dashboard is genoeg. Binnen 24 uur weet je wat er voor jouw auto kan en wat het kost — zonder verplichtingen.</p>
      <a class="btn wa" href={whatsappLink(berichtOverAuto())}>Stuur foto dashboard</a>
    </div>
  </section>
</Base>

<style>
  /* De hero is het enige wat 99% van je bezoekers zeker ziet. Daarom hier
     meer lucht, grotere letters en de belangrijkste knop vooraan. */
  /* De golflijn ligt als vloer onderin. De inhoud krijgt onderruimte zodat
     de bewijsregel er niet doorheen loopt — die moet leesbaar blijven. */
  .hero { position: relative; min-height: 78vh; padding-bottom: clamp(150px, 21vh, 220px); }
  .hero .wrap { position: relative; z-index: 1; }
  .hero-accent { color: var(--accent-text); }
  .hero h1 { line-height: 1.06; }
  .hero-knoppen {
    display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;
    margin-top: .4em;
  }
  .hero-bewijs {
    margin: 2.4em auto 0;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase; letter-spacing: .24em;
    font-size: .68rem; color: var(--text-dim);
  }
  /* De garantieregel onder de prijzen. Een streep erboven in de accentkleur,
     zoals de troeven verderop en het portret van Justus — zo leest het als
     een eigen mededeling en niet als een voetnoot bij de laatste kaart. */
  .garantiestrip {
    max-width: 62ch;
    margin: 3.2rem auto 0;
    padding-top: 1.5rem;
    border-top: 2px solid var(--accent);
    text-align: center;
  }
  .garantiestrip strong {
    display: block;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: clamp(.82rem, 2.4vw, .98rem);
  }
  .garantiestrip span {
    display: block;
    margin-top: .7em;
    font-size: .88rem;
    color: var(--text-dim);
  }

  /* .troef en .troef-breed staan in global.css: de upgradepagina gebruikt ze
     inmiddels ook, en een scoped stijl geldt maar binnen één bestand. */

  @media (max-width: 700px) {
    /* Ruimte voor de frequentiecurve eronder. Met minder liep de bewijsregel
       ("all-in prijzen · inbouw in één dag") dwars over de curve heen. */
    .hero { min-height: 72vh; padding-bottom: 178px; }
    .hero-knoppen { flex-direction: column; }
    .hero-bewijs { letter-spacing: .16em; line-height: 2; }
  }
</style>
