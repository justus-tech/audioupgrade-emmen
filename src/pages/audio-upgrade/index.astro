---
import Base from '../../layouts/Base.astro';
import KentekenCheck from '../../components/KentekenCheck.astro';
import ModelKiezer from '../../components/ModelKiezer.astro';
import { pad } from '../../lib/pad.js';
import { MODELS } from '../../data/models.js';
---
<Base
  title="Audio Upgrade per Automodel — Check je Kenteken | Audio Upgrade Emmen"
  description="Vul je kenteken in en zie direct welke audio-upgrades er voor jouw auto mogelijk zijn. Van VW Golf tot Tesla Model 3 — premium car audio in Emmen."
  path="/audio-upgrade"
>
  <section>
    <div class="wrap">
      <KentekenCheck />
    </div>
  </section>

  {/* Eén blok in plaats van 28 merkknoppen plus 150 kaarten. Dat waren twee
      schermen scrollen voordat je iets vond. */}
  <section class="alt">
    <div class="wrap">
      <h2 class="center">Of zoek je auto op</h2>
      <p class="center" style="margin:0 auto 2.6em;">
        Tik op je merk en kies je model. Weet je hem al? Typ hem dan gewoon in.
      </p>
      <ModelKiezer />

      {/* Precies de plek waar iemand met een oude auto afhaakt: hij zoekt zijn
          model, vindt het niet, en denkt dat het niet kan. Stond eerst in het
          menu, maar met zes items paste dat niet meer op een telefoon. */}
      <div class="klassieker-wijzer center">
        <span class="eyebrow">Staat je auto er niet bij?</span>
        <h3>Rijd je iets ouders?</h3>
        <p>
          Voor klassiekers en youngtimers werken we anders: geen vaste
          pakketten, en je dashboard blijft zoals het was.
        </p>
        <a class="btn" href={pad('/oldtimer-audio')}>Klassiekers en youngtimers</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Een eigen blok met een streep erboven, zodat het als losse ingang leest
     en niet als voetnoot onder de lijst. */
  .klassieker-wijzer {
    max-width: 46ch;
    margin: 4rem auto 0;
    padding-top: 2.4rem;
    border-top: 1px solid var(--line-strong);
  }
  .klassieker-wijzer h3 { margin-bottom: .8em; }
  .klassieker-wijzer p { margin: 0 auto 1.8em; font-size: .94rem; }
  .klassieker-wijzer .btn { display: inline-block; }
</style>
