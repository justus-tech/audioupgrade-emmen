---
import Base from '../../layouts/Base.astro';
import KentekenCheck from '../../components/KentekenCheck.astro';
import ModelKiezer from '../../components/ModelKiezer.astro';
import { pad } from '../../lib/pad.js';
import { MODELS } from '../../data/models.js';
---
<Base
  title="Audio Upgrade per Automodel — Check je Kenteken | Audio Upgrade Emmen"
  description="Vul je kenteken in en zie direct welke audio-upgrades er voor jouw auto mogelijk zijn. Van VW Golf tot Tesla Model 3 — premium car audio in Emmen."
  path="/audio-upgrade"
>
  <section>
    <div class="wrap">
      <KentekenCheck />
    </div>
  </section>

  {/* Eén blok in plaats van 28 merkknoppen plus 150 kaarten. Dat waren twee
      schermen scrollen voordat je iets vond. */}
  <section class="alt">
    <div class="wrap">
      <h2 class="center">Of zoek je auto op</h2>
      <p class="center" style="margin:0 auto 2.6em;">
        Tik op je merk en kies je model. Weet je hem al? Typ hem dan gewoon in.
      </p>
      <ModelKiezer />

      {/* Precies de plek waar iemand met een oude auto afhaakt: hij zoekt zijn
          model, vindt het niet, en denkt dat het niet kan. */}
      <p class="center klassieker-wijzer">
        Rijd je iets ouders? Voor klassiekers en youngtimers werken we anders —
        <a href={pad('/oldtimer-audio')}>lees hoe we dat doen</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .klassieker-wijzer { margin: 3rem auto 0; font-size: .94rem; }
  .klassieker-wijzer a { color: var(--accent-text); }
</style>
