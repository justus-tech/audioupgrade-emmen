---
/**
 * Modelpagina: /audio-upgrade/bmw-x5, /audio-upgrade/volkswagen-golf, ...
 *
 * Eén pagina per model, met een eigen webadres — dat is precies waarom deze
 * pagina's ranken op zoektermen als "BMW X5 audio upgrade". De VASTE blokken
 * (pakketten, garantie, oproep) komen uit src/data/generiek.js en site.js,
 * dus die staan maar op één plek. Alleen het modelspecifieke deel komt uit
 * src/data/models.js.
 */
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import PackageCard from '../../components/PackageCard.astro';
import { MODELS, merkSlug, modellenVanMerk } from '../../data/models.js';
import { merkenPerSlug } from '../../data/merken.js';
import { PACKAGES, SITE } from '../../data/site.js';
import { garantieVoor, ctaVoor, CTA, STANDAARD_PAKKETTEN } from '../../data/generiek.js';
import { pad } from '../../lib/pad.js';
import { whatsappLink, berichtOverAuto, WA_NUMMER } from '../../lib/whatsapp.js';

/* Het script hieronder heeft het nummer nodig om de links aan te vullen met
   het kenteken van de bezoeker. Het gaat mee als data-attribuut. */
const waNummer = WA_NUMMER;

export function getStaticPaths() {
  return MODELS.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}

const { model } = Astro.props;

const merk = merkenPerSlug[merkSlug(model.brand)];

/** De garantietekst met deze auto erin — zie de uitleg in generiek.js. */
const garantie = garantieVoor(model.brand, model.model);

/**
 * De andere modellen van hetzelfde merk. Twee redenen:
 *
 *   Voor de bezoeker  Wie op de Golf uitkomt maar een Polo rijdt, klikt door
 *                     in plaats van terug naar Google te gaan.
 *   Voor de vindbaarheid  Elke modelpagina krijgt hierdoor eigen links naar
 *                     verwante pagina's. Nu hing elke modelpagina er los bij,
 *                     alleen bereikbaar via de merkpagina of de zoeklijst.
 *
 * Maximaal zes, anders wordt het een tweede menu onderaan de pagina.
 */
const anderen = modellenVanMerk(merkSlug(model.brand))
  .filter((m) => m.slug !== model.slug)
  .slice(0, 6);
const pakketten = (model.packages ?? STANDAARD_PAKKETTEN)
  .map((slug) => PACKAGES.find((p) => p.slug === slug))
  .filter(Boolean);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: model.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/**
 * Het kruimelpad, machineleesbaar. Hiermee snapt een zoekmachine of een
 * AI-assistent waar deze pagina in het geheel past: van de site naar het
 * merk naar dit model. Zonder dit is elke pagina een los eiland.
 */
const kruimelpad = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Automodellen', item: `${SITE.url}/audio-upgrade` },
    ...(merk
      ? [{ '@type': 'ListItem', position: 3, name: merk.naam, item: `${SITE.url}/merk/${merk.slug}` }]
      : []),
    {
      '@type': 'ListItem',
      position: merk ? 4 : 3,
      name: `${model.brand} ${model.model}`,
      item: `${SITE.url}/audio-upgrade/${model.slug}`,
    },
  ],
};

/** De dienst zelf: wat wij voor dít model doen, en vanaf welk bedrag. */
const dienstSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${model.brand} ${model.model} audio upgrade`,
  serviceType: 'Car audio upgrade',
  description: model.description,
  provider: { '@id': `${SITE.url}/#bedrijf` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Drenthe, Nederland' },
  offers: pakketten
    .filter((p) => p.bedrag)
    .map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: p.bedrag,
      priceCurrency: 'EUR',
      description: p.short,
    })),
};
---
<Base title={model.title} description={model.description} path={`/audio-upgrade/${model.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(kruimelpad)} />
  <script type="application/ld+json" set:html={JSON.stringify(dienstSchema)} />

  <section>
    <div class="wrap">
      {merk
        ? <a class="eyebrow eyebrow-link" href={pad(`/merk/${merk.slug}`)}>{model.brand} — alle modellen</a>
        : <span class="eyebrow">{model.brand}</span>}
      <h1>{model.model} audio upgrade</h1>
      {model.generaties && <p class="generaties">Voor {model.generaties}</p>}
      <p style="margin-top:1.4em">{model.intro}</p>

      {/* Bevestiging voor wie via de kenteken-check binnenkomt: zijn eigen
          kenteken naast merk en model, zodat hij zeker weet dat dit zijn auto
          is. Verschijnt alleen als het opgeslagen kenteken bij déze pagina
          hoort; anderen zien niets. */}
      <div class="jouw-auto mt" id="jouw-auto" data-slug={model.slug}
           data-auto={`${model.brand} ${model.model}`} data-nummer={waNummer} hidden>
        <span class="jouw-plaat">
          <span class="jouw-plaat-band"><Logo height={13} decoratief={true} /></span>
          <span class="jouw-plaat-nr" id="jouw-plaat"></span>
        </span>
        <span class="jouw-tekst">
          Dit is jouw <strong>{model.brand} {model.model}</strong>
        </span>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>Waarom klinkt de {model.model} af fabriek zo mager?</h2>
      <div class="grid cols-3 mt">
        {model.problems.map((p, i) => (
          <div class="step">
            <span class="num">0{i + 1}</span>
            <p style="margin-top:12px">{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{model.solution.title}</h2>
      <p style="margin-top:1.4em">{model.solution.text}</p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>{model.carplay.possible ? `Draadloos CarPlay in je ${model.model}` : `En CarPlay in je ${model.model}?`}</h2>
      <p style="margin-top:1.4em">{model.carplay.text}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Onze upgrades voor de {model.model}</h2>
      <div class="grid cols-2 mt">
        {pakketten.map((pkg) => <PackageCard pkg={pkg} auto={`${model.brand} ${model.model}`} />)}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>{garantie.kop}</h2>
      <p style="margin-top:1.4em">{garantie.tekst}</p>
      <p style="margin-top:1em">{garantie.naTekst}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Veelgestelde vragen</h2>
      <div class="mt">
        {model.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {anderen.length > 0 && (
    <section>
      <div class="wrap">
        <h2>Andere {model.brand}-modellen</h2>
        <p style="margin-top:1.2em">
          Rijd je iets anders van {model.brand}? Voor deze {model.brand}-modellen
          hebben we ook uitgezocht wat er af fabriek misgaat en wat eraan te doen is.
        </p>
        <ul class="verwant mt">
          {anderen.map((m) => (
            <li>
              <a href={pad(`/audio-upgrade/${m.slug}`)}>{m.brand} {m.model}</a>
            </li>
          ))}
        </ul>
        {merk && (
          <p style="margin-top:1.6em">
            <a href={pad(`/merk/${merk.slug}`)}>Alle {model.brand}-modellen →</a>
          </p>
        )}
      </div>
    </section>
  )}

  <section class="alt center">
    <div class="wrap">
      <h2>Klaar om je {model.model} te horen zoals hij bedoeld is?</h2>
      <p style="margin:0 auto 2em;">{ctaVoor(model.model)}</p>
      <a class="btn wa wa-link" href={whatsappLink(berichtOverAuto(`${model.brand} ${model.model}`))}>
        {CTA.knop}
      </a>
    </div>
  </section>
</Base>

<script>
  import { formatteerKenteken, matchAuto } from '../../lib/match.js';

  const vak = document.getElementById('jouw-auto');

  /**
   * Vult het kenteken en het bouwjaar in de WhatsApp-knoppen op deze pagina.
   *
   * De knoppen hebben al een bericht met merk en model erin — dat schrijft de
   * server. Weet de browser óók welk kenteken de bezoeker net heeft ingevuld,
   * dan zetten we dat erbij. Justus krijgt dan geen "ik heb een Golf" maar
   * "ik heb een Volkswagen Golf uit 2018 (92-DJ-HG)", en weet meteen om welke
   * auto het gaat.
   *
   * Er wordt niets opgeslagen en niets verstuurd: het bericht staat pas in
   * WhatsApp als de bezoeker zelf op verzenden drukt. Het kenteken stond al in
   * zijn eigen tabblad omdat hij het net zelf heeft ingetypt.
   */
  function zetKentekenInWhatsapp(v) {
    const nummer = vak.dataset.nummer;
    const auto = vak.dataset.auto;
    if (!nummer || !auto) return;

    const jaar = (v.datum_eerste_toelating || '').slice(0, 4);
    const omschrijving = jaar ? `${auto} uit ${jaar}` : auto;
    const plaat = formatteerKenteken(v.kenteken);

    for (const link of document.querySelectorAll('a.wa-link')) {
      const pakket = link.dataset.waPakket;
      const zin = pakket
        ? `ik ben geïnteresseerd in ${pakket} voor mijn ${omschrijving} (${plaat}). Kun je me daar meer over vertellen?`
        : `ik heb een ${omschrijving} (${plaat}). Ik ben benieuwd wat er voor mijn auto mogelijk is.`;
      link.href = `https://wa.me/${nummer}?text=${encodeURIComponent(`Hoi Justus, ${zin}`)}`;
    }
  }

  if (vak) {
    try {
      const bewaard = sessionStorage.getItem('aue-auto');
      if (bewaard) {
        const v = JSON.parse(bewaard);
        // Alleen tonen als het opgeslagen kenteken écht bij deze pagina hoort.
        if (v && v.slug === vak.dataset.slug && v.kenteken) {
          document.getElementById('jouw-plaat').textContent = formatteerKenteken(v.kenteken);
          vak.hidden = false;
          zetKentekenInWhatsapp(v);
        }
      }
    } catch (e) {
      /* privémodus of oude opslag: dan tonen we het blok gewoon niet */
    }
    // Zet een vlaggetje zodra we klaar zijn met beslissen. De tests kunnen
    // daarop wachten in plaats van op de klok: "blok blijft verborgen" is
    // niet af te wachten, dus zonder dit vlaggetje moet een test gokken hoe
    // lang dit script erover doet — en dat gaat mis zodra de laptop het druk
    // heeft. Het attribuut doet verder niets.
    vak.dataset.klaar = 'ja';
  }
</script>

<style>
  /* De verwante modellen als losse blokjes, niet als opsomming met bolletjes.
     Het is een rij ingangen, geen lijst met eigenschappen. */
  .verwant {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
  }
  .verwant a {
    display: inline-block;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    text-decoration: none;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .74rem;
    transition: border-color .15s ease, color .15s ease;
  }
  .verwant a:hover,
  .verwant a:focus-visible { border-color: var(--accent); color: var(--accent-text); }

  .eyebrow-link { text-decoration: none; }
  .eyebrow-link:hover { text-decoration: underline; }
  .generaties { color: var(--text-dim); font-size: .95rem; margin-top: .6em; }

  .jouw-auto {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 18px 20px;
    border: 1px solid var(--line-strong);
    background: var(--panel);
  }
  /* Dezelfde AUE-plaat als op de upgradepagina, alleen kleiner. Hier kan het
     logo wél als echt element in de band, want dit is een span en geen input. */
  .jouw-plaat {
    display: inline-flex; align-items: stretch;
    border: 2px solid rgba(0, 0, 0, .42); border-radius: 6px;
    overflow: hidden;
    white-space: nowrap;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .5);
    background:
      repeating-linear-gradient(180deg,
        rgba(255,255,255,.5) 0px, rgba(255,255,255,0) 1px,
        rgba(0,0,0,.035) 2px, rgba(0,0,0,0) 3px),
      linear-gradient(180deg, #fafafa 0%, #dcdcdc 16%, #ffffff 40%,
        #c6c6c6 56%, #eeeeee 78%, #b4b4b4 100%);
  }
  .jouw-plaat-band {
    display: flex; align-items: center; justify-content: center;
    width: 40px; flex: none;
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--accent) 88%, white) 0%,
      var(--accent) 46%,
      color-mix(in srgb, var(--accent) 80%, black) 100%);
    color: var(--accent-ink);
  }
  .jouw-plaat-nr {
    color: #16181a;
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem; font-weight: 600; letter-spacing: .12em;
    padding: 7px 18px;
    text-shadow: 0 1px 0 rgba(255, 255, 255, .7);
  }
  .jouw-tekst {
    font-family: 'Oswald', sans-serif; text-transform: uppercase;
    letter-spacing: .12em; font-size: .9rem; color: var(--text-dim);
  }
  .jouw-tekst strong { color: var(--text); }
</style>
