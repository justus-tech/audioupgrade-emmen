---
/**
 * Modelpagina: /audio-upgrade/bmw-x5, /audio-upgrade/volkswagen-golf, ...
 *
 * Eén pagina per model, met een eigen webadres — dat is precies waarom deze
 * pagina's ranken op zoektermen als "BMW X5 audio upgrade". De VASTE blokken
 * (pakketten, garantie, oproep) komen uit src/data/generiek.js en site.js,
 * dus die staan maar op één plek. Alleen het modelspecifieke deel komt uit
 * src/data/models.js.
 */
import Base from '../../layouts/Base.astro';
import PackageCard from '../../components/PackageCard.astro';
import { MODELS, merkSlug } from '../../data/models.js';
import { merkenPerSlug } from '../../data/merken.js';
import { PACKAGES, SITE } from '../../data/site.js';
import { GARANTIE, CTA, STANDAARD_PAKKETTEN } from '../../data/generiek.js';

export function getStaticPaths() {
  return MODELS.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}

const { model } = Astro.props;

const merk = merkenPerSlug[merkSlug(model.brand)];
const pakketten = (model.packages ?? STANDAARD_PAKKETTEN)
  .map((slug) => PACKAGES.find((p) => p.slug === slug))
  .filter(Boolean);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: model.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={model.title} description={model.description} path={`/audio-upgrade/${model.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section>
    <div class="wrap">
      {merk
        ? <a class="eyebrow eyebrow-link" href={`/merk/${merk.slug}`}>{model.brand} — alle modellen</a>
        : <span class="eyebrow">{model.brand}</span>}
      <h1>{model.model} audio upgrade</h1>
      {model.generaties && <p class="generaties">Voor {model.generaties}</p>}
      <p style="margin-top:1.4em">{model.intro}</p>

      {/* Bevestiging voor wie via de kenteken-check binnenkomt: zijn eigen
          kenteken naast merk en model, zodat hij zeker weet dat dit zijn auto
          is. Verschijnt alleen als het opgeslagen kenteken bij déze pagina
          hoort; anderen zien niets. */}
      <div class="jouw-auto mt" id="jouw-auto" data-slug={model.slug} hidden>
        <span class="jouw-plaat" id="jouw-plaat"></span>
        <span class="jouw-tekst">
          Dit is jouw <strong>{model.brand} {model.model}</strong>
        </span>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>Waarom klinkt de {model.model} af fabriek zo mager?</h2>
      <div class="grid cols-3 mt">
        {model.problems.map((p, i) => (
          <div class="step">
            <span class="num">0{i + 1}</span>
            <p style="margin-top:12px">{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{model.solution.title}</h2>
      <p style="margin-top:1.4em">{model.solution.text}</p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>{model.carplay.possible ? `Draadloos CarPlay in je ${model.model}` : `En CarPlay in je ${model.model}?`}</h2>
      <p style="margin-top:1.4em">{model.carplay.text}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Onze upgrades voor de {model.model}</h2>
      <div class="grid cols-2 mt">
        {pakketten.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>{GARANTIE.kop}</h2>
      <p style="margin-top:1.4em">{GARANTIE.tekst}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Veelgestelde vragen</h2>
      <div class="mt">
        {model.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="alt center">
    <div class="wrap">
      <h2>Klaar om je {model.model} te horen zoals hij bedoeld is?</h2>
      <p style="margin:0 auto 2em;">{CTA.tekst}</p>
      <a class="btn wa" href={SITE.whatsapp}>{CTA.knop}</a>
    </div>
  </section>
</Base>

<script>
  import { formatteerKenteken, matchAuto } from '../../lib/match.js';

  const vak = document.getElementById('jouw-auto');
  if (vak) {
    try {
      const bewaard = sessionStorage.getItem('aue-auto');
      if (bewaard) {
        const v = JSON.parse(bewaard);
        // Alleen tonen als het opgeslagen kenteken écht bij deze pagina hoort.
        if (v && v.slug === vak.dataset.slug && v.kenteken) {
          document.getElementById('jouw-plaat').textContent = formatteerKenteken(v.kenteken);
          vak.hidden = false;
        }
      }
    } catch (e) {
      /* privémodus of oude opslag: dan tonen we het blok gewoon niet */
    }
  }
</script>

<style>
  .eyebrow-link { text-decoration: none; }
  .eyebrow-link:hover { text-decoration: underline; }
  .generaties { color: var(--text-dim); font-size: .95rem; margin-top: .6em; }

  .jouw-auto {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 18px 20px;
    border: 1px solid var(--line-strong);
    background: var(--panel);
  }
  /* Dezelfde AUE-plaat als op de upgradepagina, alleen kleiner. */
  .jouw-plaat {
    color: #16181a;
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem; font-weight: 600; letter-spacing: .12em;
    border: 2px solid rgba(0, 0, 0, .42); border-radius: 6px;
    padding: 6px 16px 6px 46px;
    white-space: nowrap;
    text-shadow: 0 1px 0 rgba(255, 255, 255, .7);
    background-image:
      linear-gradient(90deg, var(--accent) 0 32px, transparent 32px),
      repeating-linear-gradient(180deg,
        rgba(255,255,255,.5) 0px, rgba(255,255,255,0) 1px,
        rgba(0,0,0,.035) 2px, rgba(0,0,0,0) 3px),
      linear-gradient(180deg, #fafafa 0%, #dcdcdc 16%, #ffffff 40%,
        #c6c6c6 56%, #eeeeee 78%, #b4b4b4 100%);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .5);
  }
  .jouw-tekst {
    font-family: 'Oswald', sans-serif; text-transform: uppercase;
    letter-spacing: .12em; font-size: .9rem; color: var(--text-dim);
  }
  .jouw-tekst strong { color: var(--text); }
</style>
