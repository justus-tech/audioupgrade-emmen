---
/**
 * De upgradepagina. Eén pagina, die zich aanpast aan de auto van de bezoeker.
 *
 * Vult iemand zijn kenteken in, dan halen we merk en handelsbenaming op bij de
 * RDW en tonen we "Upgrades voor jouw <auto>" met een foto erboven. De vier
 * pakketten eronder zijn voor iedereen hetzelfde — die komen uit site.js.
 *
 * De officiële naam komt rechtstreeks van de RDW, dus dit werkt voor ELKE auto
 * in Nederland, ook eentje die niet in autos.js staat. Alleen de foto hebben we
 * per model nodig.
 */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import PackageCard from '../components/PackageCard.astro';
import PakketSchets from '../components/PakketSchets.astro';
import Kentekenplaat from '../components/Kentekenplaat.astro';
import { PACKAGES, SITE } from '../data/site.js';
import { autoTabel } from '../data/autos.js';
import { GARANTIE, CTA } from '../data/generiek.js';
import { MERKEN } from '../data/merken.js';
---
<Base
  title="Upgrades & prijzen — check je kenteken | Audio Upgrade Emmen"
  description="Vul je kenteken in en zie direct wat er voor jouw auto mogelijk is. Van draadloos CarPlay (v.a. €695) tot The Reference Edition. All-in prijzen, incl. montage en btw."
  path="/upgrades"
>
  <script type="application/json" id="auto-tabel" set:html={JSON.stringify(autoTabel)}></script>

  <section>
    <div class="wrap center">
      <span class="eyebrow">Transparante all-in prijzen · incl. montage &amp; btw</span>
      <h1 id="upgrade-titel">Upgrades &amp; prijzen</h1>
      <p id="upgrade-sub" style="margin:1.2em auto 0;">
        Vul je kenteken in en we laten zien wat er voor jouw auto mogelijk is.
      </p>

      <form class="kenteken-form" id="upgrade-form" autocomplete="off">
        {/* Zelfde opzet als de check op de homepage: het logo ligt over het
            veld heen, want een <input> kan geen kindelementen bevatten. */}
        <span class="plaat-veld">
          <input class="plate" id="upgrade-kenteken" type="text" placeholder="XX-99-XX"
                 maxlength="8" aria-label="Kenteken" />
          <Logo height={18} decoratief={true} class="plaat-veld-logo" />
        </span>
        <button class="btn solid" type="submit">Toon mijn auto</button>
      </form>
      <div id="upgrade-melding" aria-live="polite"></div>
    </div>
  </section>

  {/* Verschijnt pas als er een auto herkend is. */}
  <section class="alt" id="auto-blok" hidden>
    <div class="wrap">
      {/* Het kenteken van de bezoeker als hoofdrolspeler. Geen autotekening
          meer: een gestileerde auto oogde goedkoop naast de rest van de site,
          en zijn eigen kenteken zegt hem meer dan een plaatje van een auto. */}
      <Kentekenplaat />
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 id="pakketten-kop">Onze pakketten</h2>
      <div class="grid cols-3 mt">
        {PACKAGES.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>
    </div>
  </section>

  {/* Doorkijk per pakket. Eén tekening: het bovenaanzicht verschilt niet
      per carrosserie, dus er is geen reden om zeven varianten te renderen. */}
  <section class="alt">
    <div class="wrap">
      <h2>Wat komt waar in je auto?</h2>
      <p style="margin-bottom:2.4em">Kies een pakket en tik op een nummer voor uitleg.</p>
      <PakketSchets />
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>{GARANTIE.kop}</h2>
      <p style="margin-top:1.4em">{GARANTIE.tekst}</p>
    </div>
  </section>

  <section>
    <div class="wrap center">
      <h2>Of kies je merk</h2>
      <p style="margin:0 auto 2em;">Per merk leggen we uit wat er af fabriek misgaat.</p>
      <div class="grid cols-4">
        {MERKEN.map((m) => <a class="btn" href={`/merk/${m.slug}`}>{m.naam}</a>)}
      </div>
    </div>
  </section>

  <section class="alt center">
    <div class="wrap">
      <h2>Weet je het nog niet zeker?</h2>
      <p style="margin:0 auto 2em;">{CTA.tekst}</p>
      <a class="btn wa" href={SITE.whatsapp}>{CTA.knop}</a>
    </div>
  </section>
</Base>

<script>
  import {
    matchAuto,
    isGeldigKenteken,
    normaliseerKenteken,
    netteNaam,
    formatteerKenteken,
  } from '../lib/match.js';
  import { kleurVan } from '../lib/kleuren.js';

  const tabel = JSON.parse(document.getElementById('auto-tabel').textContent);

  const form = document.getElementById('upgrade-form');
  const input = document.getElementById('upgrade-kenteken');
  const melding = document.getElementById('upgrade-melding');
  const titel = document.getElementById('upgrade-titel');
  const sub = document.getElementById('upgrade-sub');
  const blok = document.getElementById('auto-blok');
  const plaatTekst = document.getElementById('plaat-tekst');
  const plaatModel = document.getElementById('plaat-model');
  const plaatDetails = document.getElementById('plaat-details');
  const pakkettenKop = document.getElementById('pakketten-kop');

  function toon(voertuig) {
    const auto = matchAuto(voertuig, tabel);
    // Kennen we de auto? Dan onze eigen nette schrijfwijze (Škoda Octavia),
    // anders de RDW-tekst netjes gemaakt (werkt voor élke auto in Nederland).
    const naam = auto
      ? `${auto.merk} ${auto.model}`
      : netteNaam(voertuig.merk, voertuig.handelsbenaming);

    titel.textContent = `Upgrades voor jouw ${naam}`;
    pakkettenKop.textContent = `Wat we voor jouw ${naam} kunnen doen`;
    sub.textContent =
      'Alle prijzen zijn all-in: inclusief montage en btw, met behoud van je fabrieksgarantie.';

    const kleur = kleurVan(voertuig.eerste_kleur);

    // De plaat: het kenteken groot, de rest klein eronder.
    plaatTekst.textContent = formatteerKenteken(voertuig.kenteken);
    plaatModel.textContent = naam;

    // Alleen tonen wat de RDW ook echt weet, zodat er nooit een lege
    // scheidingsstip blijft staan.
    const details = [];
    if (kleur.naam) details.push(kleur.naam);
    if (voertuig.inrichting && voertuig.inrichting !== 'Niet geregistreerd') {
      details.push(voertuig.inrichting);
    }
    if (voertuig.datum_eerste_toelating) {
      details.push(String(voertuig.datum_eerste_toelating).slice(0, 4));
    }
    plaatDetails.textContent = details.join(' · ');

    blok.hidden = false;
    melding.textContent = '';
    blok.scrollIntoView({ behavior: 'smooth', block: 'start' });

    try {
      // `slug` erbij, zodat een modelpagina kan zien of dit kenteken bij
      // die pagina hoort en het dan als bevestiging kan tonen.
      sessionStorage.setItem('aue-auto', JSON.stringify({ ...voertuig, slug: auto ? auto.slug : null }));
    } catch (e) {
      /* privémodus: dan onthouden we het gewoon niet */
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const kenteken = normaliseerKenteken(input.value);

    if (!isGeldigKenteken(kenteken)) {
      melding.textContent = 'Vul een geldig kenteken in, bijvoorbeeld XX-99-XX.';
      return;
    }

    melding.textContent = 'Even kijken wat je rijdt…';
    try {
      const res = await fetch(
        'https://opendata.rdw.nl/resource/m9d7-ebf2.json?kenteken=' +
          encodeURIComponent(kenteken) +
          '&$select=kenteken,merk,handelsbenaming,voertuigsoort,inrichting,eerste_kleur,datum_eerste_toelating'
      );
      if (!res.ok) throw new Error('rdw');
      const data = await res.json();

      if (!Array.isArray(data) || !data.length) {
        melding.textContent = 'Dat kenteken kennen we niet. Typfout? Anders helpen we je graag via WhatsApp.';
        return;
      }
      toon(data[0]);
    } catch (err) {
      melding.textContent = 'De kenteken-check is even niet bereikbaar. App ons gerust direct.';
    }
  });

  // Kwam iemand hier al eerder met zijn kenteken? Dan meteen weer tonen.
  try {
    const bewaard = sessionStorage.getItem('aue-auto');
    if (bewaard) {
      const v = JSON.parse(bewaard);
      input.value = v.kenteken || '';
      toon(v);
    }
  } catch (e) {
    /* niets aan de hand, dan begint de bezoeker gewoon opnieuw */
  }
</script>

<style>
  #upgrade-melding { margin-top: 18px; min-height: 24px; color: var(--text-dim); }

  .auto-figuur { margin: 0; }

  .auto-figuur figcaption {
    margin-top: 12px; font-size: .82rem; color: var(--text-dim);
    letter-spacing: .1em; text-transform: uppercase; font-family: 'Oswald', sans-serif;
  }
</style>
