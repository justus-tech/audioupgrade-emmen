  $('#wb-o-bewaar').addEventListener('click', () => {
    const onderdeel = leesOnderdeelFormulier();
    if (!onderdeel.omschrijving) {
      alert('Geef het onderdeel eerst een naam.');
      return;
    }
    if (bewerktOnderdeel != null) staat.catalogus[bewerktOnderdeel] = onderdeel;
    else staat.catalogus.push(onderdeel);
