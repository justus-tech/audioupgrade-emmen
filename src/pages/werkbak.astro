---
/**
 * HET OUDE ADRES VAN DE APP.
 *
 * De app heette eerst "Werkbak" en stond op /werkbak. Hij heet nu Deck en
 * staat op /deck. Deze pagina bestaat alleen om het oude adres te laten
 * werken: het icoon dat Justus op zijn beginscherm heeft gezet wijst nog
 * naar /werkbak, en dat mag niet op een foutmelding uitkomen.
 *
 * Er staat geen server achter deze site, dus een echte 301 kan niet. Een
 * meta-refresh doet hetzelfde voor een bezoeker, en de canonical vertelt een
 * zoekmachine welk adres het echte is. Voor de zekerheid staat er ook
 * noindex op: net als de app zelf hoort dit niet in Google.
 *
 * Deze pagina mag weg zodra Justus de app opnieuw op zijn beginscherm heeft
 * gezet — maar hij kost niets, dus laat hem gerust staan.
 */
import { BRAND, cssThema } from '../data/brand.js';
import { pad } from '../lib/pad.js';

const naar = pad('/deck');
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Deck — offertes | Audio Upgrade Emmen</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="refresh" content={`0; url=${naar}`} />
  <link rel="canonical" href={naar} />
  <style is:global set:html={cssThema}></style>
  <meta name="theme-color" content={BRAND.bg} />
  <link rel="icon" href={pad("/favicon.svg")} type="image/svg+xml" />
</head>
<body class="deck">
  <main class="wb-omleiding">
    <p>De werkbak heet nu <strong>Deck</strong>.</p>
    <p><a href={naar}>Ga verder naar Deck</a></p>
    <p class="wb-klein">
      Zet hem opnieuw op je beginscherm, dan opent het icoon meteen op het
      nieuwe adres.
    </p>
  </main>
</body>
</html>

<style is:global>
  /* Eén schermpje tekst, midden in beeld. Meer heeft deze pagina niet nodig. */
  body.deck {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
  }
  .wb-omleiding { max-width: 22rem; text-align: center; line-height: 1.5; }
  .wb-omleiding a { color: var(--accent-text); }
  .wb-klein { font-size: .82rem; color: var(--text-dim); }
</style>
