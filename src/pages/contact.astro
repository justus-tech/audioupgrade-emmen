---
import Base from '../layouts/Base.astro';
import { SITE, ADRES, openingsblokken } from '../data/site.js';
import { whatsappLink, berichtOverAuto } from '../lib/whatsapp.js';

const q = encodeURIComponent(SITE.mapsQuery);
const kaartUrl = `https://www.google.com/maps?q=${q}&output=embed`;
const routeUrl = `https://www.google.com/maps/search/?api=1&query=${q}`;
---
<Base
  title="Contact & route | Audio Upgrade Emmen"
  description="Stuur een foto van je dashboard via WhatsApp en hoor binnen 24 uur wat er voor jouw auto kan. Ma t/m vr 09:00-17:30, za tot 14:00, op afspraak."
  path="/contact"
  sleutel="contact"
>
  <section>
    <div class="wrap center">
      <span class="eyebrow">Bezoek op afspraak</span>
      <h1>Klaar voor de ultieme geluidservaring?</h1>
      <p style="margin:1.4em auto 2.2em;">Stuur een foto van je dashboard, dan hoor je binnen 24 uur wat er voor jouw auto mogelijk is en wat het kost.</p>
      <a class="btn wa" href={whatsappLink(berichtOverAuto())}>Stuur foto dashboard</a>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      {/* Deze kop moet er staan. Zonder h2 sprong de pagina van h1 recht naar
          de h3'jes op de kaarten, en dan slaat een schermlezer een niveau
          over — die leest de koppen als inhoudsopgave. */}
      <h2 class="center">Zo bereik je ons</h2>
      <div class="grid cols-3 mt">
        <div class="card center contact-kaart">
          <h3>WhatsApp</h3>
          <p>De snelste route: foto van je dashboard + automerk en bouwjaar.</p>
          <a class="btn wa" href={whatsappLink(berichtOverAuto())}>Open WhatsApp</a>
        </div>
        <div class="card center contact-kaart">
          <h3>Bellen</h3>
          <p>Liever even iemand aan de lijn?</p>
          <a class="btn solid" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
        </div>
        <div class="card center contact-kaart">
          <h3>E-mail</h3>
          <p>Voor uitgebreide vragen of zakelijke aanvragen.</p>
          <a class="btn solid" href={`mailto:${SITE.email}`}>Mail ons</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Waar je ons vindt</span>
      <h2>{SITE.street}</h2>
      <p style="margin-top:.6em">{SITE.postalCode} {SITE.city} · bezoek op afspraak</p>

      {/* De openingstijden, uitgeschreven. Ze stonden nergens op de site, en
          dat is precies de vraag die iemand heeft vlak voordat hij appt.
          Eén bron: OPENINGSTIJDEN in site.js — zie de uitleg daar. */}
      <div class="tijden mt">
        <h3>Openingstijden</h3>
        <dl>
          {openingsblokken().map((blok) => (
            <div class="tijd-regel">
              <dt>
                {blok.dagen.length > 1
                  /* Dagen zijn in het Nederlands kleine letters; alleen de eerste
                     krijgt een hoofdletter omdat de regel daarmee begint. */
                  ? `${blok.dagen[0].dag} t/m ${blok.dagen[blok.dagen.length - 1].dag.toLowerCase()}`
                  : blok.dagen[0].dag}
              </dt>
              <dd>{blok.gesloten ? 'Gesloten' : `${blok.open} – ${blok.dicht}`}</dd>
            </div>
          ))}
        </dl>
        <p class="tijden-noot">
          Je auto brengen of ophalen gaat op afspraak, zodat je nooit voor een
          dichte deur staat en we de tijd voor jouw auto vrijhouden. App je
          buiten deze uren? Dan heb je de volgende ochtend antwoord.
        </p>
      </div>

      {/* De kaart laadt pas na een klik. Een Google Maps-embed zet meteen
          cookies bij je bezoeker, en die keuze laten we aan hem. */}
      <div class="kaart mt" id="kaart" data-src={kaartUrl}>
        <button class="btn solid kaart-knop" type="button" id="kaart-knop">
          Toon kaart
        </button>
        <p class="kaart-uitleg">
          De kaart komt van Google en plaatst cookies zodra je hem opent.
        </p>
      </div>

      <p class="mt">
        <a class="btn" href={routeUrl} target="_blank" rel="noopener">Plan je route →</a>
      </p>
    </div>
  </section>
</Base>

<script>
  const vak = document.getElementById('kaart');
  const knop = document.getElementById('kaart-knop');
  if (vak && knop) {
    knop.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = vak.dataset.src;
      frame.title = 'Kaart met de locatie van Audio Upgrade Emmen';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.allowFullscreen = true;
      vak.replaceChildren(frame);
    });
  }
</script>

<style>
  /* De drie kaarten zijn even hoog, maar de knop volgde direct op de tekst.
     "Liever even iemand aan de lijn?" is één regel en de andere twee zijn er
     twee, dus stond die knop hoger dan de rest. Met margin-top:auto slokt de
     knop de overgebleven ruimte boven zich op en staan alle drie de knoppen
     op precies dezelfde hoogte. */
  .contact-kaart .btn { align-self: center; margin-top: auto; }

  /* De openingstijden als een lijstje dat je in één oogopslag leest: dag
     links, tijd rechts, en een streep tussen de regels zodat je oog niet
     verdwaalt op een breed scherm. */
  .tijden { max-width: 46ch; }
  .tijden h3 { margin-bottom: .8em; }
  .tijden dl { margin: 0; }
  .tijd-regel {
    display: flex; justify-content: space-between; gap: 20px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .tijd-regel:first-child { border-top: 1px solid var(--line); }
  .tijd-regel dt { color: var(--text-dim); }
  .tijd-regel dd {
    margin: 0;
    font-family: 'Oswald', sans-serif;
    letter-spacing: .04em;
    white-space: nowrap;
  }
  .tijden-noot { margin-top: 1.4em; font-size: .88rem; color: var(--text-dim); }

  .kaart {
    position: relative;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(ellipse at 50% 120%, color-mix(in srgb, var(--accent) 14%, transparent) 0%, transparent 60%),
      var(--panel);
    padding: 24px;
    text-align: center;
  }
  .kaart :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .kaart-uitleg { font-size: .8rem; margin: 0; max-width: 42ch; }
  @media (max-width: 700px) { .kaart { aspect-ratio: 4 / 3; } }
</style>
