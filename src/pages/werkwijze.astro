---
import Base from '../layouts/Base.astro';
import Fotoband from '../components/Fotoband.astro';
import { SITE } from '../data/site.js';
import { pad } from '../lib/pad.js';
/* Foto: Unsplash — vrij te gebruiken. Zie src/components/Fotoband.astro. */
import carplayScherm from '../assets/foto/carplay-scherm.jpg';
---
<Base
  title="Werkwijze — zo upgraden wij je autogeluid | Audio Upgrade Emmen"
  description="In 3 stappen naar premium autogeluid: stuur een foto van je dashboard, ontvang binnen 24 uur eerlijk advies en plan de inbouw. Fabrieksgarantie blijft intact."
  path="/werkwijze"
>
  <section>
    <div class="wrap center">
      <span class="eyebrow">Vakwerk zonder afkortingen</span>
      <h1>Groots geluid. Onzichtbaar ingebouwd.</h1>
      <p style="margin: 1.4em auto 0;">Bij Audio Upgrade Emmen doen we geen half werk. Er is maar één manier waarop we het opleveren, en dat is goed.</p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="grid cols-3">
        <div class="step">
          <span class="num">01</span>
          <h3>Stuur een foto van je dashboard</h3>
          <p>Geen lange formulieren. Eén WhatsApp-bericht met je automerk, bouwjaar en een foto van je radio of dashboard is genoeg.</p>
        </div>
        <div class="step">
          <span class="num">02</span>
          <h3>Eerlijk advies &amp; offerte</h3>
          <p>Binnen 24 uur krijg je van ons een helder, vrijblijvend advies op maat met een transparante all-in prijs. Geen verrassingen achteraf.</p>
        </div>
        <div class="step">
          <span class="num">03</span>
          <h3>De premium inbouw</h3>
          <p>We plannen een datum. Je levert de auto 's ochtends af en wij nemen er de tijd voor. Aan het eind van de dag stap je in een auto die klinkt zoals hij bedoeld was.</p>
        </div>
      </div>
      <div class="center mt">
        <a class="btn wa" href={SITE.whatsapp}>Stuur foto dashboard</a>
      </div>
    </div>
  </section>

  <Fotoband
    foto={carplayScherm}
    alt="Apple CarPlay met Spotify en navigatie op het originele scherm van een auto"
    kop="Je eigen scherm, alleen beter"
    tekst="Geen losse houder op je ruit. Spotify, Maps en Flitsmeister gewoon waar je scherm al zat."
  />

  <section>
    <div class="wrap">
      <h2>Waarom bij ons?</h2>
      <div class="grid cols-2 mt">
        <div class="card">
          <h3>Massieve montage</h3>
          <p>Hout (MDF) neemt vocht op, zet uit en gaat rotten. Dit veroorzaakt resonantie en schimmel in je deuren. Wij gebruiken uitsluitend CNC-gefreesde, massieve kunststof of aluminium adapterringen. Waterbestendig en akoestisch dood.</p>
        </div>
        <div class="card">
          <h3>Gesoldeerd — getapet</h3>
          <p>Wij haten knijpstekkers ("vampire taps"). Elke verbinding die wij maken wordt vakkundig gesoldeerd, voorzien van krimpkous en vervolgens afgewerkt met de originele stoftape (TESA) die autodealers ook gebruiken. 100% storingsvrij.</p>
        </div>
        <div class="card">
          <h3>Akoestische DSP-tuning</h3>
          <p>Een dure speaker klinkt nergens naar zonder de juiste afstelling. Wij gebruiken geavanceerde meetapparatuur en Digitale Sound Processors (DSP) om looptijden en frequenties exact af te stemmen op de akoestiek van jóuw specifieke auto.</p>
        </div>
        <div class="card">
          <h3>Je fabrieksgarantie blijft intact</h3>
          <p>Wij werken uitsluitend met pasklare Plug &amp; Play-kabelbomen en tasten de fabrieksbedrading niet aan. Alles is volledig terug te bouwen naar origineel.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="alt center">
    <div class="wrap">
      <h2>Benieuwd wat dit voor jouw auto betekent?</h2>
      <a class="btn solid mt" href={pad("/contact")} style="margin-top:1.5em">Start je upgrade</a>
    </div>
  </section>
</Base>
