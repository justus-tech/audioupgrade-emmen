---
/**
 * WIE ZIJN WIJ.
 *
 * Op verzoek van Justus' broer (26 augustus 2026): het blok over Justus stond
 * alleen halverwege de homepage, waar het makkelijk voorbijgescrold wordt.
 * Nu heeft het een eigen adres, staat het in het menu naast Contact, en kun
 * je er rechtstreeks naartoe linken — precies wat je wilt als iemand vraagt
 * "wie ben jij dan?".
 *
 * De uitnodiging om ook zonder opdracht iets te vragen is ook zijn idee. Zie
 * de uitleg bij OVER.advies in generiek.js waarom dat een goed idee is.
 *
 * Het blok zelf komt uit hetzelfde component als op de homepage, dus de tekst
 * staat maar op één plek en kan niet uit elkaar lopen.
 */
import Base from '../layouts/Base.astro';
import OverJustus from '../components/OverJustus.astro';
import { OVER, LEVENSLANG } from '../data/generiek.js';
import { SITE, AUDIOMERKEN, ADRES } from '../data/site.js';
import { pad } from '../lib/pad.js';
import { whatsappLink, berichtOverAuto } from '../lib/whatsapp.js';

const adviesLink = whatsappLink(
  'ik heb een vraag over geluid. Het gaat niet direct over een inbouw, maar ik ben benieuwd wat jij ervan vindt.'
);
---
<Base
  title="Wie zijn wij — Justus, audio engineer in Emmen | Audio Upgrade Emmen"
  description="Opgeleid aan het conservatorium als audio engineer, sinds 2018 in het geluid en al aan auto-interieurs voordat er een rijbewijs was. Maak kennis met de man achter Audio Upgrade Emmen."
  path="/over-ons"
>
  <section>
    <div class="wrap center">
      <span class="eyebrow">Achter Audio Upgrade Emmen</span>
      <h1>Wie zijn wij?</h1>
      <p class="lead" style="max-width:54ch;margin:1.3em auto 0;">
        Je laat je auto een dag achter bij iemand die je niet kent. Dan is het
        niet meer dan redelijk dat je eerst weet wie dat is.
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <OverJustus />
    </div>
  </section>

  {/* Het idee van zijn broer: laat merken dat je over geluid gaat, niet
      alleen over auto's. Dit is de laagste drempel op de hele site. */}
  <section>
    <div class="wrap">
      <div class="troef troef-breed">
        <span class="eyebrow">Ook buiten de auto</span>
        <h2>{OVER.advies.kop}</h2>
        {OVER.advies.alineas.map((regel) => <p>{regel}</p>)}
        <a class="btn wa" href={adviesLink}>Stuur een appje</a>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="grid cols-2">
        <div class="troef">
          <span class="eyebrow">Waar we mee werken</span>
          <h2>Merken kiezen we per auto</h2>
          <p>
            {AUDIOMERKEN.join(', ')}. Geen enkel merk zit vast aan een pakket:
            wat erin komt hangt af van je auto, je muziek en je budget. Wij
            verkopen geen merk, wij lossen een probleem op.
          </p>
          <a class="btn" href={pad('/upgrades')}>Bekijk de upgrades</a>
        </div>
        <div class="troef">
          <span class="eyebrow">Uitsluitend op afspraak</span>
          <h2>{LEVENSLANG.kop}</h2>
          <p>{LEVENSLANG.tekst}</p>
          <a class="btn" href={pad('/contact')}>Contact en route</a>
        </div>
      </div>
    </div>
  </section>

  <section class="center">
    <div class="wrap">
      <h2>Zin om je auto te laten horen wat hij kan?</h2>
      <p style="margin:0 auto 2em;">
        Eén foto van je dashboard is genoeg. Binnen 24 uur weet je wat er voor
        jouw auto kan en wat het kost.
      </p>
      <a class="btn wa" href={whatsappLink(berichtOverAuto())}>Stuur foto dashboard</a>
      <p style="margin-top:1.8em">
        {SITE.name} · {ADRES}
      </p>
    </div>
  </section>
</Base>
