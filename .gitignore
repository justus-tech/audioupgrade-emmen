# Afhankelijkheden (worden opnieuw opgehaald met: npm install)
node_modules/

# Build-resultaat en tijdelijke bestanden van Astro
dist/
.astro/

# Systeem- en editorbestanden
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Lokale instellingen met eventuele sleutels
.env
.env.*

# Inkoopprijzen, kortingen, uurtarief en marge-eis. Deze map staat openbaar op
# GitHub, dus die getallen horen hier niet in. Zie prijsinstellingen.voorbeeld.json.
prijsinstellingen.json

# Screenshots ter controle (lokaal genereren met: node screenshot.mjs)
shots/

# De posters voor aan de muur (lokaal maken met: npm run posters)
posters/

# Het adres van de tijdelijke deellink (npm run deel)
.tunnel-adres

# Lokale instellingen van de editor
.claude/
